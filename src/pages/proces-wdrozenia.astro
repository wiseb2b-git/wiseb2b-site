---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';
// Tekst: .knowledge/teksty/proces-wdrozenia.md (copy deck). Układ: Figma 160:1295.

const faq = [
  { q: 'Ile trwa wdrożenie platformy B2B?', a: 'Sprint analityczny trwa od 1 do 4 tygodni. Po nim znasz zakres, termin i budżet projektu. Całe wdrożenie trwa najczęściej od 2 do 6 miesięcy, zależnie od zakresu prac i liczby integracji.' },
  { q: 'Kto prowadzi wdrożenie?', a: 'Pracujemy według sprawdzonej metodyki wdrożenia i z siecią partnerów wdrożeniowych. Projekt może prowadzić zespół WiseB2B albo jeden z partnerów, którzy znają platformę. Którą drogę wybrać, ustalamy razem w sprincie analitycznym. Więcej na stronie <a href="/partnerzy-wdrozeniowi/">Partnerzy wdrożeniowi</a>.' },
  { q: 'Ile kosztuje wdrożenie?', a: 'Koszt wdrożenia poznasz po sprincie analitycznym, bo zależy od zakresu ustalonego w backlogu. Możesz go rozłożyć w miesięcznej subskrypcji. Plany: Start od 1 990 zł, Professional od 3 490 zł, Enterprise od 6 990 zł netto miesięcznie, bez opłat od obrotu. Szczegóły na stronie <a href="/plany-wiseb2b/">Plany WiseB2B Cloud</a>.' },
];
---

<BaseLayout title="Proces wdrożenia platformy B2B" description="Wdrożenie WiseB2B w sześciu etapach. Sprint analityczny trwa od 1 do 4 tygodni i kończy się zakresem, budżetem i terminem. Całe wdrożenie: 2–6 miesięcy." faq={faq.map(f => ({ question: f.q, answer: f.a.replace(/<[^>]+>/g, '') }))}>

<div class="supports-logos kv-on-dark">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 offset-lg-2">
        <span class="page-hero__badge lm-observer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm0 2c-3.87 0-7 1.79-7 4v3h14v-3c0-2.21-3.13-4-7-4z"/></svg>
          Proces wdrożenia
        </span>
        <h1 class="lm-observer kv-h1"><span>Proces wdrożenia</span> platformy B2B</h1>
      </div>
    </div>
    <div class="row">
      <div class="col-lg-6 offset-lg-3 col-xl-6 offset-xl-3">
        <p class="description lm-observer kv-text">Zanim rozpoczniesz korzystanie z WiseB2B, przeprowadzimy Cię przez proces implementacji w sześciu krokach. Długość i złożoność każdego z etapów zależy od poziomu skomplikowania Twojego biznesu i charakterystyki potrzeb. Najczęściej całe wdrożenie trwa od 2 do 6 miesięcy.</p>
        <a href="/zamow-demo/" class="wise-button wise-button--wise-harvest lm-observer">Zamów demo</a>
      </div>
    </div>
  </div>
</div>

<div class="supports-numbers supports-numbers--card">
  <div class="container">
    <div class="row">
      <div class="col">
        <div class="supports-numbers__numbers">

          <!-- Step 01 -->
          <div class="number lm-observer">
            <div class="row">
              <div class="col-md-12 col-lg-3 col-xl-3">
                <div class="number__wrap">
                  <img width="220" height="220" src="/images/np_suitcase_4525556.png" alt="Sprint analityczny" />
                </div>
              </div>
              <div class="col-md-12 col-lg-8 col-xl-7 p-xl-0">
                <div class="number__content">
                  <div class="number__title-row">
                    <span class="nr kv-num">01</span>
                    <h2 class="number__content-header kv-h2">Sprint analityczny</h2>
                  </div>
                  <h3 class="number__content-subheader kv-h3">Określimy potrzeby i zdefiniujemy cele biznesowe wdrożenia</h3>
                  <ul>
                    <li class="list">
                      <p class="list__header kv-title">Przebieg prac analitycznych</p>
                      <p class="list__description kv-lead">W zależności od skali wdrożenia platformy B2B prace analityczne trwają od 1 do 4 tygodni. Podczas tego etapu zespół konsultantów ściśle współpracuje z kluczowymi osobami w Twojej firmie, aby jak najprecyzyjniej przygotować się do wdrożenia platformy B2B.</p>
                    </li>
                    <li class="list">
                      <p class="list__header kv-title">Cele etapu analitycznego</p>
                      <p class="list__description kv-lead">Celem sprintu analitycznego jest dogłębne zrozumienie potrzeb Twojego biznesu, określenie celów wdrożenia platformy eCommerce B2B i mierników sukcesu.</p>
                    </li>
                    <li class="list">
                      <p class="list__header kv-title">Rezultaty prac</p>
                      <p class="list__description kv-lead">Efektem prac analitycznych jest backlog projektu (lista wymagań i historyjek do obsłużenia przez platformę) i ustalony zakres, czas i budżet wdrożenia platformy B2B. Jeśli Twój pomysł na nowy moduł nie realizuje celów biznesowych, powiemy Ci o tym otwarcie już na tym etapie.</p>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 02 -->
          <div class="number lm-observer">
            <div class="row">
              <div class="col-md-12 col-lg-3 col-xl-3">
                <div class="number__wrap">
                  <img width="220" height="220" src="/images/np_operation_2998632.png" alt="Projekt graficzny &amp; layout" />
                </div>
              </div>
              <div class="col-md-12 col-lg-8 col-xl-7 p-xl-0">
                <div class="number__content">
                  <div class="number__title-row">
                    <span class="nr kv-num">02</span>
                    <h2 class="number__content-header kv-h2">Projekt graficzny &amp; layout</h2>
                  </div>
                  <h3 class="number__content-subheader kv-h3">Zaplanujemy adaptację lub stworzenie dedykowanych projektów</h3>
                  <p class="number__content-description kv-lead">Twoja wersja WiseB2B może wyglądać dokładnie tak, jak będziesz tego chciał. Możesz wykorzystać standardowe layouty lub zaprojektować dedykowane widoki zupełnie od podstaw. Przeanalizujemy wspólnie Twoje potrzeby i pomożemy wybrać podejście, które będzie najlepsze podczas wdrożenia platformy B2B w Twojej firmie.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 03 -->
          <div class="number lm-observer">
            <div class="row">
              <div class="col-md-12 col-lg-3 col-xl-3">
                <div class="number__wrap">
                  <img width="220" height="220" src="/images/np_ecommerce_4557208.png" alt="Prace wdrożeniowe" />
                </div>
              </div>
              <div class="col-md-12 col-lg-8 col-xl-7 p-xl-0">
                <div class="number__content">
                  <div class="number__title-row">
                    <span class="nr kv-num">03</span>
                    <h2 class="number__content-header kv-h2">Prace wdrożeniowe</h2>
                  </div>
                  <h3 class="number__content-subheader kv-h3">Przygotujemy rozwiązanie dopasowane do potrzeb i celów biznesowych</h3>
                  <ul>
                    <li class="list">
                      <p class="list__header kv-title">Dostosowanie do specyfiki</p>
                      <p class="list__description kv-lead">Główną część prac wdrożeniowych stanowi dostosowanie standardowych funkcji WiseB2B do specyfiki przedsiębiorstwa i jego potrzeb. Do dyspozycji masz 37 gotowych modułów w 13 obszarach, między innymi cenniki indywidualne, kredyt kupiecki, akceptacje zamówień i obsługę wielu magazynów. Celem tego etapu jest przygotowanie do uruchomienia systemu spełniającego oczekiwania i założenia biznesowe.</p>
                    </li>
                    <li class="list">
                      <p class="list__header kv-title">Projektowanie dedykowanych elementów</p>
                      <p class="list__description kv-lead">Prace wdrożeniowe to również etap, podczas którego projektowane są dedykowane elementy rozwiązania, jeśli takie właśnie zostały ustalone do realizacji na etapie analitycznym. Zespół projektowy tworzy wówczas funkcje, moduły lub wtyczki specjalnie na potrzeby Twojej firmy i dba o to, aby doskonale współgrały one z pozostałymi elementami platformy. Wtyczki powstają w kodzie odseparowanym od standardu, dzięki czemu aktualizacje platformy nie wymagają kosztownych migracji.</p>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 04 -->
          <div class="number lm-observer">
            <div class="row">
              <div class="col-md-12 col-lg-3 col-xl-3">
                <div class="number__wrap">
                  <img width="220" height="220" src="/images/np_server_1122156.png" alt="Integracje" />
                </div>
              </div>
              <div class="col-md-12 col-lg-8 col-xl-7 p-xl-0">
                <div class="number__content">
                  <div class="number__title-row">
                    <span class="nr kv-num">04</span>
                    <h2 class="number__content-header kv-h2">Integracje</h2>
                  </div>
                  <h3 class="number__content-subheader kv-h3">Zintegrujemy się z Twoim systemem ERP</h3>
                  <p class="number__content-description kv-lead">Integracja z systemem nadrzędnym to punkt newralgiczny całego wdrożenia platformy B2B. Jest ona niezbędna, aby warunki handlowe i Twoja oferta mogły zostać wiernie odwzorowane w WiseB2B. Prace integracyjne toczą się równolegle z pracami wdrożeniowymi. Mamy gotowe integracje z Teneum, Comarch XL i Optima, enova365 oraz Subiektem. Jeśli korzystasz z innego ERP, ścieżkę integracji przez Apilo, n8n lub Admin API i jej koszt poznasz w sprincie analitycznym.</p>
                  <a class="hp-why__link pw-step__link" href="/integracje/">Integracje</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 05 -->
          <div class="number lm-observer">
            <div class="row">
              <div class="col-md-12 col-lg-3 col-xl-3">
                <div class="number__wrap">
                  <img width="220" height="220" src="/images/np_gears_9428_000000-1.png" alt="Testy akceptacyjne" />
                </div>
              </div>
              <div class="col-md-12 col-lg-8 col-xl-7 p-xl-0">
                <div class="number__content">
                  <div class="number__title-row">
                    <span class="nr kv-num">05</span>
                    <h2 class="number__content-header kv-h2">Testy akceptacyjne</h2>
                  </div>
                  <h3 class="number__content-subheader kv-h3">Wspólnie przetestujemy opracowane rozwiązanie przed uruchomieniem</h3>
                  <p class="number__content-description kv-lead">Po zakończeniu prac wdrożeniowych i integracyjnych platforma B2B jest niemal gotowa do użytku. Ostatni krok, który musi wydarzyć się przed uruchomieniem, to testy akceptacyjne. Podczas tego etapu kluczowe osoby z Twojej firmy weryfikują poprawność przygotowanego rozwiązania według określonych scenariuszy, będących odzwierciedleniem faktycznej pracy z platformą, na przykład zamówienia z rabatem indywidualnym albo zamówienia powyżej limitu kupieckiego. Dzięki temu możliwe jest wychwycenie elementów do poprawy przed oddaniem systemu Twoim klientom i upewnienie się, że przygotowane rozwiązanie w pełni odpowiada na wszystkie zdefiniowane potrzeby.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 06 -->
          <div class="number lm-observer">
            <div class="row">
              <div class="col-md-12 col-lg-3 col-xl-3">
                <div class="number__wrap">
                  <img width="220" height="220" src="/images/np_sale_3972942.png" alt="Uruchomienie" />
                </div>
              </div>
              <div class="col-md-12 col-lg-8 col-xl-7 p-xl-0">
                <div class="number__content">
                  <div class="number__title-row">
                    <span class="nr kv-num">06</span>
                    <h2 class="number__content-header kv-h2">Uruchomienie</h2>
                  </div>
                  <h3 class="number__content-subheader kv-h3">Oddamy platformę B2B w ręce Twoich klientów</h3>
                  <p class="number__content-description kv-lead">Na tym etapie platforma jest w pełni gotowa, zintegrowana z systemem ERP i przetestowana. Najwyższa pora, aby Twoi klienci mogli zacząć z niej korzystać i składać pierwsze zamówienia. W zależności od skali działania Twojej firmy rekomendujemy udostępnienie platformy od razu wszystkim klientom lub wybranej grupie, tak aby w węższym gronie zweryfikować działanie platformy. Jeśli przechodzisz z innego systemu, klientów przenosimy etapami, a stary system działa do końca przejścia. Wdrożenie platformy B2B dobiegło końca, a my zostajemy z Tobą: zapewniamy asystę powdrożeniową, serwis i dalszy rozwój platformy.</p>
                  <a class="hp-why__link pw-step__link" href="/bezpieczna-migracja/">Zobacz, jak przenosimy klientów ze starego systemu</a>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<!-- CTA: rozmowa z ekspertem -->
<section class="call-expert">
  <div class="container">
    <div class="row">
      <div class="col-xl-8 offset-xl-2 col-lg-10 offset-lg-1">
        <div class="call-expert__wrapper kv-on-dark">
          <h2 class="kv-h2">Dowiedz się więcej o wdrożeniu platformy B2B</h2>
          <p class="pw-call-expert__lead kv-lead">Porozmawiaj z nami o zakresie, terminie i budżecie wdrożenia w Twojej firmie.</p>
          <p class="name kv-title">Jakub Czyżkowski</p>
          <p class="job kv-text">CEO</p>
          <div class="call-expert__button">
            <a class="wise-button wise-button--wise-harvest" href="/zamow-demo/">Zamów rozmowę z ekspertem</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="questions">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <div class="questions__wrapper">
          <h3 class="kv-h3">Najczęściej zadawane pytania</h3>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2">
        <div class="questions__items">
          {faq.map(f => (
            <div class="item">
              <h2 class="kv-title">{f.q}</h2>
              <p class="kv-text" set:html={f.a} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<CtaBlock />

<script>
document.querySelectorAll('.questions__items .item h2').forEach(h2 => {
  h2.addEventListener('click', () => {
    h2.closest('.item').classList.toggle('show');
  });
});
</script>
</BaseLayout>
