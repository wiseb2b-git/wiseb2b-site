</div>

<div class="functions-cards functions-cards--dark">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
        <h2 class="h2_semi functions-cards__heading lm-observer">Pełne wsparcie procesu zakupowego Twojego klienta</h2>
