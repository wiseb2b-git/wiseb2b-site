---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { getCollection } from 'astro:content';

const obszary = (await getCollection('obszary')).sort((a, b) => a.data.order - b.data.order);

// Filary i moduły, o które pytają najczęściej: dostępność brana z macierzy (kolekcja obszary)
const keyModuleNames = ['Agent klienta', 'Agent administratora', 'Panel Handlowca', 'Ofertowanie', 'Kod źródłowy', 'OnPremise', 'Integracje ERP', 'Client API'];
const allModules = obszary.flatMap((o) => o.data.modules);
const keyModules = keyModuleNames
  .map((name) => allModules.find((m) => m.name === name))
  .filter((m): m is NonNullable<typeof m> => Boolean(m));
const statusLabel = (st: string) => st === 'included' ? 'W pakiecie' : st === 'optional' ? 'Opcja dodatkowa' : 'Niedostępny';

const faqData = [
  {
    question: "Ile kosztuje WiseB2B?",
    answer: "Start od 1 990 zł netto miesięcznie (do 1 000 produktów i 2 000 klientów), Professional od 3 490 zł (do 30 000 produktów i 10 000 klientów), Enterprise od 6 990 zł (bez limitu produktów i klientów). Cena obejmuje hosting w WiseB2B Cloud i aktualizacje. Koszt wdrożenia rozkładamy w subskrypcji, więc nie płacisz go z góry."
  },
  {
    question: "Czy pobieracie prowizję od obrotu?",
    answer: "Nie. Płacisz stały abonament za plan i wybrane moduły. Nie ma prowizji od wartości zamówień ani od liczby transakcji. Gdy sprzedaż przez platformę rośnie, opłata zostaje ta sama."
  },
  {
    question: "Nie mamy budżetu na nowy system. Ile to realnie kosztuje?",
    answer: "Abonament z rozłożonym wdrożeniem to zwykle 50–100% miesięcznej pensji jednego handlowca. Platforma odciąża przy tym cały zespół handlowy i BOK. Dokładną kwotę dla Twojej konfiguracji poznasz po sprincie analitycznym."
  },
  {
    question: "Czy integracja z ERP jest w cenie planu?",
    answer: "Integracja z ERP to osobny moduł, który dodajesz do każdego planu. Mamy gotowe integracje z Teneum, Comarch XL, Comarch Optima, enova365 i Subiektem oraz z platformą Apilo. Integracja przenosi cenniki, stany, zamówienia, faktury i rozrachunki zgodnie z regułami Twojego ERP."
  },
  {
    question: "W którym planie są Agent AI i Panel Handlowca?",
    answer: "W planie Enterprise Agent AI klienta, Panel Handlowca, ofertowanie i zadania handlowca są w pakiecie. W Professional każdy z nich możesz dodać jako opcję. Plan Start ich nie obejmuje, ale handlowiec może zalogować się na konto klienta i złożyć zamówienie w jego imieniu."
  },
  {
    question: "Kiedy dostaję kod źródłowy?",
    answer: "Kod źródłowy jest w pakiecie Enterprise. W Professional możesz go dokupić jako opcję. W Enterprise możesz też dodać Customization Studio, środowisko do budowy pluginów z pomocą AI."
  },
  {
    question: "Czym różni się moduł „w pakiecie” od „opcji dodatkowej”?",
    answer: "Moduł w pakiecie jest wliczony w cenę planu. Opcja dodatkowa jest dostępna w Twoim planie za dodatkową opłatą miesięczną. Moduł niedostępny wymaga przejścia na wyższy plan."
  },
  {
    question: "Który plan wybrać, jeśli nie wiem, jak urośnie sprzedaż online?",
    answer: "Ustalimy to podczas pokazu i sprintu analitycznego, na podstawie liczby produktów, klientów i Twoich warunków handlowych. Plan możesz później zmienić na wyższy. Moduły dochodzą do tej samej platformy, więc dane i konta klientów zostają na miejscu."
  },
  {
    question: "Czy WiseB2B obsługuje sprzedaż zagraniczną?",
    answer: "Tak. W Enterprise moduły sprzedaży zagranicznej (kontrola VIES, VAT 0%, wiele walut w koszyku), cenniki wielowalutowe i wielojęzyczność są w pakiecie. W Professional są opcjami. Tak VMP sprzedaje do sklepów w krajach UE."
  },
  {
    question: "Czy mogę zainstalować WiseB2B na własnym serwerze?",
    answer: "Tak, w planach Professional i Enterprise. Instalacja on-premise jest dla firm, które muszą trzymać dane na własnej infrastrukturze. Platforma działa wtedy tak samo i dostaje te same aktualizacje co w WiseB2B Cloud."
  }
];
---

<BaseLayout title="Plany i cennik WiseB2B: Start, Professional, Enterprise" description="Start od 1 990 zł, Professional od 3 490 zł, Enterprise od 6 990 zł netto miesięcznie. Bez prowizji od obrotu, wdrożenie rozłożone w subskrypcji." faq={faqData}>

<section class="demo-hero">
  <div class="container">
    <span class="demo-hero__badge">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg>
      Plany i cennik
    </span>
    <h1 class="lm-observer">Stały abonament <span>bez prowizji</span> od obrotu</h1>
    <p class="demo-hero__lead lm-observer">Trzy plany z ceną znaną z góry: Start od 1 990 zł, Professional od 3 490 zł, Enterprise od 6 990 zł netto miesięcznie. Koszt wdrożenia rozkładamy w subskrypcji. Poniżej widzisz każdy moduł i plan, w którym go dostaniesz.</p>
    <div class="demo-hero__actions">
      <a href="/zamow-demo/" class="btn btn--primary">Zamów demo</a>
    </div>
  </div>
</section>

<div class="price-list-plans">
  <div class="container">
    <div class="row">
      <div class="col-xl-10 offset-xl-1">
        <div class="price-list-plans__wrapper">

          <div class="plan lm-observer">
            <div class="plan__top">
              <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
                <rect width="64" height="64" rx="16" fill="var(--color-primary-50)"/>
                <path d="M32 46c7.732 0 14-6.268 14-14s-6.268-14-14-14v28z" fill="var(--color-primary-400)"/>
                <path d="M32 18c-7.732 0-14 6.268-14 14s6.268 14 14 14V18z" fill="var(--color-primary-300)"/>
              </svg>
              <h3 class="h3_semi name">Start</h3>
            </div>
            <p class="p_regular_3 plan__description">Dla firmy, która przenosi do sieci powtarzalne zamówienia stałych klientów na mniejszym asortymencie. Klienci zamawiają na swoich cennikach, a handlowiec może złożyć zamówienie w ich imieniu.</p>
            <div class="plan__price">
              <div class="plan__price-product box">
                <span class="label_regular">Produkty</span>
                <span class="to">do</span>
                <span class="price p_semi_3">1000</span>
              </div>
              <div class="plan__price-client box">
                <span class="label_regular">Klienci</span>
                <span class="to">do</span>
                <span class="price p_semi_3">2000</span>
              </div>
            </div>
            <p class="p_semi_2 price-list-plans__list-header">Najważniejsze funkcje:</p>
            <ul class="price-list-plans__list">
              <li class="label_regular">Wyszukiwarka produktów z synonimami</li>
              <li class="label_regular">Indywidualne cenniki i promocje</li>
              <li class="label_regular">Proces zakupowy B2B (wielokoszyki, listy, import)</li>
              <li class="label_regular">Wsparcie handlowca w zakupach klienta</li>
              <li class="label_regular">CMS, baza wiedzy i aktualności</li>
              <li class="label_regular">Hosting w WiseB2B Cloud</li>
            </ul>
            <div class="plan__monthly-price">
              <span class="plan__monthly-label">Cena od</span>
              <span class="plan__monthly-amount">1 990 zł</span>
              <span class="plan__monthly-period">netto / miesiąc</span>
            </div>
            <div class="price-list-plans__button">
              <a class="wise-button" href="#price-functions">Porównaj możliwości</a>
            </div>
          </div>

          <div class="plan lm-observer">
            <div class="plan__top">
              <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
                <rect width="64" height="64" rx="16" fill="var(--color-primary-50)"/>
                <rect x="18" y="18" width="28" height="28" rx="6" fill="var(--color-primary-500)"/>
                <rect x="18" y="32" width="14" height="14" rx="3" fill="var(--color-primary-300)"/>
              </svg>
              <h3 class="h3_semi name">Professional</h3>
            </div>
            <p class="p_regular_3 plan__description">Dla firmy, której klienci mają mieć na platformie całą obsługę: faktury, rozrachunki, zwroty i płatności. Pozwala przenieść do eCommerce nawet 90% sprzedaży. Agenta AI, Panel Handlowca i kod źródłowy dodajesz jako opcje.</p>
            <div class="plan__price">
              <div class="plan__price-product box">
                <span class="label_regular">Produkty</span>
                <span class="to">do</span>
                <span class="price p_semi_3">30000</span>
              </div>
              <div class="plan__price-client box">
                <span class="label_regular">Klienci</span>
                <span class="to">do</span>
                <span class="price p_semi_3">10000</span>
              </div>
            </div>
            <p class="p_semi_2 price-list-plans__list-header">Najważniejsze funkcje:</p>
            <ul class="price-list-plans__list">
              <li class="label_regular">Dokumenty handlowe (faktury, dostawy, rozrachunki)</li>
              <li class="label_regular">Zwroty i reklamacje</li>
              <li class="label_regular">Płatności elektroniczne i integracje kurierskie</li>
              <li class="label_regular">Feedy produktowe (Shopify, Ceneo, IAI)</li>
              <li class="label_regular">Admin API i Client API</li>
              <li class="label_regular">Środowisko testowe, n8n, wtyczki własne</li>
              <li class="label_regular">Opcje: Agent AI, Panel Handlowca, kod źródłowy</li>
            </ul>
            <div class="plan__monthly-price">
              <span class="plan__monthly-label">Cena od</span>
              <span class="plan__monthly-amount">3 490 zł</span>
              <span class="plan__monthly-period">netto / miesiąc</span>
            </div>
            <div class="price-list-plans__button">
              <a class="wise-button" href="#price-functions">Porównaj możliwości</a>
            </div>
          </div>

          <div class="plan lm-observer">
            <div class="plan__top">
              <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
                <rect width="64" height="64" rx="16" fill="var(--color-primary-50)"/>
                <path d="M32 14 48 23v18L32 50 16 41V23z" fill="var(--color-primary-600)"/>
                <path d="M32 14 48 23 32 32 16 23z" fill="var(--color-primary-400)"/>
                <path d="M32 32v18L16 41V23z" fill="var(--color-primary-700)"/>
                <path d="M32 32v18l16-9V23z" fill="var(--color-primary-800)"/>
              </svg>
              <h3 class="h3_semi name">Enterprise</h3>
            </div>
            <p class="p_regular_3 plan__description">Dla dziesiątek tysięcy indeksów, sprzedaży zagranicznej i wielu sklepów. Agent AI klienta, Panel Handlowca z ofertowaniem i kod źródłowy są w cenie planu.</p>
            <div class="plan__price">
              <div class="plan__price-product box">
                <span class="label_regular">Produkty</span>
                <span class="no_limits p_semi_3">bez limitu</span>
              </div>
              <div class="plan__price-client box">
                <span class="label_regular">Klienci</span>
                <span class="no_limits p_semi_3">bez limitu</span>
              </div>
            </div>
            <p class="p_semi_2 price-list-plans__list-header">Najważniejsze funkcje:</p>
            <ul class="price-list-plans__list">
              <li class="label_regular">Sprzedaż zagraniczna i cenniki wielowalutowe</li>
              <li class="label_regular">Panel Handlowca z ofertowaniem</li>
              <li class="label_regular">Agent AI klienta</li>
              <li class="label_regular">MultiStore (wiele sklepów, jeden backend)</li>
              <li class="label_regular">Oferty dedykowane dla klientów</li>
              <li class="label_regular">Dynamiczny ranking produktów</li>
              <li class="label_regular">Dostęp do kodu źródłowego</li>
            </ul>
            <div class="plan__monthly-price">
              <span class="plan__monthly-label">Cena od</span>
              <span class="plan__monthly-amount">6 990 zł</span>
              <span class="plan__monthly-period">netto / miesiąc</span>
            </div>
            <div class="price-list-plans__button">
              <a class="wise-button" href="#price-functions">Porównaj możliwości</a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<!-- FILARY W PLANACH -->
<div class="price-functions plany-modules">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1">
        <h3 class="h3_semi lm-observer" style="margin-bottom: 12px;">Agent AI, Panel Handlowca i kod: w którym planie</h3>
        <p class="p_regular_2 lm-observer" style="margin-bottom: 24px;">Dostępność z tej samej macierzy modułów, z której liczymy ofertę. Pełną listę znajdziesz niżej.</p>
        <div class="plan-legend lm-observer">
          <span class="legend-item"><span class="legend-icon legend-icon--included"></span> W pakiecie</span>
          <span class="legend-item"><span class="legend-icon legend-icon--optional"></span> Opcja dodatkowa</span>
          <span class="legend-item"><span class="legend-icon legend-icon--unavailable"></span> Niedostępny</span>
        </div>
        <div class="modules-table lm-observer">
          <div class="modules-table__header">
            <div class="modules-table__col modules-table__col--name">Moduł</div>
            <div class="modules-table__col modules-table__col--plan">Start</div>
            <div class="modules-table__col modules-table__col--plan">Profes&shy;sional</div>
            <div class="modules-table__col modules-table__col--plan">Enter&shy;prise</div>
          </div>
          {keyModules.map((mod) => (
          <div class="modules-table__row">
            <div class="modules-table__col modules-table__col--name">
              <strong>{mod.name}</strong>
              <span class="modules-table__desc">{mod.description}</span>
            </div>
            <div class="modules-table__col modules-table__col--plan"><span class={`plan-icon plan-icon--${mod.starter}`} title={statusLabel(mod.starter)}></span></div>
            <div class="modules-table__col modules-table__col--plan"><span class={`plan-icon plan-icon--${mod.professional}`} title={statusLabel(mod.professional)}></span></div>
            <div class="modules-table__col modules-table__col--plan"><span class={`plan-icon plan-icon--${mod.enterprise}`} title={statusLabel(mod.enterprise)}></span></div>
          </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<div class="cloud-includes">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2">
        <div class="cloud-includes__header lm-observer">
          <h3 class="h3_semi">Co zawiera usługa WiseB2B Cloud?</h3>
          <p class="p_regular_2">Każdy plan działa w WiseB2B Cloud. Serwery, kopie zapasowe i aktualizacje są po naszej stronie, Twój dział IT ich nie utrzymuje.</p>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-lg-10 offset-lg-1">
        <div class="cloud-includes__grid">

          <div class="cloud-includes__item lm-observer">
            <div class="cloud-includes__icon">
              <svg width="40" height="40" viewBox="0 0 30 30" fill="var(--color-primary-500)"><path d="M5 3.75C4.30965 3.75 3.75 4.30965 3.75 5V12.5C3.75 13.1904 4.30965 13.75 5 13.75H12.5C13.1904 13.75 13.75 13.1904 13.75 12.5V5C13.75 4.30965 13.1904 3.75 12.5 3.75H5ZM5 16.25C4.30965 16.25 3.75 16.8096 3.75 17.5V25C3.75 25.6904 4.30965 26.25 5 26.25H12.5C13.1904 26.25 13.75 25.6904 13.75 25V17.5C13.75 16.8096 13.1904 16.25 12.5 16.25H5ZM17.5 16.25C16.8096 16.25 16.25 16.8096 16.25 17.5V25C16.25 25.6904 16.8096 26.25 17.5 26.25H25C25.6904 26.25 26.25 25.6904 26.25 25V17.5C26.25 16.8096 25.6904 16.25 25 16.25H17.5ZM18.75 23.75V18.75H23.75V23.75H18.75ZM6.25 11.25V6.25H11.25V11.25H6.25ZM6.25 23.75V18.75H11.25V23.75H6.25ZM20 13.75V10H16.25V7.5H20V3.75H22.5V7.5H26.25V10H22.5V13.75H20Z"/></svg>
            </div>
            <h5 class="h5_semi">Środowisko produkcyjne</h5>
            <p class="p_regular_3">Platforma w chmurze, w której nowe wersje instalują się automatycznie. Kopie zapasowe danych i monitoring dostępności prowadzimy my.</p>
            <span class="cloud-includes__badge">Wszystkie plany</span>
          </div>

          <div class="cloud-includes__item lm-observer">
            <div class="cloud-includes__icon">
              <svg width="40" height="40" viewBox="0 0 30 30" fill="var(--color-primary-500)"><path d="M15.5177 6.25H26.25C26.9404 6.25 27.5 6.80965 27.5 7.5V25C27.5 25.6904 26.9404 26.25 26.25 26.25H3.75C3.05965 26.25 2.5 25.6904 2.5 25V5C2.5 4.30965 3.05965 3.75 3.75 3.75H13.0177L15.5177 6.25ZM5 6.25V23.75H25V8.75H14.4823L11.9822 6.25H5ZM13.75 15V11.25H16.25V15H20V17.5H16.25V21.25H13.75V17.5H10V15H13.75Z"/></svg>
            </div>
            <h5 class="h5_semi">Środowisko testowe</h5>
            <p class="p_regular_3">Osobna instancja z danymi z produkcji z poprzedniego dnia. Nowy cennik, integrację czy plugin sprawdzasz tutaj, zanim zobaczą je klienci.</p>
            <span class="cloud-includes__badge">Professional i Enterprise</span>
          </div>

          <div class="cloud-includes__item lm-observer">
            <div class="cloud-includes__icon">
              <svg width="40" height="40" viewBox="0 0 30 30" fill="var(--color-primary-500)"><path d="M11.25 21.25C11.25 20.5592 10.9714 19.9363 10.5176 19.4824C10.0638 19.0286 9.4407 18.75 8.75 18.75C7.36929 18.75 6.25 19.8692 6.25 21.25C6.25 22.6308 7.36929 23.75 8.75 23.75C10.1307 23.75 11.25 22.6308 11.25 21.25ZM23.75 21.25C23.75 19.8692 22.6308 18.75 21.25 18.75C19.8692 18.75 18.75 19.8692 18.75 21.25C18.75 22.6308 19.8692 23.75 21.25 23.75C22.6308 23.75 23.75 22.6308 23.75 21.25ZM11.25 8.75C11.25 7.36929 10.1307 6.25 8.75 6.25C7.36929 6.25 6.25 7.36929 6.25 8.75C6.25 10.1307 7.36929 11.25 8.75 11.25C10.1307 11.25 11.25 10.1307 11.25 8.75ZM23.75 8.75C23.75 7.36929 22.6308 6.25 21.25 6.25C19.8692 6.25 18.75 7.36929 18.75 8.75C18.75 9.4407 19.0286 10.0638 19.4824 10.5176C19.9363 10.9714 20.5592 11.25 21.25 11.25C22.6308 11.25 23.75 10.1307 23.75 8.75ZM26.25 21.25C26.25 24.0114 24.0114 26.25 21.25 26.25C18.4886 26.25 16.25 24.0114 16.25 21.25C16.25 18.4886 18.4886 16.25 21.25 16.25C24.0114 16.25 26.25 18.4886 26.25 21.25ZM13.75 8.75C13.75 11.5114 11.5114 13.75 8.75 13.75C5.98857 13.75 3.75 11.5114 3.75 8.75C3.75 5.98857 5.98857 3.75 8.75 3.75C11.5114 3.75 13.75 5.98857 13.75 8.75ZM26.25 8.75C26.25 11.5114 24.0114 13.75 21.25 13.75C20.323 13.75 19.4543 13.4965 18.7098 13.0566L13.0566 18.7098C13.4965 19.4543 13.75 20.323 13.75 21.25C13.75 24.0114 11.5114 26.25 8.75 26.25C5.98857 26.25 3.75 24.0114 3.75 21.25C3.75 18.4886 5.98857 16.25 8.75 16.25C9.67645 16.25 10.5449 16.5028 11.2891 16.9421L16.9421 11.2891C16.5028 10.5449 16.25 9.67645 16.25 8.75C16.25 5.98857 18.4886 3.75 21.25 3.75C24.0114 3.75 26.25 5.98857 26.25 8.75Z"/></svg>
            </div>
            <h5 class="h5_semi">n8n do automatyzacji</h5>
            <p class="p_regular_3">Edytor wizualny do łączenia platformy z CRM, pocztą, SMS czy systemem kurierskim. Scenariusz synchronizacji składasz z gotowych bloków.</p>
            <span class="cloud-includes__badge">Professional i Enterprise, w Start opcja</span>
          </div>

          <div class="cloud-includes__item lm-observer">
            <div class="cloud-includes__icon">
