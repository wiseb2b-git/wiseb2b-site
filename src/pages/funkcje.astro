          {obszary.map((obszar) => (
            <div class="functions-cards__item lm-observer">
              <p class="p_semi_2">{obszar.data.title}</p>
              <p class="p_regular_3">{obszarOpis[obszar.data.order] ?? obszar.data.modules.map((m) => m.name).join(', ')}</p>
            </div>
          ))}
        </div>
        <div class="lm-observer" style="text-align:center; margin-top:32px;">
          <a class="wise-button wise-button--wise-harvest" href="/plany-wiseb2b/#price-functions">Zobacz moduły w planach</a>
