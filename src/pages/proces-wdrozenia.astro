---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';
---

<BaseLayout title="Proces wdrożenia platformy B2B" description="Wdrożenie WiseB2B w sześciu etapach. Sprint analityczny trwa od 1 do 4 tygodni i kończy się zakresem, budżetem i terminem. Start obok obecnego procesu.">

<div class="supports-logos">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 offset-lg-2">
        <span class="page-hero__badge lm-observer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm0 2c-3.87 0-7 1.79-7 4v3h14v-3c0-2.21-3.13-4-7-4z"/></svg>
          Proces wdrożenia
        </span>
        <h1 class="h2_semi lm-observer">Wdrożenie platformy B2B, w którym <span style="color: #AF9ED7">zakres, budżet i termin</span> znasz przed startem prac</h1>
      </div>
    </div>
    <div class="row">
      <div class="col-lg-6 offset-lg-3 col-xl-6 offset-xl-3">
        <p class="p_regular_2 description lm-observer">Zaczynamy od sprintu analitycznego, który trwa od 1 do 4 tygodni. Potem przechodzimy przez pięć kolejnych etapów, a platforma rusza obok Twojego obecnego procesu sprzedaży. Klienci zamawiają jak dotąd, dopóki nie przejdą na nowy kanał.</p>
        <a href="/zamow-demo/" class="wise-button wise-button--wise-harvest lm-observer">Zamów demo</a>
      </div>
    </div>
  </div>
</div>

<!-- PLAN (spójny ze stroną główną) -->
<section class="hp-plan">
  <div class="container">
    <h2 class="hp-section-title lm-observer">Jak zaczynamy</h2>
    <ol class="hp-plan__steps">
      <li class="hp-plan__step lm-observer">
        <span class="hp-plan__num">1</span>
        <h3>Pokaz na Twoich przykładach</h3>
        <p>30 minut z konsultantem. Platforma na żywo, na scenariuszach z Twojej firmy.</p>
      </li>
      <li class="hp-plan__step lm-observer">
        <span class="hp-plan__num">2</span>
        <h3>Sprint analityczny</h3>
        <p>Od 1 do 4 tygodni. Na koniec wiesz, co wdrażamy, ile to kosztuje i kiedy ruszamy.</p>
      </li>
      <li class="hp-plan__step lm-observer">
        <span class="hp-plan__num">3</span>
        <h3>Uruchomienie obok obecnego procesu</h3>
        <p>Klienci przechodzą na platformę stopniowo. Stary system działa do końca przejścia.</p>
      </li>
    </ol>
    <p class="hp-plan__terms lm-observer">Sprint analityczny to pierwszy z sześciu etapów wdrożenia opisanych niżej. Abonament bez prowizji od obrotu, koszt wdrożenia rozłożony w subskrypcji.</p>
  </div>
</section>

<div class="supports-numbers supports-numbers--card">
  <div class="container">
    <div class="row">
      <div class="col">
        <div class="supports-numbers__numbers">

          <!-- Step 01 -->
          <div class="number lm-observer">
            <div class="row">
              <div class="col-md-12 col-lg-3 col-xl-3">
                <div class="number__wrap">
                  <img width="220" height="220" src="/images/np_suitcase_4525556.png" alt="Sprint analityczny" />
                </div>
              </div>
              <div class="col-md-12 col-lg-8 col-xl-7 p-xl-0">
                <div class="number__content">
                  <div class="number__title-row">
                    <span class="nr h1_regular">01</span>
                    <h2 class="h2_regular number__content-header">Sprint analityczny</h2>
                  </div>
                  <h3 class="h3_semi number__content-subheader">Ustalamy cele, zakres, budżet i termin wdrożenia</h3>
                  <ul>
                    <li class="list">
                      <p class="p_semi_1 list__header">Przebieg</p>
                      <p class="p_regular_3 list__description">Sprint trwa od 1 do 4 tygodni, zależnie od skali wdrożenia. Konsultanci WiseB2B pracują z osobami z Twojej firmy, które znają sprzedaż, obsługę klienta i ERP.</p>
                    </li>
                    <li class="list">
                      <p class="p_semi_1 list__header">Cele</p>
                      <p class="p_regular_3 list__description">Spisujemy, co platforma ma zmienić w Twojej sprzedaży i po czym poznasz, że działa. Może to być udział zamówień online, czas obsługi zamówienia albo liczba zapytań do BOK.</p>
                    </li>
                    <li class="list">
                      <p class="p_semi_1 list__header">Rezultat</p>
                      <p class="p_regular_3 list__description">Dostajesz backlog projektu, czyli listę wymagań do obsłużenia przez platformę, oraz ustalony zakres, termin i budżet wdrożenia. Jeśli któryś pomysł nie realizuje Twoich celów biznesowych, powiemy Ci to na tym etapie.</p>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 02 -->
          <div class="number lm-observer">
            <div class="row">
              <div class="col-md-12 col-lg-3 col-xl-3">
                <div class="number__wrap">
                  <img width="220" height="220" src="/images/np_operation_2998632.png" alt="Projekt graficzny" />
                </div>
              </div>
              <div class="col-md-12 col-lg-8 col-xl-7 p-xl-0">
                <div class="number__content">
                  <div class="number__title-row">
                    <span class="nr h1_regular">02</span>
                    <h2 class="h2_regular number__content-header">Projekt graficzny</h2>
                  </div>
                  <h3 class="h3_semi number__content-subheader">Wybierasz standardowy wygląd albo projekt pod swoją markę</h3>
                  <p class="p_regular_1 number__content-description">Możesz zacząć od standardowych widoków WiseB2B albo zaprojektować własne od podstaw. Pomożemy wybrać wariant, który pasuje do Twoich klientów i budżetu.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 03 -->
          <div class="number lm-observer">
            <div class="row">
              <div class="col-md-12 col-lg-3 col-xl-3">
                <div class="number__wrap">
                  <img width="220" height="220" src="/images/np_ecommerce_4557208.png" alt="Prace wdrożeniowe" />
                </div>
              </div>
              <div class="col-md-12 col-lg-8 col-xl-7 p-xl-0">
                <div class="number__content">
                  <div class="number__title-row">
                    <span class="nr h1_regular">03</span>
                    <h2 class="h2_regular number__content-header">Prace wdrożeniowe</h2>
                  </div>
                  <h3 class="h3_semi number__content-subheader">Ustawiamy platformę pod Twoje procesy sprzedaży</h3>
                  <ul>
                    <li class="list">
                      <p class="p_semi_1 list__header">Konfiguracja gotowych modułów</p>
                      <p class="p_regular_3 list__description">Większość pracy to ustawienie gotowych modułów pod Twoją sprzedaż: cenników indywidualnych, kredytu kupieckiego, sub-kont, akceptacji zamówień i magazynów. Platforma ma 37 modułów gotowych od startu.</p>
                    </li>
                    <li class="list">
                      <p class="p_semi_1 list__header">Elementy dedykowane</p>
                      <p class="p_regular_3 list__description">Jeśli w sprincie ustaliliśmy coś, czego nie ma w standardzie, budujemy to jako moduł lub wtyczkę na otwartym kodzie. Rdzeń platformy zostaje bez zmian.</p>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 04 -->
          <div class="number lm-observer">
            <div class="row">
              <div class="col-md-12 col-lg-3 col-xl-3">
                <div class="number__wrap">
                  <img width="220" height="220" src="/images/np_server_1122156.png" alt="Integracja z systemem ERP" />
                </div>
              </div>
              <div class="col-md-12 col-lg-8 col-xl-7 p-xl-0">
                <div class="number__content">
                  <div class="number__title-row">
                    <span class="nr h1_regular">04</span>
                    <h2 class="h2_regular number__content-header">Integracja z ERP</h2>
                  </div>
                  <h3 class="h3_semi number__content-subheader">Łączymy platformę z Twoim systemem ERP</h3>
                  <p class="p_regular_1 number__content-description">Od integracji z ERP zależy, czy klient zobaczy swoje ceny i warunki. Dlatego prowadzimy ją równolegle z pracami wdrożeniowymi. Mamy gotowe integracje z Teneum, Comarch XL i Optima, enova365 oraz Subiektem. Inne systemy łączymy przez API albo n8n. Więcej na stronie <a href="/integracje/">Integracje</a>.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 05 -->
          <div class="number lm-observer">
            <div class="row">
              <div class="col-md-12 col-lg-3 col-xl-3">
                <div class="number__wrap">
                  <img width="220" height="220" src="/images/np_gears_9428_000000-1.png" alt="Testy akceptacyjne" />
                </div>
              </div>
              <div class="col-md-12 col-lg-8 col-xl-7 p-xl-0">
                <div class="number__content">
                  <div class="number__title-row">
                    <span class="nr h1_regular">05</span>
                    <h2 class="h2_regular number__content-header">Testy akceptacyjne</h2>
                  </div>
                  <h3 class="h3_semi number__content-subheader">Sprawdzasz platformę na scenariuszach z Twojej firmy</h3>
                  <p class="p_regular_1 number__content-description">Twoi ludzie przechodzą scenariusze z codziennej pracy: zamówienie z rabatem indywidualnym, zamówienie powyżej limitu kupieckiego, ofertę przygotowaną przez handlowca. Poprawki robimy, zanim platformę zobaczy pierwszy klient.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 06 -->
          <div class="number lm-observer">
            <div class="row">
              <div class="col-md-12 col-lg-3 col-xl-3">
                <div class="number__wrap">
                  <img width="220" height="220" src="/images/np_sale_3972942.png" alt="Uruchomienie" />
                </div>
              </div>
              <div class="col-md-12 col-lg-8 col-xl-7 p-xl-0">
                <div class="number__content">
                  <div class="number__title-row">
                    <span class="nr h1_regular">06</span>
                    <h2 class="h2_regular number__content-header">Uruchomienie</h2>
                  </div>
                  <h3 class="h3_semi number__content-subheader">Platforma rusza obok obecnego procesu</h3>
                  <p class="p_regular_1 number__content-description">Platformę dostaje najpierw wybrana grupa klientów albo od razu wszyscy, zależnie od skali Twojej firmy. Telefon, mail i dotychczasowy system działają do końca przejścia. Po starcie dalej rozwijamy platformę razem z Tobą, bo współpraca nie kończy się na wdrożeniu. <a href="/bezpieczna-migracja/">Zobacz, jak przenosimy klientów ze starego systemu</a>.</p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<!-- DOWODY -->
<section class="hp-case">
  <div class="container">
    <h2 class="hp-section-title lm-observer">Tak to wygląda u naszych klientów</h2>
    <div class="hp-proof">
      <div class="hp-proof__card lm-observer">
        <img src="/images/logo-vmp.jpg" alt="VMP" width="140" height="50" class="hp-proof__logo" loading="lazy" />
        <p class="hp-proof__desc">Bielizna, 86 000 indeksów, sprzedaż do sklepów w krajach UE. Stary system B2B wyłączony po miesiącu.</p>
        <div class="hp-proof__stats">
          <div><span class="hp-proof__value">−60%</span><span class="hp-proof__label">czasu obsługi zamówienia</span></div>
          <div><span class="hp-proof__value">−45%</span><span class="hp-proof__label">zapytań do BOK</span></div>
        </div>
        <a href="/case-study/vmp/" class="hp-why__link">Zobacz case study VMP</a>
      </div>
      <div class="hp-proof__card lm-observer">
        <img src="/images/triplexLogo.jpg" alt="Triplex" width="152" height="44" class="hp-proof__logo" loading="lazy" />
        <p class="hp-proof__desc">Dystrybutor pirotechniki. Klienci przed wdrożeniem zamawiali telefonem i w Excelu.</p>
        <div class="hp-proof__stats">
          <div><span class="hp-proof__value">49,55%</span><span class="hp-proof__label">obrotu wygenerowanego poprzez platformę B2B</span></div>
          <div><span class="hp-proof__value">46,36%</span><span class="hp-proof__label">zamówień pochodzących z platformy B2B</span></div>
        </div>
        <a href="/case-study/triplex/" class="hp-why__link">Zobacz case study Triplex</a>
      </div>
    </div>
  </div>
</section>

<!-- CTA: rozmowa z ekspertem -->
<section class="call-expert">
  <div class="container">
    <div class="row">
      <div class="col-xl-8 offset-xl-2 col-lg-10 offset-lg-1">
        <div class="call-expert__wrapper">
          <h2 class="h2_semi">Zapytaj o wdrożenie w Twojej firmie</h2>
          <p class="name h5_regular">Jakub Czyżkowski</p>
          <p class="job p_regular_2">CEO</p>
          <div class="call-expert__button">
            <a class="wise-button wise-button--wise-harvest" href="/zamow-demo/">Zamów rozmowę z ekspertem</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<CtaBlock />

</BaseLayout>
