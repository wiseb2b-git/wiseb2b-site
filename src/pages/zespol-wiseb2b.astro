---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';
---

<BaseLayout title="Zespół WiseB2B: doradztwo, wdrożenie i rozwój platformy" description="Konsultanci WiseB2B pomagają zaplanować sprzedaż online, wdrożyć platformę Commerce B2B i rozwijać ją po starcie. W drugiej linii wspiera nas Sente." service={{ name: "Wsparcie platformy Commerce B2B WiseB2B", serviceType: "Wsparcie SaaS", description: "Doradztwo, wdrożenie, utrzymanie i rozwój platformy Commerce B2B WiseB2B dla dystrybutorów i producentów." }}>

<div class="supports-logos">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 offset-lg-2">
        <span class="page-hero__badge lm-observer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
          Zespół
        </span>
        <h1 class="h2_semi lm-observer">Działamy razem, na dłuższą metę</h1>
      </div>
    </div>
    <div class="row">
      <div class="col-lg-6 offset-lg-3 col-xl-6 offset-xl-3">
        <p class="p_regular_2 description lm-observer">Za platformą WiseB2B stoi zespół konsultantów, którzy znają handel B2B od strony handlowca, magazynu i&nbsp;ERP. Pomagamy zaplanować sprzedaż online, uruchomić platformę i&nbsp;rozwijać ją, gdy rośnie Twoja firma.</p>
        <a href="/zamow-demo/" class="wise-button wise-button--wise-harvest lm-observer">Zamów demo</a>
      </div>
    </div>
    <div class="row">
      <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
        <div class="boxes boxes--flat">
          <div class="box lm-observer">
            <div class="box__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
            </div>
            <div class="box__content">
              <p class="p_semi_2 box__content-header">Doradztwo</p>
              <p class="p_regular_3 box__content-description">Pracujesz z konsultantami, którzy znają ERP i&nbsp;procesy handlowe. W&nbsp;drugiej linii wspiera nas Sente, 25 lat w&nbsp;oprogramowaniu dla handlu.</p>
            </div>
          </div>
          <div class="box lm-observer">
            <div class="box__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.66 5.66L3 18v3h3l6.04-6.04a4 4 0 0 0 5.66-5.66l-2.83 2.83-2.12-2.12 2.83-2.83z"/></svg>
            </div>
            <div class="box__content">
              <p class="p_semi_2 box__content-header">Wdrożenie</p>
              <p class="p_regular_3 box__content-description">Sprint analityczny trwa od 1 do 4 tygodni. Potem wiesz, co wdrażamy, ile to kosztuje i&nbsp;kiedy ruszamy.</p>
            </div>
          </div>
          <div class="box lm-observer">
            <div class="box__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>
            </div>
            <div class="box__content">
              <p class="p_semi_2 box__content-header">Utrzymanie i&nbsp;rozwój</p>
              <p class="p_regular_3 box__content-description">Po starcie rozwijamy platformę razem z&nbsp;Tobą, w&nbsp;miarę jak zmieniają się Twoi klienci i&nbsp;asortyment.</p>
            </div>
          </div>
          <div class="box lm-observer">
            <div class="box__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="6" rx="1.5"/><rect x="3" y="15" width="18" height="6" rx="1.5"/><circle cx="7" cy="6" r="0.8" fill="currentColor" stroke="none"/><circle cx="7" cy="18" r="0.8" fill="currentColor" stroke="none"/></svg>
            </div>
            <div class="box__content">
              <p class="p_semi_2 box__content-header">Infrastruktura</p>
              <p class="p_regular_3 box__content-description">Wybierasz WiseB2B Cloud albo własne serwery. W&nbsp;chmurze serwerami zajmujemy się my.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="supports-numbers">
  <div class="container">

    <div class="team-process__block lm-observer">
      <div class="team-process__head">
        <span class="team-process__num">01</span>
        <h2 class="team-process__title">Doradztwo</h2>
        <p class="team-process__subtitle">Zanim cokolwiek wdrożymy, ustalamy, co ma się zmienić w&nbsp;Twojej sprzedaży</p>
      </div>
      <div class="team-process__grid team-process__grid--3">
        <div class="team-process__card">
          <span class="team-process__card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2"/><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M3 13h18M9 13v2a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-2"/></svg>
          </span>
          <p class="p_semi_1 team-process__card-title">Punkt wyjścia</p>
          <p class="p_regular_3 team-process__card-desc">Zamówienia przychodzą telefonem, mailem i&nbsp;w&nbsp;Excelu? Albo masz już platformę B2B, ale klienci z&nbsp;niej nie korzystają? Zaczynamy od rozmowy o&nbsp;tym, jak dziś sprzedajesz i&nbsp;gdzie handlowcy tracą czas.</p>
        </div>
        <div class="team-process__card">
          <span class="team-process__card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
          </span>
          <p class="p_semi_1 team-process__card-title">Cele i plan</p>
          <p class="p_regular_3 team-process__card-desc">Razem ustalamy, co ma się zmienić: jaka część zamówień ma przejść do samoobsługi, które warunki handlowe z&nbsp;ERP muszą działać od startu i&nbsp;którzy klienci zaczną pierwsi. Jeśli pomysł nie realizuje celu, powiemy to otwarcie.</p>
        </div>
        <div class="team-process__card">
          <span class="team-process__card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.66 5.66L3 18v3h3l6.04-6.04a4 4 0 0 0 5.66-5.66l-2.83 2.83-2.12-2.12 2.83-2.83z"/></svg>
          </span>
          <p class="p_semi_1 team-process__card-title">Platforma dopasowana do planu</p>
          <p class="p_regular_3 team-process__card-desc">Klient ma na platformie dostać obsługę co najmniej tak dobrą, jak od swojego handlowca, tylko o&nbsp;każdej porze. Dlatego cenniki indywidualne, kredyt kupiecki i&nbsp;historia zamówień pochodzą z&nbsp;ERP, a&nbsp;handlowiec widzi w&nbsp;Panelu Handlowca to samo co klient.</p>
        </div>
      </div>
    </div>

    <div class="team-process__block lm-observer">
      <div class="team-process__panel">
        <div class="team-process__panel-media">
          <img loading="lazy" width="640" height="480" src="/images/business-coworkers-shaking-hands-1536x1024.jpg" alt="Wdrożenie platformy B2B" />
        </div>
        <div class="team-process__panel-text">
          <span class="team-process__num team-process__num--left">02</span>
          <h2 class="team-process__title team-process__title--left">Wdrożenie i&nbsp;uruchomienie</h2>
          <p class="team-process__subtitle team-process__subtitle--left">Platforma rusza obok tego, co już działa</p>
          <p class="p_regular_1 team-process__panel-desc">Uruchomiona platforma nie oznacza jeszcze, że klienci zaczną z&nbsp;niej korzystać. Dlatego najpierw robimy sprint analityczny (od 1 do 4 tygodni) i&nbsp;projektujemy ścieżkę zakupową pod Twoich klientów. Potem platforma startuje obok telefonu, maila i&nbsp;obecnego systemu. Klienci przechodzą na nią stopniowo, a&nbsp;stary system działa do końca przejścia. Triplex obawiał się, że klienci zostaną przy Excelu. Dziś przez platformę przechodzi 46,36% jego zamówień.</p>
        </div>
      </div>
    </div>

    <div class="team-process__cta lm-observer">
      <img loading="lazy" width="1200" height="480" src="/images/lg-screen-office-view.png" class="team-process__cta-bg" alt="Platforma WiseB2B na dużym ekranie w biurze" />
      <div class="team-process__cta-overlay"></div>
      <div class="team-process__cta-content">
        <h3 class="h3_semi">Zobacz WiseB2B na swoich procesach</h3>
        <p class="p_regular_2">30 minut z konsultantem, platforma na żywo, scenariusze z&nbsp;Twojej firmy.</p>
        <a class="p_semi_2 wise-button wise-button--wise-harvest" href="/zamow-demo/">Zamów demo</a>
      </div>
    </div>

    <div class="team-process__block lm-observer">
      <div class="team-process__head">
        <span class="team-process__num">03</span>
        <h2 class="team-process__title">Utrzymanie i&nbsp;rozwój</h2>
        <p class="team-process__subtitle">Współpraca nie kończy się na wdrożeniu</p>
      </div>
      <div class="team-process__grid team-process__grid--2">
        <div class="team-process__card">
          <span class="team-process__card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="9" width="16" height="10" rx="2"/><path d="M9 9V7a3 3 0 0 1 6 0v2"/><circle cx="9" cy="14" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="14" r="1" fill="currentColor" stroke="none"/></svg>
          </span>
          <p class="p_semi_1 team-process__card-title">Platforma nadąża za Twoją sprzedażą</p>
          <p class="p_regular_3 team-process__card-desc">Zmieniają się Twoi klienci, asortyment i&nbsp;przepisy. Zgodność z&nbsp;GPSR, RODO i&nbsp;Omnibus utrzymujemy po naszej stronie, a&nbsp;proces zakupowy poprawiamy razem z&nbsp;Tobą na podstawie tego, jak klienci korzystają z&nbsp;platformy.</p>
        </div>
        <div class="team-process__card">
          <span class="team-process__card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l5-5 4 4 8-8"/><path d="M14 8h6v6"/></svg>
          </span>
          <p class="p_semi_1 team-process__card-title">Nowe funkcje i&nbsp;wybór wykonawcy</p>
          <p class="p_regular_3 team-process__card-desc">Konsultanci pomagają wskazać, co usprawnić, i&nbsp;wdrażają nowe funkcje jako wtyczki. Rozwój możesz też powierzyć własnemu zespołowi IT albo <a href="/partnerzy-wdrozeniowi/">partnerowi wdrożeniowemu</a>. Nie jesteś skazany na jednego dostawcę.</p>
        </div>
      </div>
    </div>

    <div class="team-process__block lm-observer">
      <div class="team-process__panel">
        <div class="team-process__panel-media">
          <img loading="lazy" width="640" height="480" src="/images/people-gac9f90525_640.jpg" alt="Infrastruktura platformy B2B" />
        </div>
        <div class="team-process__panel-text">
          <span class="team-process__num team-process__num--left">04</span>
          <h2 class="team-process__title team-process__title--left">Infrastruktura</h2>
          <p class="p_regular_1 team-process__panel-desc">W&nbsp;WiseB2B Cloud platforma działa w&nbsp;chmurze, a&nbsp;utrzymanie i&nbsp;monitoring serwerów są po naszej stronie. W&nbsp;chmurze masz też n8n do automatyzacji integracji. Jeśli wolisz własną infrastrukturę, WiseB2B działa również on-premise, na Twoich serwerach.</p>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- KONTAKT -->
<section class="hp-final">
  <div class="container">
    <div class="hp-final__card lm-observer">
      <h2>Potrzebujesz szczegółów przed rozmową?</h2>
      <p>Napisz, jak dziś przyjmujesz zamówienia i z jakiego ERP korzystasz. Odpowiemy konkretnie.</p>
      <a href="/zamow-demo/" class="btn btn--light">Zamów demo</a>
      <p class="hp-final__contact">Jakub Czyżkowski, CEO: <a href="mailto:kontakt@wiseb2b.eu">kontakt@wiseb2b.eu</a></p>
    </div>
  </div>
</section>

<CtaBlock />

</BaseLayout>
