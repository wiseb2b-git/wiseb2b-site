---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';

// Tekst: .knowledge/teksty/platforma-commerce-b2b.md (copy deck po redakcji), układ: Figma 95:64.
const icon = (d: string) => `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const I = {
  cart: '<circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M3 4h2l2.4 11h11.2L21 7H6.2"/>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
  ai: '<path d="M12 3l1.8 4.6L18.5 9l-4.7 1.4L12 15l-1.8-4.6L5.5 9l4.7-1.4z"/><path d="M19 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/>',
  code: '<path d="M8 3H7a2 2 0 0 0-2 2v4a2 2 0 0 1-2 2 2 2 0 0 1 2 2v4a2 2 0 0 0 2 2h1M16 3h1a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2 2 2 0 0 0-2 2v4a2 2 0 0 1-2 2h-1"/>',
};

const faq = [
  { q: 'Czym wyróżnia się WiseB2B na tle innych platform B2B?', a: 'WiseB2B to jedyna platforma Commerce B2B łącząca cztery elementy, których nie znajdziesz razem w żadnym innym rozwiązaniu: agentów AI realizujących realne operacje zakupowe, wbudowany Panel Handlowca (Sales CRM) integrujący sprzedaż online i offline, dostęp do kodu źródłowego eliminujący vendor lock-in oraz modułową architekturę pluginów umożliwiającą rozwój bez ryzyka utraty customizacji przy aktualizacjach. Dodatkowo WiseB2B nie pobiera prowizji od wartości transakcji (GMV), oferuje Client API pozwalające klientom integrować własne systemy zakupowe oraz gotowe integracje z polskimi systemami ERP. To platforma zaprojektowana od podstaw dla B2B, a nie adaptacja sklepu detalicznego.' },
  { q: 'Jak działają agenci AI w platformie WiseB2B?', a: 'Agenci AI w WiseB2B to autonomiczni agenci wykonujący złożone operacje na polecenie użytkownika. Klient może poprosić agenta o wyszukanie produktów spełniających określone kryteria, zbudowanie całego koszyka zakupowego, import zamówienia z maila, pliku Excel czy PDF, sprawdzenie statusu dostawy lub porównanie produktów. Agent Handlowca przygotowuje oferty z otrzymanych wiadomości i podpowiada kolejne kroki. Agent Administratora wspiera natomiast operacje masowe, np. hurtową aktualizację cenników czy zarządzanie katalogiem. W praktyce oznacza to mniej maili, mniej telefonów do działu obsługi i znacznie szybszą realizację zamówień, zarówno dla Twoich klientów, jak i Twojego zespołu.' },
  { q: 'Co to jest Panel Handlowca i jak wspiera sprzedaż?', a: 'Panel Handlowca to wbudowany moduł Sales CRM, który zastępuje potrzebę korzystania z osobnego systemu CRM. Handlowiec ma w jednym miejscu dostęp do przygotowywania ofert indywidualnych, monitorowania zakupów klientów i reagowania na spadki, analizy wypracowanej marży i trendów zakupowych, definiowania celów sprzedażowych oraz obsługi zdarzeń i zadań. Panel Handlowca operuje na tych samych cenach, warunkach handlowych i dostępnościach co platforma eCommerce. Dzięki temu obsługa klienta online i offline jest w pełni spójna, a handlowiec zamiast administrować transakcjami, skupia się na budowaniu relacji i wzroście marży. Panel jest w pakiecie Enterprise, a w Professional możesz go dodać jako opcję.' },
  { q: 'Czy WiseB2B daje dostęp do kodu źródłowego?', a: 'Tak. W odróżnieniu od platform SaaS, WiseB2B udostępnia kod źródłowy, co daje Ci pełną niezależność technologiczną. Kod źródłowy jest w pakiecie Enterprise, a w Professional możesz go dokupić. Rozwojem platformy może zająć się Twój własny zespół IT, dowolna agencja lub jeden z Partnerów Wdrożeniowych WiseB2B. Modułowa architektura oparta na pluginach sprawia, że customizacje nie kolidują z kodem standardowym, a aktualizacje do nowych wersji nie psują Twoich rozszerzeń. W Enterprise możesz dodać Customization Studio, środowisko do tworzenia pluginów z pomocą AI.' },
  { q: 'Czym WiseB2B różni się od platform open source i zamkniętych SaaS?', a: 'Popularne platformy open source powstały dla sprzedaży detalicznej (B2C) i wymagają kosztownej rozbudowy, aby obsłużyć grupy klientów, hierarchie cennikowe, kredyt kupiecki czy autoryzację zamówień. Takie wdrożenie kosztuje zwykle 2&ndash;3 razy więcej, a zgodność z przepisami zostaje po Twojej stronie. WiseB2B zostało zaprojektowane od podstaw dla B2B, więc te funkcje są dostępne od razu, co znacząco obniża koszty i czas wdrożenia. W porównaniu z zamkniętymi platformami SaaS WiseB2B daje dostęp do kodu źródłowego, brak opłat GMV, możliwość instalacji OnPremise i swobodę customizacji.' },
  { q: 'Czy WiseB2B pobiera prowizję od wartości transakcji (GMV)?', a: 'Nie, i to dożywotnia obietnica WiseB2B. Platforma działa w modelu abonamentowym z trzema planami: Start od 1 990 zł, Professional od 3 490 zł i Enterprise od 6 990 zł netto miesięcznie. Płacisz stałą miesięczną opłatę niezależnie od tego, ile sprzedajesz. Nie ma ukrytych prowizji od obrotu, prowizji od liczby transakcji ani dodatkowych opłat rosnących wraz z Twoim sukcesem. Im więcej sprzedajesz, tym bardziej opłacalne staje się korzystanie z platformy. Szczegóły i porównanie planów znajdziesz na stronie <a href="/plany-wiseb2b/">Plany WiseB2B</a>.' },
  { q: 'Co to jest Client API i jak mogą z niego korzystać moi klienci?', a: 'Client API umożliwia Twoim klientom biznesowym zintegrowanie ich własnych systemów zakupowych (ERP, system zamówień, platforma procurement) bezpośrednio z Twoją platformą sprzedażową. W praktyce oznacza to, że klient może składać zamówienia, sprawdzać stany magazynowe i pobierać faktury bez konieczności logowania się do Twojego sklepu, bo wszystko dzieje się automatycznie między systemami. To poważna przewaga konkurencyjna: klientowi, który zintegrował się z Tobą przez API, kupuje się u Ciebie najwygodniej ze wszystkich dostawców.' },
  { q: 'Ile trwa wdrożenie i od czego się zaczyna?', a: 'Zaczynamy od sprintu analitycznego, który trwa od 1 do 4 tygodni. Jego wynikiem jest backlog, zakres, czas i budżet wdrożenia, więc przed startem wiesz, co dostaniesz i za ile. Samo wdrożenie trwa zwykle od 2 do 6 miesięcy. Stary system działa w tym czasie równolegle, dopóki klienci nie przejdą na nową platformę.' },
  { q: 'Dla jakich firm jest WiseB2B? Czy moja firma się kwalifikuje?', a: 'WiseB2B jest przeznaczone dla polskich firm handlowych i produkcyjnych prowadzących sprzedaż B2B, przede wszystkim dystrybutorów, hurtowni i producentów z własnymi kanałami sprzedaży. Platforma sprawdza się najlepiej w firmach o rocznych obrotach od ok. 20 mln zł, z co najmniej 100 stałymi klientami, 300 transakcjami miesięcznie i zespołem handlowym. WiseB2B jest szczególnie dobrym wyborem, jeśli Twoja obecna platforma to rozwiązanie SaaS bez możliwości customizacji, system dedykowany, którego rozwój jest kosztowny, lub platforma B2C rozbudowana o moduły B2B, które nie pokrywają Twoich realnych potrzeb. Szczegóły dopasowania do branż znajdziesz na stronach <a href="/dla-dystrybutorow/">dla dystrybutorów</a> i <a href="/dla-producentow/">dla producentów</a>.' },
];
const faqSchema = faq.map(f => ({ question: f.q, answer: f.a.replace(/<[^>]+>/g, '').replace(/&ndash;/g, '–') }));
---

<BaseLayout title="Platforma Commerce B2B z agentami AI i Panelem Handlowca" description="WiseB2B to platforma Commerce B2B stworzona od podstaw dla B2B. Agenci AI, Panel Handlowca, kod źródłowy, gotowe integracje z ERP i brak opłat od obrotu." faq={faqSchema}>

  <!-- S1. HERO -->
  <section class="text-logos kv-on-dark">
    <div class="container">
      <div class="row">
        <div class="col-lg-8 offset-lg-2">
          <div class="text-logos__wrapper">
            <span class="text-logos__badge">
              <span class="text-logos__badge-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              </span>
              Platforma Commerce B2B
            </span>
            <h1 class="text-logos__title kv-h1">Platforma Commerce B2B z <span>agentami AI</span>, Panelem Handlowca i otwartym kodem</h1>
            <p class="desc kv-lead">Platforma eCommerce B2B dla firm handlowych i produkcyjnych, łącząca sklep B2B, Panel Handlowca i Agenta AI w jednym środowisku.</p>
            <div class="page-hero__actions">
              <a class="wise-button wise-button--wise-harvest" href="/zamow-demo/">Zamów demo</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- S2. CZTERY FILARY -->
  <div class="functions-list-artwork" style="background:#fff; padding-top:60px; padding-bottom:20px; margin-top:0; margin-bottom:0;">
    <div class="container">
      <h2 class="hp-section-title pcb-claim lm-observer kv-h2">Jedyna platforma Commerce B2B AI-Native z Panelem Handlowca i otwartym kodem</h2>

      <!-- 1. B2B first (zdjęcie z lewej) -->
      <div class="row" style="margin-bottom: 100px;">
        <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
          <div class="feature-row feature-row--reverse" style="display:flex; align-items:center; gap:40px;">
            <div class="feature-row__img lm-observer" style="flex:5; min-width:0;">
              <img loading="lazy" src="/images/iStock-1039579142.jpg" style="width:100%; height:auto; border-radius:16px; display:block;" alt="Platforma B2B projektowana dla handlu hurtowego" />
            </div>
            <div class="feature-row__text" style="flex:7; min-width:0; display:flex; flex-direction:column; justify-content:center;">
              <ul class="list list--right" style="margin-top:0;">
                <li class="lm-observer">
                  <span class="icon-purple-badge pcb-icon" set:html={icon(I.cart)} />
                  <div>
                    <h3 class="head kv-title">B2B first: platforma stworzona dla B2B, nie adaptowana</h3>
                    <p class="description kv-text">Większość rozwiązań dostępnych na rynku to platformy B2C rozbudowane o moduły dla biznesu. WiseB2B powstało od podstaw z myślą o złożoności relacji handlowych B2B: grupach klientów, hierarchiach cennikowych, kredycie kupieckim, sub-kontach i procesach akceptacji zamówień. Warunki zapisane w ERP widać na platformie 1:1, a w standardzie dostajesz 37 modułów w 13 obszarach. Dzięki temu wdrożenie jest szybsze, tańsze i trafia dokładnie w potrzeby Twojej organizacji.</p>
                    <a href="/funkcje/" class="hp-why__link">Zobacz wszystkie funkcje</a>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Panel Handlowca (zdjęcie z prawej) -->
      <div class="row" style="margin-bottom: 100px;">
        <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
          <div class="feature-row" style="display:flex; align-items:center; gap:40px;">
            <div class="feature-row__text" style="flex:7; min-width:0; display:flex; flex-direction:column; justify-content:center;">
              <ul class="list list--left" style="margin-top:0;">
                <li class="lm-observer">
                  <span class="icon-purple-badge pcb-icon" set:html={icon(I.grid)} />
                  <div>
                    <h3 class="head kv-title">Panel Handlowca: sprzedaż online i offline w jednym miejscu</h3>
                    <p class="description kv-text">Zamiast żonglować oddzielnym CRM-em i platformą eCommerce, Twoi handlowcy mają wszystko pod ręką w jednym systemie. Te same ceny, te same warunki, ten sam klient, niezależnie od tego, czy zakup odbywa się online, czy przez telefon. Panel ma 8 obszarów, w tym kalendarz i zadania, ofertowanie, sprawy handlowe i kartę klienta 360°. Przygotowywanie ofert, monitorowanie zakupów, reagowanie na spadki sprzedaży to realne wsparcie nastawione na wzrost marży.</p>
                    <a href="/panel-handlowca/" class="hp-why__link">Poznaj Panel Handlowca</a>
                  </div>
                </li>
              </ul>
            </div>
            <div class="feature-row__img lm-observer" style="flex:5; min-width:0;">
              <img loading="lazy" src="/images/pexels-fauxels-3182826-1.jpeg" style="width:100%; height:auto; border-radius:16px; display:block;" alt="Zespół handlowy pracujący w Panelu Handlowca" />
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Agenci AI (zdjęcie z lewej) -->
      <div class="row" style="margin-bottom: 100px;">
        <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
          <div class="feature-row feature-row--reverse" style="display:flex; align-items:center; gap:40px;">
            <div class="feature-row__img lm-observer" style="flex:5; min-width:0;">
              <img loading="lazy" src="/images/startup-gcc67d2922_640.jpg" style="width:100%; height:auto; border-radius:16px; display:block;" alt="Agenci AI w platformie Commerce B2B" />
            </div>
            <div class="feature-row__text" style="flex:7; min-width:0; display:flex; flex-direction:column; justify-content:center;">
              <ul class="list list--right" style="margin-top:0;">
                <li class="lm-observer">
                  <span class="icon-purple-badge pcb-icon" set:html={icon(I.ai)} />
                  <div>
                    <h3 class="head kv-title">Agenci AI działający w praktyce</h3>
                    <p class="description kv-text">WiseB2B to pierwsza platforma Commerce B2B z agentami AI, które naprawdę pracują. Klient może nie tylko wyszukać produkt, może też poprosić agenta o zbudowanie całego koszyka, import zamówienia z dowolnego pliku, sprawdzenie statusu dostawy czy porównanie ofert. Agent Handlowca przygotowuje ofertę z otrzymanej wiadomości i podpowiada, czym zająć się dziś, a Agent Administratora wykonuje operacje masowe na cennikach i katalogu. Mniej maili, mniej telefonów, mniej pracy dla Twojego BOK. Więcej czasu na to, co naprawdę ważne.</p>
                    <a href="/agent-ai/" class="hp-why__link">Zobacz Agenta AI</a>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. Kod źródłowy (zdjęcie z prawej) -->
      <div class="row" style="margin-bottom: 100px;">
        <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
          <div class="feature-row" style="display:flex; align-items:center; gap:40px;">
            <div class="feature-row__text" style="flex:7; min-width:0; display:flex; flex-direction:column; justify-content:center;">
              <ul class="list list--left" style="margin-top:0;">
                <li class="lm-observer">
                  <span class="icon-purple-badge pcb-icon" set:html={icon(I.code)} />
                  <div>
                    <h3 class="head kv-title">Kod źródłowy: Twoja niezależność i bezpieczeństwo</h3>
                    <p class="description kv-text">W odróżnieniu od platform SaaS, z WiseB2B nie jesteś uzależniony od jednego dostawcy. Masz dostęp do kodu źródłowego, więc rozwojem może zająć się Twój własny zespół IT lub dowolna agencja. Modułowa architektura i technologia pluginów sprawiają, że aktualizacje nie psują Twoich customizacji. Budujesz na solidnym fundamencie. I ten fundament zawsze jest Twój.</p>
                    <a href="/integracje/" class="hp-why__link">Zobacz integracje i technologię</a>
                  </div>
                </li>
              </ul>
            </div>
            <div class="feature-row__img lm-observer" style="flex:5; min-width:0;">
              <img loading="lazy" src="/images/lg-screen-office-view.png" style="width:100%; height:auto; border-radius:16px; display:block;" alt="Sklep B2B na platformie WiseB2B" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- S3. CO WIĘCEJ W WISEB2B -->
  <div class="functions-box-white-bg" style="margin-top:0; margin-bottom:0; background:#f8f7fa; padding:60px 0;">
    <div class="container">
      <div class="row">
        <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
          <div class="functions-box-white-bg__wrap">
            <h2 class="lm-observer kv-h2" style="text-align:center;">
              Co więcej w <img src="/svg/logo-wiseb2b.svg" alt="WiseB2B" style="height:1em; width:auto; display:inline-block; vertical-align:middle; position:relative; top:-0.05em;" />?
            </h2>
          </div>
          <div class="wise-more-table">

            <div class="wise-more-row lm-observer">
              <div class="wise-more-row__name"><h3 class="kv-title" style="margin:0;">Client API</h3></div>
              <div class="wise-more-row__icon"><div class="wise-more-row__icon-bg"><img src="/svg/icon-client-api.svg" width="26" height="26" alt="" /></div></div>
              <div class="wise-more-row__desc">
                <p class="kv-text" style="margin:0;">Twoi klienci mogą zintegrować swoje systemy zakupowe bezpośrednio z Twoją platformą. Zamówienia, stany i faktury przechodzą między systemami, bez logowania do sklepu i przepisywania indeksów. Nigdzie nie będzie im się kupowało tak wygodnie jak u Ciebie.</p>
              </div>
            </div>

            <div class="wise-more-row lm-observer">
              <div class="wise-more-row__name"><h3 class="kv-title" style="margin:0;">Gotowe integracje</h3></div>
              <div class="wise-more-row__icon"><div class="wise-more-row__icon-bg"><img src="/svg/icon-integracje.svg" width="26" height="26" alt="" /></div></div>
              <div class="wise-more-row__desc">
                <p class="kv-text" style="margin:0;">Gotowe integracje z systemami ERP (Teneum, Comarch XL, Comarch Optima, enova365, Subiekt) oraz platformą integracyjną Apilo istotnie zmniejszają ryzyka projektu, jego koszty i czas wdrożenia. Pozostałe systemy połączysz przez n8n albo Admin API.</p>
              </div>
            </div>

            <div class="wise-more-row lm-observer">
              <div class="wise-more-row__name"><h3 class="kv-title" style="margin:0;">Wersja mobilna</h3></div>
              <div class="wise-more-row__icon"><div class="wise-more-row__icon-bg"><img src="/svg/icon-mobile.svg" width="26" height="26" alt="" /></div></div>
              <div class="wise-more-row__desc">
                <p class="kv-text" style="margin:0;">Mobilna wersja platformy dostarczana jest w standardzie. Twoi klienci mogą składać zamówienia w każdych warunkach: z biura, magazynu czy w trasie.</p>
              </div>
            </div>

            <div class="wise-more-row lm-observer">
              <div class="wise-more-row__name"><h3 class="kv-title" style="margin:0;">Ekspansja zagraniczna</h3></div>
              <div class="wise-more-row__icon"><div class="wise-more-row__icon-bg"><img src="/svg/icon-ekspansja.svg" width="26" height="26" alt="" /></div></div>
              <div class="wise-more-row__desc">
                <p class="kv-text" style="margin:0;">Wielojęzyczność, wielokrajowość, wielosklepowość i wielowalutowość wbudowane w system. Automatyczna weryfikacja VIES, obsługa stawek VAT (także VAT 0% przy dostawie do innego kraju UE), kursy walut z NBP lub ECB i lokalne metody dostawy. Handel z całym światem bez większego wysiłku: VMP sprzedaje tak do 13 krajów w 13 wersjach językowych.</p>
              </div>
            </div>

            <div class="wise-more-row lm-observer">
              <div class="wise-more-row__name"><h3 class="kv-title" style="margin:0;">SEO-friendly</h3></div>
              <div class="wise-more-row__icon"><div class="wise-more-row__icon-bg"><img src="/svg/icon-seo.svg" width="26" height="26" alt="" /></div></div>
              <div class="wise-more-row__desc">
                <p class="kv-text" style="margin:0;">Platforma B2B to nie tylko obsługa obecnych klientów, ale też pozyskiwanie nowych. WiseB2B jest zoptymalizowane pod wyszukiwarki, a profil otwarty pokazuje katalog bez logowania, żeby Twoje produkty i firma były widoczne tam, gdzie szukają Cię potencjalni klienci.</p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- S4. BEZPIECZEŃSTWO -->
  <div class="functions-box-white-bg" style="background:#fff; margin-top:0; margin-bottom:0; padding:60px 0;">
    <div class="container">
      <div class="row">
        <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
          <div class="functions-box-white-bg__wrap">
            <h2 class="functions-box-white-bg__header lm-observer kv-h2">Bezpieczeństwo Twojego biznesu</h2>
            <p class="lm-observer kv-text" style="text-align:center; margin-top:16px; max-width:560px; margin-left:auto; margin-right:auto;">WiseB2B to nie tylko technologia, ale też partner, który dba o Twoją niezależność, zgodność z prawem i stabilność biznesu na każdym etapie.</p>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
          <div class="about-us-rules__items rules-compact" style="padding: 20px 0 20px;">

            <div class="about-us-rules__item lm-observer">
              <div class="about-us-rules__icon"><div class="about-us-rules__icon-bg"><img src="/svg/icon-no-vendor-lock.svg" width="24" height="24" alt="" /></div></div>
