---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';
// Tekst: .knowledge/teksty/zespol-wiseb2b.md (Figma 51:1818).
---

<BaseLayout title="Zespół WiseB2B: doradztwo, wdrożenie, rozwój i chmura" description="Konsultanci WiseB2B z zapleczem Sente prowadzą Cię od planu sprzedaży online przez sprint analityczny i wdrożenie po rozwój platformy w chmurze." service={{ name: "Wsparcie platformy Commerce B2B WiseB2B", serviceType: "Wsparcie SaaS", description: "Doradztwo, wdrożenie, utrzymanie i rozwój platformy Commerce B2B WiseB2B dla dystrybutorów i producentów." }}>

<div class="supports-logos">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 offset-lg-2">
        <span class="page-hero__badge lm-observer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
          Zespół
        </span>
        <h1 class="h2_semi lm-observer">Działamy razem, <span>na dłuższą metę</span></h1>
      </div>
    </div>
    <div class="row">
      <div class="col-lg-6 offset-lg-3 col-xl-6 offset-xl-3">
        <p class="p_regular_2 description lm-observer">WiseB2B to nie tylko w&nbsp;pełni funkcjonalne narzędzie, ale również zespół konsultantów, który zapewni Ci wielowymiarowe wsparcie na każdym etapie cyfrowej transformacji sprzedaży w&nbsp;Twojej firmie.</p>
        <a href="/zamow-demo/" class="wise-button wise-button--wise-harvest lm-observer">Zamów demo</a>
      </div>
    </div>
  </div>
</div>

<!-- S1. CZTERY FILARY WSPARCIA -->
<section class="zespol-pillars">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <div class="boxes boxes--flat">
          <div class="box lm-observer">
            <div class="box__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
            </div>
            <div class="box__content">
              <p class="p_semi_2 box__content-header">Doradztwo</p>
              <p class="p_regular_3 box__content-description">Otrzymasz wsparcie konsultantów z&nbsp;ponad 25-letnim doświadczeniem w&nbsp;pracy z&nbsp;firmami B2B.</p>
            </div>
          </div>
          <div class="box lm-observer">
            <div class="box__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.66 5.66L3 18v3h3l6.04-6.04a4 4 0 0 0 5.66-5.66l-2.83 2.83-2.12-2.12 2.83-2.83z"/></svg>
            </div>
            <div class="box__content">
              <p class="p_semi_2 box__content-header">Wdrożenie</p>
              <p class="p_regular_3 box__content-description">Prace wdrożeniowe płynnie doprowadzą do skutecznego uruchomienia. Zaczynamy od sprintu analitycznego, który trwa 1&ndash;4 tygodnie.</p>
            </div>
          </div>
          <div class="box lm-observer">
            <div class="box__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>
            </div>
            <div class="box__content">
              <p class="p_semi_2 box__content-header">Utrzymanie i&nbsp;rozwój</p>
              <p class="p_regular_3 box__content-description">Wspólnie ustalimy najlepsze podejście do rozwoju platformy B2B w&nbsp;Twojej firmie.</p>
            </div>
          </div>
          <div class="box lm-observer">
            <div class="box__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="6" rx="1.5"/><rect x="3" y="15" width="18" height="6" rx="1.5"/><circle cx="7" cy="6" r="0.8" fill="currentColor" stroke="none"/><circle cx="7" cy="18" r="0.8" fill="currentColor" stroke="none"/></svg>
            </div>
            <div class="box__content">
              <p class="p_semi_2 box__content-header">Infrastruktura</p>
              <p class="p_regular_3 box__content-description">Zadbamy o&nbsp;to, aby infrastruktura platformy była optymalnie dobrana do potrzeb Twojego biznesu.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="supports-numbers">
  <div class="container">

    <div class="team-process__block lm-observer">
      <div class="team-process__head">
        <span class="team-process__num">01</span>
        <h2 class="team-process__title">Doradztwo</h2>
        <p class="team-process__subtitle">Zbuduj plan cyfrowej transformacji sprzedaży razem z&nbsp;nami</p>
      </div>
      <div class="team-process__grid team-process__grid--3">
        <div class="team-process__card">
          <span class="team-process__card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2"/><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M3 13h18M9 13v2a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-2"/></svg>
          </span>
          <h3 class="p_semi_1 team-process__card-title">Zacznij skutecznie sprzedawać w&nbsp;kanale cyfrowym</h3>
          <p class="p_regular_3 team-process__card-desc">Twoja firma sprzedaje w&nbsp;modelu tradycyjnym lub masz za sobą średnio udane próby wdrażania cyfrowej sprzedaży? A&nbsp;może masz już sklep B2B, ale przechodzi przez niego kilkanaście procent sprzedaży, a&nbsp;resztę handlowcy przepisują z&nbsp;maili i&nbsp;telefonów? Zastanawiasz się, jak podejść do organizacji obszaru sprzedaży, aby skutecznie przenieść większość transakcji do kanału online?</p>
        </div>
        <div class="team-process__card">
          <span class="team-process__card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
          </span>
          <h3 class="p_semi_1 team-process__card-title">Zaplanuj transformację i&nbsp;określ jej cele</h3>
          <p class="p_regular_3 team-process__card-desc">Skorzystaj z&nbsp;doświadczenia konsultantów WiseB2B i&nbsp;zbuduj razem z&nbsp;nami plan transformacji Twojej sprzedaży. Wspólnie określimy najważniejsze cele biznesowe zmian i&nbsp;pomożemy ustalić sposób ich realizacji. Jeśli jakiś pomysł nie służy tym celom, powiemy Ci o&nbsp;tym otwarcie.</p>
        </div>
        <div class="team-process__card">
          <span class="team-process__card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.66 5.66L3 18v3h3l6.04-6.04a4 4 0 0 0 5.66-5.66l-2.83 2.83-2.12-2.12 2.83-2.83z"/></svg>
          </span>
          <h3 class="p_semi_1 team-process__card-title">Wykorzystaj sprawdzone narzędzie</h3>
          <p class="p_regular_3 team-process__card-desc">Mając plan i&nbsp;cele transformacji, możesz przejść do faktycznego wdrożenia jej w&nbsp;życie. W&nbsp;tym celu będziesz potrzebować narzędzia, które elastycznie dostosuje się do potrzeb biznesowych Twojej firmy i&nbsp;zapewni Twoim klientom doświadczenia zakupowe w&nbsp;jakości co najmniej tak dobrej, jaką znają z&nbsp;bezpośrednich kontaktów z&nbsp;handlowcami, ale dostępne o&nbsp;każdej porze z&nbsp;każdego miejsca. Ceny, warunki handlowe i&nbsp;historia zamówień pochodzą z&nbsp;Twojego ERP, a&nbsp;handlowiec widzi w&nbsp;<a href="/panel-handlowca/">Panelu Handlowca</a> to samo co klient. Właśnie takiej jakości możesz się spodziewać, korzystając z&nbsp;WiseB2B.</p>
        </div>
      </div>
    </div>

    <div class="team-process__block lm-observer">
      <div class="team-process__panel">
        <div class="team-process__panel-media">
          <img loading="lazy" width="640" height="480" src="/images/business-coworkers-shaking-hands-1536x1024.jpg" alt="Wdrożenie platformy B2B" />
        </div>
        <div class="team-process__panel-text">
          <span class="team-process__num team-process__num--left">02</span>
          <h2 class="team-process__title team-process__title--left">Wdrożenie &amp; uruchomienie</h2>
          <p class="team-process__subtitle team-process__subtitle--left">Sprawnie wprowadź nowy kanał cyfrowej sprzedaży dla swoich klientów</p>
          <p class="p_regular_1 team-process__panel-desc">Sam fakt uruchomienia e-sklepu nie jest jednoznaczny z&nbsp;tym, że Twoi klienci będą chcieli z&nbsp;niego korzystać. Skuteczne wdrożenie kanału eCommerce B2B wymaga uważnego zaplanowania ścieżki zakupowej, która przewyższy doświadczenia z&nbsp;tradycyjnego modelu sprzedaży. Doświadczenie zakupowe Twojego klienta to jeden z&nbsp;najważniejszych aspektów skutecznego wdrożenia cyfrowej sprzedaży w&nbsp;B2B. Pomożemy Ci tak zaplanować wdrożenie WiseB2B, aby nowe narzędzie stało się naturalnym i&nbsp;intuicyjnym miejscem zakupów dla Twojego klienta.</p>
          <p class="p_regular_1 team-process__panel-desc">Zaczynamy od sprintu analitycznego (1&ndash;4 tygodnie). Po nim znasz zakres, czas i&nbsp;budżet projektu. Samo wdrożenie trwa zwykle 2&ndash;6 miesięcy. Projekt prowadzi zespół WiseB2B albo wybrany przez Ciebie <a href="/partnerzy-wdrozeniowi/">partner wdrożeniowy</a>, a&nbsp;w&nbsp;drugiej linii wspiera nas Sente, dostawca oprogramowania dla handlu od 25 lat, z&nbsp;ponad 120 projektami dla średnich i&nbsp;dużych firm. Jeśli przechodzisz z&nbsp;innej platformy, stary system działa równolegle do pełnego przejścia.</p>
        </div>
      </div>
    </div>

    <div class="team-process__cta lm-observer">
      <img loading="lazy" width="1200" height="480" src="/images/lg-screen-office-view.png" class="team-process__cta-bg" alt="Platforma WiseB2B na dużym ekranie w biurze" />
      <div class="team-process__cta-overlay"></div>
      <div class="team-process__cta-content">
        <h3 class="h3_semi">Sprzedawaj więcej w&nbsp;B2B</h3>
        <p class="p_regular_2">Zautomatyzuj składanie zamówień przez klientów i&nbsp;zwiększ wydajność swojego działu handlowego.</p>
        <a class="p_semi_2 wise-button wise-button--wise-harvest" href="/zamow-demo/">Zamów demo</a>
      </div>
    </div>

    <div class="team-process__block lm-observer">
      <div class="team-process__head">
        <span class="team-process__num">03</span>
        <h2 class="team-process__title">Utrzymanie &amp; rozwój</h2>
        <p class="team-process__subtitle">Rozwijaj swoją ofertę i&nbsp;poprawiaj doświadczenia zakupowe swoich klientów</p>
      </div>
      <div class="team-process__grid team-process__grid--2">
        <div class="team-process__card">
          <span class="team-process__card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="9" width="16" height="10" rx="2"/><path d="M9 9V7a3 3 0 0 1 6 0v2"/><circle cx="9" cy="14" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="14" r="1" fill="currentColor" stroke="none"/></svg>
          </span>
          <h3 class="p_semi_1 team-process__card-title">Dostosuj się do dynamiki otoczenia biznesowego</h3>
          <p class="p_regular_3 team-process__card-desc">Otoczenie biznesowe Twojej firmy zmienia się w&nbsp;mgnieniu oka, tak samo jak oczekiwania klientów. Dlatego praca nad doskonaleniem procesów związanych z&nbsp;cyfrową sprzedażą musi odbywać się w&nbsp;trybie ciągłym. Zmiany przepisów, takich jak GPSR, RODO czy Omnibus, wprowadzamy w&nbsp;platformie po naszej stronie.</p>
        </div>
        <div class="team-process__card">
          <span class="team-process__card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l5-5 4 4 8-8"/><path d="M14 8h6v6"/></svg>
          </span>
          <h3 class="p_semi_1 team-process__card-title">Rozwijaj WiseB2B zgodnie z&nbsp;tym, jak rozwija się Twój biznes</h3>
          <p class="p_regular_3 team-process__card-desc">WiseB2B to platforma otwarta na rozbudowywanie i&nbsp;rozszerzanie o&nbsp;nowe rozwiązania. Nasz zespół konsultantów zapewni Ci wsparcie w&nbsp;identyfikowaniu obszarów do rozwoju lub usprawnienia oraz opracowywaniu i&nbsp;wdrażaniu odpowiednich funkcji. Nowe funkcje powstają jako wtyczki, więc aktualizacje platformy ich nie psują. Z&nbsp;dostępem do kodu źródłowego rozwój możesz też powierzyć własnemu zespołowi IT albo <a href="/partnerzy-wdrozeniowi/">partnerowi wdrożeniowemu</a>.</p>
        </div>
      </div>
    </div>

    <div class="team-process__block lm-observer">
      <div class="team-process__panel">
        <div class="team-process__panel-media">
          <img loading="lazy" width="640" height="480" src="/images/people-gac9f90525_640.jpg" alt="Infrastruktura platformy B2B" />
        </div>
        <div class="team-process__panel-text">
          <span class="team-process__num team-process__num--left">04</span>
          <h2 class="team-process__title team-process__title--left">Infrastruktura</h2>
          <p class="p_regular_1 team-process__panel-desc">WiseB2B to rozwiązanie, z&nbsp;którego możesz korzystać w&nbsp;modelu WiseB2B Cloud. Platforma jest utrzymywana w&nbsp;chmurze, dzięki czemu nie musisz przejmować się serwerami: zadbamy o&nbsp;to, aby rozwiązanie było odpowiednio utrzymywane i&nbsp;monitorowane. W&nbsp;każdym planie masz hosting, aktualizacje, monitoring 24/7 i&nbsp;kopie zapasowe, a&nbsp;w&nbsp;planach Professional i&nbsp;Enterprise także środowisko testowe i&nbsp;n8n do automatyzacji integracji. Wolisz własne serwery? W&nbsp;Professional i&nbsp;Enterprise WiseB2B działa również OnPremise. Parametry utrzymania, w&nbsp;tym czasy reakcji, określa umowa.</p>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- S7. KONTAKT -->
<section class="call-expert">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <div class="call-expert__wrapper zespol-expert lm-observer">
          <h2 class="h2_semi">Potrzebujesz szczegółowych informacji?</h2>
          <p class="p_regular_2 zespol-expert__text">Porozmawiaj z&nbsp;nami</p>
          <p class="name h5_regular">Jakub Czyżkowski</p>
          <p class="job p_regular_2">CEO</p>
          <div class="call-expert__button">
            <a class="wise-button wise-button--wise-harvest" href="/zamow-demo/">Porozmawiaj</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- S8. NEWSLETTER -->
<CtaBlock />

</BaseLayout>
