<div id="price-functions" class="price-functions plany-modules">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1">
        <h3 class="h3_semi lm-observer" style="margin-bottom: 24px;">Wszystkie moduły w 13 obszarach</h3>
        <div class="plan-legend lm-observer">
          <span class="legend-item"><span class="legend-icon legend-icon--included"></span> W pakiecie</span>
          <span class="legend-item"><span class="legend-icon legend-icon--optional"></span> Opcja dodatkowa</span>
          <span class="legend-item"><span class="legend-icon legend-icon--unavailable"></span> Niedostępny</span>
        </div>
        <div class="price-functions__action link_regular lm-observer">
          <span class="hide">Zwiń wszystkie</span>
          <span class="show">Rozwiń wszystkie</span>
        </div>

        <div class="elements">

          {obszary.map((obszar, i) => (
          <div class={`element lm-observer ${i === 0 ? 'show' : ''}`}>
            <h5 class="h5_semi">
              {obszar.data.title}
              <svg width="25" height="15" viewBox="0 0 25 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M23 13.5L12.5 3L2 13.5" stroke="#A5A5AF" stroke-width="3"/>
              </svg>
            </h5>
            <div class="js_element">
              <div class="modules-table">
                <div class="modules-table__header">
                  <div class="modules-table__col modules-table__col--name">Moduł</div>
                  <div class="modules-table__col modules-table__col--plan">Start</div>
                  <div class="modules-table__col modules-table__col--plan">Profes&shy;sional</div>
                  <div class="modules-table__col modules-table__col--plan">Enter&shy;prise</div>
                </div>
                {obszar.data.modules.map((mod) => (
                <div class="modules-table__row">
                  <div class="modules-table__col modules-table__col--name">
                    <strong>{mod.name}</strong>
                    <span class="modules-table__desc">{mod.description}</span>
                  </div>
                  <div class="modules-table__col modules-table__col--plan"><span class={`plan-icon plan-icon--${mod.starter}`} title={mod.starter === 'included' ? 'W pakiecie' : mod.starter === 'optional' ? 'Opcja dodatkowa' : 'Niedostępny'}></span></div>
                  <div class="modules-table__col modules-table__col--plan"><span class={`plan-icon plan-icon--${mod.professional}`} title={mod.professional === 'included' ? 'W pakiecie' : mod.professional === 'optional' ? 'Opcja dodatkowa' : 'Niedostępny'}></span></div>
                  <div class="modules-table__col modules-table__col--plan"><span class={`plan-icon plan-icon--${mod.enterprise}`} title={mod.enterprise === 'included' ? 'W pakiecie' : mod.enterprise === 'optional' ? 'Opcja dodatkowa' : 'Niedostępny'}></span></div>
                </div>
                ))}
              </div>
            </div>
          </div>
          ))}

        </div>
      </div>
    </div>
  </div>
</div>

<!-- PLAN -->
<section class="hp-plan">
  <div class="container">
    <h2 class="hp-section-title lm-observer">Od rozmowy do wyceny</h2>
    <ol class="hp-plan__steps">
      <li class="hp-plan__step lm-observer">
        <span class="hp-plan__num">1</span>
        <h3>Pokaz na Twoich przykładach</h3>
        <p>60 minut z konsultantem. Platforma na żywo, na scenariuszach z Twojej firmy.</p>
      </li>
      <li class="hp-plan__step lm-observer">
        <span class="hp-plan__num">2</span>
        <h3>Sprint analityczny</h3>
        <p>Od 1 do 4 tygodni. Na koniec wiesz, co wdrażamy, ile to kosztuje i kiedy ruszamy.</p>
      </li>
      <li class="hp-plan__step lm-observer">
        <span class="hp-plan__num">3</span>
        <h3>Uruchomienie obok obecnego procesu</h3>
        <p>Klienci przechodzą na platformę stopniowo. Stary system działa do końca przejścia.</p>
      </li>
    </ol>
    <p class="hp-plan__terms lm-observer">Abonament bez prowizji od obrotu. Koszt wdrożenia rozłożony w subskrypcji.</p>
    <div class="hp-plan__cta">
      <a href="/zamow-demo/" class="btn btn--primary">Zamów demo</a>
    </div>
  </div>
</section>

