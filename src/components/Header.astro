<script is:inline>
// Desktop: dropdown hover
document.querySelectorAll('.has-dropdown > a').forEach(function(link) {
  link.addEventListener('click', function(e) {
    if (window.innerWidth > 1279) {
      e.preventDefault();
    } else {
      e.preventDefault();
      var li = this.parentElement;
      var isOpen = li.classList.contains('dropdown-open');
      document.querySelectorAll('.has-dropdown.dropdown-open').forEach(function(l) {
        l.classList.remove('dropdown-open');
      });
      if (!isOpen) {
        li.classList.add('dropdown-open');
      }
    }
  });

  var li = link.parentElement;
  li.addEventListener('mouseenter', function() {
    if (window.innerWidth > 1279) {
      document.querySelectorAll('.has-dropdown.dropdown-open').forEach(function(l) {
        l.classList.remove('dropdown-open');
      });
      this.classList.add('dropdown-open');
    }
  });
  li.addEventListener('mouseleave', function() {
    if (window.innerWidth > 1279) {
      this.classList.remove('dropdown-open');
    }
  });
});

// Sticky header
var header = document.getElementById('header');
window.addEventListener('scroll', function() {
  if (window.scrollY > 50) {
    header?.classList.add('header--sticky');
  } else {
    header?.classList.remove('header--sticky');
  }
});

// Mobile menu
var hamburger = document.querySelector('.js-mobile-menu-hamburger');
hamburger?.addEventListener('click', function() {
  this.classList.toggle('active');
  document.querySelector('.header')?.classList.toggle('menu-mobile-open');
  document.body.classList.toggle('no-scroll');
  if (!this.classList.contains('active')) {
    document.querySelectorAll('.has-dropdown.dropdown-open').forEach(function(li) {
      li.classList.remove('dropdown-open');
    });
  }
});
</script>
