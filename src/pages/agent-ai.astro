---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';
---

<BaseLayout title="Agent AI: zamówienie z maila w gotowym koszyku" description="Agent AI WiseB2B zamienia zamówienie z maila, PDF lub Excela w koszyk na cenach z ERP. Agent administratora robi operacje masowe. Zobacz, jak odciąża BOK.">

<!-- Sekcja 1: Hero -->
<div class="agent-ai-hero">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
        <div class="agent-ai-hero__content lm-observer">
          <span class="page-hero__badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 5.4L19 9l-5.2 1.6L12 16l-1.8-5.4L5 9l5.2-1.6L12 2zM19 14l.9 2.7L22.5 17l-2.6.8L19 20.5l-.9-2.7-2.6-.8 2.6-.8.9-2.7zM5 15l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7.7-2z"/></svg>
            Agent AI
          </span>
          <h1 class="h1_semi">Zamówienie z&nbsp;maila trafia do koszyka bez przepisywania</h1>
          <p class="p_regular_1">Klient wkleja listę z&nbsp;maila, PDF lub Excela. Agent AI rozpoznaje indeksy, bierze ceny i&nbsp;stany z&nbsp;Twojego ERP i&nbsp;składa gotowy koszyk. Klient sprawdza go i&nbsp;zamawia, a&nbsp;Twój BOK zajmuje się sprawami, które wymagają człowieka.</p>
          <a class="wise-button wise-button--wise-harvest" href="/zamow-demo/">Zamów demo</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Sekcja 2: Film YouTube -->
<div class="agent-ai-video">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
        <div class="agent-ai-video__wrapper lm-observer">
          <div class="agent-ai-video__embed" id="yt-player-wrapper">
            <img
              src="https://img.youtube.com/vi/-l65_JZ0HVg/maxresdefault.jpg"
              alt="Agent AI WiseB2B, prezentacja wideo"
              class="agent-ai-video__poster"
              id="yt-poster"
              loading="lazy"
            />
            <div class="agent-ai-video__play-btn" id="yt-play-btn">
              <svg width="68" height="68" viewBox="0 0 68 68" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="34" cy="34" r="34" fill="rgba(0,0,0,0.6)"/>
                <polygon points="27,20 27,48 50,34" fill="#fff"/>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Sekcja 3: Stawka -->
<section class="hp-stakes">
  <div class="container">
    <h2 class="hp-stakes__title lm-observer">Ile zamówień Twój BOK przepisuje dziś ręcznie?</h2>
    <p class="hp-stakes__text lm-observer">Klient przysyła listę w&nbsp;mailu, z&nbsp;nazwą produktu zamiast indeksu. Ktoś szuka pozycji w&nbsp;katalogu, sprawdza stan, dzwoni dopytać. Z&nbsp;każdym nowym klientem tej pracy przybywa.</p>
  </div>
</section>

<!-- Sekcja 4: Scenariusze -->
<div class="agent-ai-usecases">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
        <h2 class="h2_semi agent-ai-usecases__heading lm-observer">Co Agent AI robi za Twój zespół</h2>

        <!-- Scenariusz 1: Email-2-Cart -->
        <div class="agent-ai-usecase lm-observer">
          <div class="agent-ai-usecase__text">
            <span class="team-process__card-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            </span>
            <h3 class="h3_semi">Email-2-Cart: zamówienie z&nbsp;maila, PDF lub Excela</h3>
            <p class="p_regular_3">Klient wkleja treść maila albo dołącza plik. Agent odczytuje pozycje i&nbsp;dopasowuje je do indeksów z&nbsp;Twojego katalogu, także gdy nazwa jest z&nbsp;błędem. Koszyk powstaje na cenach i&nbsp;warunkach tego klienta. Nikt w&nbsp;firmie nie wpisuje zamówienia ręcznie.</p>
          </div>
          <div class="agent-ai-usecase__visual">
            <img class="agent-ai-mockup-img" src="/images/agent-ai-email-to-cart.png" alt="Email-2-Cart: mail z zamówieniem i koszyk przygotowany przez Agenta AI" loading="lazy" />
          </div>
        </div>

        <!-- Scenariusz 2: Kompletacja z doradztwem -->
        <div class="agent-ai-usecase agent-ai-usecase--reverse lm-observer">
          <div class="agent-ai-usecase__text">
            <span class="team-process__card-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4" fill="currentColor" stroke="none"/><circle cx="17" cy="20" r="1.4" fill="currentColor" stroke="none"/><path d="M2 3h2l2.4 12.2a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21 7H6"/></svg>
            </span>
            <h3 class="h3_semi">Kompletacja zamówienia z&nbsp;doradztwem</h3>
            <p class="p_regular_3">Klient opisuje, czego szuka, np. „tylko akumulatorowe” albo „zestaw od jednego producenta”. Agent wyszukuje pasujące produkty i&nbsp;pokazuje je w&nbsp;tabeli do porównania. Wybrane pozycje dodaje do koszyka na prośbę klienta.</p>
          </div>
          <div class="agent-ai-usecase__visual">
            <img class="agent-ai-mockup-img" src="/images/agent-ai-mockup-02.png" alt="Agent AI: wyszukiwanie produktów według opisu klienta i tabela do porównania" loading="lazy" />
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- Sekcja 5: AI po stronie administratora -->
<div class="agent-ai-features">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
        <h2 class="h2_semi agent-ai-features__heading lm-observer">AI pracuje też dla Twojego zespołu</h2>
        <p class="p_regular_1 agent-ai-features__subheading lm-observer">Agent klienta obsługuje zakupy. Po drugiej stronie AI zdejmuje z&nbsp;administratora i&nbsp;działu produktu powtarzalną pracę przy cennikach i&nbsp;katalogu.</p>
        <div class="agent-ai-features__grid">

          <div class="agent-ai-feature-card lm-observer">
            <div class="agent-ai-feature-card__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1.08-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1.08 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            </div>
            <h3 class="p_semi_2">Agent administratora</h3>
            <p class="p_regular_3">Operacje masowe zlecasz zdaniem: zmiana cennika dla grupy produktów, nowa promocja, porządki w&nbsp;kategoriach. Agent wykonuje je w&nbsp;panelu administracyjnym platformy.</p>
          </div>

          <div class="agent-ai-feature-card lm-observer">
            <div class="agent-ai-feature-card__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/><path d="M8 4v5"/></svg>
            </div>
            <h3 class="p_semi_2">Opisy produktów i&nbsp;SEO</h3>
            <p class="p_regular_3">Dla każdego pola w&nbsp;systemie ustawiasz schemat, według którego AI generuje treść: opis, tytuł, meta opis.</p>
          </div>

          <div class="agent-ai-feature-card lm-observer">
            <div class="agent-ai-feature-card__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h8M8 3v2M5 9c1.5 3 4 5 7 6M11 5c-1 4-3.5 7-7 9"/><path d="M13 21l4-9 4 9M14.5 18h5"/></svg>
            </div>
            <h3 class="p_semi_2">Tłumaczenia katalogu</h3>
            <p class="p_regular_3">Gdy sprzedajesz za granicę, AI przygotowuje wersje językowe opisów, a&nbsp;Ty sprawdzasz je przed publikacją.</p>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<!-- Sekcja 6: Jak działa Agent AI -->
<div class="agent-ai-why">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
        <h2 class="h2_semi agent-ai-why__heading lm-observer">Jak Agent AI działa w&nbsp;Twoim sklepie</h2>
        <div class="agent-ai-why__table lm-observer">

          <div class="agent-ai-why__row">
            <div class="agent-ai-why__cell agent-ai-why__cell--feature">
              <p class="p_semi_2">Robi to, co klient w&nbsp;sklepie</p>
            </div>
            <div class="agent-ai-why__cell agent-ai-why__cell--benefit">
              <p class="p_regular_3">Dodaje produkty do koszyka, porównuje je, korzysta z&nbsp;list zakupowych, finalizuje zamówienie i&nbsp;sprawdza status realizacji. Klient pisze, czego potrzebuje, a&nbsp;agent wykonuje kolejne kroki.</p>
            </div>
          </div>

          <div class="agent-ai-why__row">
            <div class="agent-ai-why__cell agent-ai-why__cell--feature">
              <p class="p_semi_2">Pracuje na Twoich danych</p>
            </div>
            <div class="agent-ai-why__cell agent-ai-why__cell--benefit">
              <p class="p_regular_3">Agent jest modułem platformy WiseB2B. Widzi cennik indywidualny klienta, stany magazynowe i&nbsp;warunki handlowe z&nbsp;ERP, te same co w&nbsp;sklepie i&nbsp;w&nbsp;Panelu Handlowca.</p>
            </div>
          </div>

          <div class="agent-ai-why__row">
            <div class="agent-ai-why__cell agent-ai-why__cell--feature">
              <p class="p_semi_2">Ma uprawnienia użytkownika</p>
            </div>
            <div class="agent-ai-why__cell agent-ai-why__cell--benefit">
              <p class="p_regular_3">Agent korzysta z&nbsp;tych samych metod co interfejs aplikacji. Ma dostęp tylko do danych i&nbsp;operacji, które może wykonać zalogowany użytkownik.</p>
            </div>
          </div>

          <div class="agent-ai-why__row">
            <div class="agent-ai-why__cell agent-ai-why__cell--feature">
              <p class="p_semi_2">Jest wbudowany w&nbsp;interfejs</p>
            </div>
            <div class="agent-ai-why__cell agent-ai-why__cell--benefit">
              <p class="p_regular_3">Klient otwiera agenta przyciskiem „Zapytaj AI” obok wyszukiwarki. Może z&nbsp;nim pracować w&nbsp;oknie, w&nbsp;panelu bocznym albo na pełnym ekranie.</p>
            </div>
          </div>

          <div class="agent-ai-why__row">
            <div class="agent-ai-why__cell agent-ai-why__cell--feature">
              <p class="p_semi_2">Dostępność w&nbsp;planach</p>
            </div>
            <div class="agent-ai-why__cell agent-ai-why__cell--benefit">
              <p class="p_regular_3">Agent AI klienta jest w&nbsp;planie Enterprise, a&nbsp;w&nbsp;Professional możesz go dodać jako opcję. Agenta administratora i&nbsp;generowanie treści przez AI dołączasz do każdego planu. <a href="/plany-wiseb2b/">Zobacz plany</a></p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<!-- Sekcja 7: Dowód VMP + demo -->
<div class="agent-ai-showcase">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
        <div class="agent-ai-showcase__grid lm-observer">
          <div class="agent-ai-showcase__visual">
            <img class="agent-ai-mockup-img" src="/images/agent-ai-01.png" alt="Agent AI WiseB2B, widok w sklepie B2B" loading="lazy" />
          </div>
          <div class="agent-ai-showcase__text">
            <div class="agent-ai-showcase__block">
              <img src="/images/logo-vmp.jpg" alt="VMP" width="140" height="50" class="hp-proof__logo" loading="lazy" />
              <h2 class="h2_semi">Mniej pracy w&nbsp;BOK u&nbsp;<span class="agent-ai-showcase__accent">VMP</span></h2>
              <p class="p_regular_2">Hurtownia bielizny z&nbsp;86 000 indeksów sprzedaje do sklepów w&nbsp;krajach UE. Po przejściu na WiseB2B klienci sami składają zamówienia i&nbsp;sprawdzają ich status.</p>
              {/* NEED: liczby VMP dotyczą całej platformy (samoobsługa + automatyzacja). Brak pomiaru samego Agenta AI. Gdy będzie, podmienić lub dodać. */}
              <div class="hp-proof__stats">
                <div><span class="hp-proof__value">−45%</span><span class="hp-proof__label">zapytań do BOK</span></div>
                <div><span class="hp-proof__value">−60%</span><span class="hp-proof__label">czasu obsługi zamówienia</span></div>
              </div>
              <a href="/case-study/vmp/" class="hp-why__link">Zobacz case study VMP</a>
            </div>
            <div class="agent-ai-showcase__block">
              <h2 class="h2_semi">Sprawdź agenta na demo</h2>
              <p class="p_regular_2">Na środowisku demo możesz sam zadać agentowi pytanie, wkleić listę produktów i&nbsp;zobaczyć gotowy koszyk.</p>
              <a class="wise-button wise-button--wise-harvest" href="https://demo.wiseb2b.eu" target="_blank" rel="noopener noreferrer">Przejdź do demo</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Sekcja 8: Następny krok -->
<section class="hp-plan">
  <div class="container">
    <h2 class="hp-section-title lm-observer">Jak zaczynamy</h2>
    <ol class="hp-plan__steps">
      <li class="hp-plan__step lm-observer">
        <span class="hp-plan__num">1</span>
        <h3>Pokaz na Twoich przykładach</h3>
        <p>30 minut z&nbsp;konsultantem. Przynieś prawdziwy mail z&nbsp;zamówieniem, a&nbsp;agent zamieni go w&nbsp;koszyk na żywo.</p>
      </li>
      <li class="hp-plan__step lm-observer">
        <span class="hp-plan__num">2</span>
        <h3>Sprint analityczny</h3>
        <p>Od 1 do 4 tygodni. Na koniec wiesz, co wdrażamy, ile to kosztuje i&nbsp;kiedy ruszamy.</p>
      </li>
      <li class="hp-plan__step lm-observer">
        <span class="hp-plan__num">3</span>
        <h3>Uruchomienie obok obecnego procesu</h3>
        <p>Klienci przechodzą na platformę stopniowo. Stary system działa do końca przejścia.</p>
      </li>
    </ol>
    <div class="hp-plan__cta">
      <a href="/zamow-demo/" class="btn btn--primary">Zamów demo</a>
    </div>
  </div>
</section>

<CtaBlock />

<!-- Lightbox -->
<div class="agent-ai-lightbox" id="agent-ai-lightbox">
  <img class="agent-ai-lightbox__img" id="agent-ai-lightbox-img" src="" alt="" />
</div>

<script is:inline>
// Lightbox for mockup images
(function() {
  var lightbox = document.getElementById('agent-ai-lightbox');
  var lightboxImg = document.getElementById('agent-ai-lightbox-img');

  document.querySelectorAll('.agent-ai-mockup-img').forEach(function(img) {
    img.addEventListener('click', function() {
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightbox.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    });
  });

  lightbox.addEventListener('click', function() {
    lightbox.classList.remove('is-active');
    document.body.style.overflow = '';
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && lightbox.classList.contains('is-active')) {
      lightbox.classList.remove('is-active');
      document.body.style.overflow = '';
    }
  });
})();
</script>

<script is:inline>
// YouTube lazy-load on hover/click
(function() {
  var wrapper = document.getElementById('yt-player-wrapper');
  var poster = document.getElementById('yt-poster');
  var playBtn = document.getElementById('yt-play-btn');
  var loaded = false;

  function loadVideo() {
    if (loaded) return;
    loaded = true;
    var iframe = document.createElement('iframe');
    iframe.setAttribute('src', 'https://www.youtube.com/embed/-l65_JZ0HVg?autoplay=1&rel=0');
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
    iframe.setAttribute('allowfullscreen', '');
    iframe.style.position = 'absolute';
    iframe.style.top = '0';
    iframe.style.left = '0';
    iframe.style.width = '100%';
    iframe.style.height = '100%';
    if (poster) poster.style.display = 'none';
    if (playBtn) playBtn.style.display = 'none';
    wrapper.appendChild(iframe);
  }

  if (wrapper) {
    wrapper.addEventListener('mouseenter', loadVideo);
    wrapper.addEventListener('click', loadVideo);
  }
})();
</script>

</BaseLayout>
