---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { getCollection } from 'astro:content';

const partners = (await getCollection('partnerzy')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout title="Partnerzy wdrożeniowi WiseB2B: Sente i Satisfly" description="Platformę WiseB2B wdrożysz sam, z naszym zespołem albo z partnerem. Poznaj Sente i Satisfly, partnerów wdrożeniowych WiseB2B.">

<!-- HERO -->
<div class="supports-logos">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 offset-lg-2">
        <span class="page-hero__badge lm-observer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
          Partnerzy
        </span>
        <h1 class="h2_semi lm-observer">Ty wybierasz, kto wdraża Twoją platformę</h1>
      </div>
    </div>
    <div class="row">
      <div class="col-lg-6 offset-lg-3">
        <p class="p_regular_2 description lm-observer">WiseB2B dostarcza technologię. Ty decydujesz, czy wdrażasz sam, z&nbsp;naszym zespołem, czy z&nbsp;partnerem wdrożeniowym. Dzięki dostępowi do kodu źródłowego platformę może dalej rozwijać każdy z&nbsp;nich. Nie jesteś skazany na jednego dostawcę.</p>
        <a href="/zamow-demo/" class="wise-button wise-button--wise-harvest lm-observer">Zamów demo</a>
      </div>
    </div>
  </div>
</div>

<!-- PARTNER GRID -->
<div class="articles-filter-categories" style="padding-bottom:80px;">
  <div class="container">
    <div class="row">
      <div class="col-lg-12 col-xl-10 offset-xl-1">
        <div class="box-posts partner-grid">
          {partners.map((partner) => (
            <div class="item">
              <div class="image partner-logo-box">
                <img loading="lazy" src={partner.data.logo} alt={partner.data.name} class="partner-logo-img" />
              </div>
              <div class="content">
                <p class="item_category p_regular_3">{partner.data.specialization.join(' · ')}</p>
                <h2 class="title p_semi_1">{partner.data.name}</h2>
                <p class="excerpt p_regular_3">{partner.data.shortDescription}</p>
                <a href={partner.data.website} target="_blank" rel="noopener" class="wise-button wise-button--dark partner-card__cta">Dowiedz się więcej</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<!-- DLACZEGO WARTO -->
<div class="partner-benefits">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 offset-lg-2" style="text-align:center;">
        <h2 class="h2_semi">Dla firm wdrożeniowych i&nbsp;agencji eCommerce</h2>
        <p class="subtitle">Co dostajesz jako partner WiseB2B</p>
      </div>
    </div>
    <div class="row">
      <div class="col-lg-10 offset-lg-1 col-xl-10 offset-xl-1 p-xl-0">
        <div class="boxes boxes--3col">
          <div class="box">
            <div class="box__icon partner-benefit-icon">
              <img width="31" height="31" src="/images/np_sale_3972942.png" class="attachment-logos size-logos" alt="Wartość dla klientów" />
            </div>
            <div class="box__content">
              <p class="p_semi_2 box__content-header">Platforma projektowana dla B2B</p>
              <p class="p_regular_3 box__content-description">Cenniki indywidualne, kredyt kupiecki, sub-konta i&nbsp;akceptacje zamówień działają od startu. Nie przerabiasz sklepu B2C na potrzeby hurtu.</p>
            </div>
          </div>
          <div class="box">
            <div class="box__icon partner-benefit-icon">
              <img width="31" height="31" src="/images/np_settings_746615.png" class="attachment-logos size-logos" alt="Lepsze rozwiązania" />
            </div>
            <div class="box__content">
              <p class="p_semi_2 box__content-header">Agenci AI i&nbsp;Panel Handlowca w&nbsp;standardzie</p>
              <p class="p_regular_3 box__content-description">Twój klient dostaje agentów AI, którzy zamieniają zamówienie z&nbsp;maila w&nbsp;koszyk, oraz Panel Handlowca na tych samych danych z&nbsp;ERP.</p>
            </div>
          </div>
          <div class="box">
            <div class="box__icon partner-benefit-icon">
              <img width="31" height="31" src="/images/np_function_1286758_000000-1.png" class="attachment-logos size-logos" alt="Otwarty kod" />
            </div>
            <div class="box__content">
              <p class="p_semi_2 box__content-header">Dostęp do kodu źródłowego</p>
              <p class="p_regular_3 box__content-description">Rozszerzenia piszesz jako wtyczki, więc aktualizacje platformy ich nie psują. Klient nie płaci prowizji od obrotu, co ułatwia rozmowę o&nbsp;kosztach.</p>
            </div>
          </div>
        </div>
        <div class="boxes boxes--3col" style="margin-top:20px;">
          <div class="box">
            <div class="box__icon partner-benefit-icon">
              <img width="31" height="31" src="/images/np_ecommerce_4557208_000000-1.png" class="attachment-logos size-logos" alt="Platforma demo" />
            </div>
            <div class="box__content">
              <p class="p_semi_2 box__content-header">Środowisko demo i&nbsp;szkolenia</p>
              <p class="p_regular_3 box__content-description">Dostajesz środowisko demonstracyjne, dokumentację techniczną i&nbsp;szkolenia z&nbsp;wdrażania i&nbsp;sprzedaży platformy.</p>
            </div>
          </div>
          <div class="box">
            <div class="box__icon partner-benefit-icon">
              <img width="31" height="31" src="/images/np_suitcase_4525556_000000-1.png" class="attachment-logos size-logos" alt="Wsparcie techniczne" />
            </div>
            <div class="box__content">
              <p class="p_semi_2 box__content-header">Wsparcie zespołu WiseB2B</p>
              <p class="p_regular_3 box__content-description">Pomagamy od prezentacji u&nbsp;klienta po uruchomienie platformy, technicznie i&nbsp;merytorycznie.</p>
            </div>
          </div>
          <div class="box">
            <div class="box__icon partner-benefit-icon">
              <img width="31" height="31" src="/images/np_operation_2998632_000000-1.png" class="attachment-logos size-logos" alt="Marketing" />
            </div>
            <div class="box__content">
              <p class="p_semi_2 box__content-header">Wspólne działania marketingowe</p>
              <p class="p_regular_3 box__content-description">Pokazujemy partnerów na stronie WiseB2B, w&nbsp;materiałach marketingowych i&nbsp;podczas wydarzeń branżowych.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- CTA -->
<section class="call-expert" style="margin-top:60px;">
  <div class="container">
    <div class="row">
      <div class="col-xl-8 offset-xl-2 col-lg-10 offset-lg-1">
        <div class="call-expert__wrapper">
          <h2 class="h2_semi">Chcesz zostać partnerem WiseB2B?</h2>
          <p class="p_regular_2" style="margin-top:12px;color:#dcdae0;">Wdrażasz eCommerce dla firm handlowych lub produkcyjnych? Napisz, jakie projekty prowadzisz. Opowiemy, jak wygląda współpraca. Kontakt: <a href="mailto:kontakt@wiseb2b.eu" style="color:#fff;">kontakt@wiseb2b.eu</a></p>
          {/* NEED: model współpracy partnerskiej (marża lub prowizja, wymagania, proces wejścia) i osobny formularz dla partnerów */}
          <div class="call-expert__button">
            <a class="wise-button wise-button--wise-harvest" href="/zamow-demo/">Skontaktuj się z nami</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<CtaBlock />
</BaseLayout>
