---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('baza-wiedzy'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);
---

<BaseLayout title="Wdrożenia WiseB2B: wyniki dystrybutorów w liczbach" description="Triplex, VMP i inni dystrybutorzy sprzedają na WiseB2B. Zobacz, ile zamówień przeszło do platformy B2B i ile czasu odzyskali handlowcy i BOK." service={{ name: "Wdrożenie platformy Commerce B2B WiseB2B", serviceType: "Wdrożenie oprogramowania B2B", description: "Wdrożenie platformy Commerce B2B dla dystrybutorów i producentów: sprint analityczny, integracja z ERP, uruchomienie obok obecnego procesu sprzedaży." }}>

<section class="demo-hero">
  <div class="container">
    <span class="demo-hero__badge">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M13 10h7l-9 13v-9H4l9-13v9z"/></svg>
      Wdrożenia
    </span>
    <h1 class="lm-observer">Ile sprzedaży przeszło do platformy B2B u naszych klientów</h1>
    <p class="demo-hero__lead lm-observer">Triplex, VMP i pozostali nasi klienci to dystrybutorzy, których klienci kupują od lat. Sprawdź, ile zamówień przeszło do samoobsługi i ile pracy zdjęliśmy z handlowców i BOK.</p>
    <div class="demo-hero__actions">
      <a href="/zamow-demo/" class="btn btn--primary">Zamów demo</a>
    </div>
  </div>
</section>

<!-- STAWKA -->
<section class="hp-stakes">
  <div class="container">
    <h2 class="hp-stakes__title lm-observer">Czy Twoi klienci w ogóle zechcą zamawiać online?</h2>
    <p class="hp-stakes__text lm-observer">Tego bał się Triplex. Ich klienci od lat zamawiali telefonem i w Excelu. Przez platformę przechodzi dziś prawie połowa ich obrotu.</p>
  </div>
</section>

<div class="implementation-lic">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1">

        <div class="items lm-observer">
          <div class="item">
            <div class="item__image">
              <img width="811" height="608" src="/case-study/triplex/browser-blender-4-811x608.png" class="attachment-functions-images-small size-functions-images-small" alt="Platforma B2B Triplex na WiseB2B" />
            </div>
            <div class="item__content">
              <img width="74" height="21" src="/images/triplex-logo.png" class="item__content-logo" alt="Logo Triplex" />
              <h2 class="h3_semi">Triplex, dystrybutor pirotechniki: 49,55% obrotu przez platformę B2B</h2>
              <p class="p_regular_3 description">Klienci Triplexa zamawiają sami, także po godzinach pracy biura, po cenach liczonych tak samo jak w Comarch Optima. Przez platformę przechodzi 46,36% zamówień, a korzysta z niej 34,43% klientów. Handlowcy mają mniej powtarzalnej pracy przy zamówieniach.</p>
              <a class="btn btn--dark" href="/case-study/triplex/">Przeczytaj case study</a>
            </div>
          </div>
          <div class="item item--reverse">
            <div class="item__image">
              <img width="1456" height="706" src="/case-study/vmp/vmp-homepage.png" class="attachment-functions-images-small size-functions-images-small" alt="Platforma B2B VMP na WiseB2B" />
            </div>
            <div class="item__content">
              <img width="74" height="21" src="/case-study/vmp/vmp-logo.png" class="item__content-logo" alt="Logo VMP Group" />
              <h2 class="h3_semi">VMP, hurtownia bielizny: obsługa zamówienia krótsza o 60%</h2>
              <p class="p_regular_3 description">VMP obsługuje 13 rynków zagranicznych i sprzedaje do sklepów z katalogu ponad 86 000 indeksów, a ponad 90% zamówień realizuje w dropshippingu. Po wdrożeniu zapytań do BOK jest o 45% mniej. Stary system B2B działał równolegle i został wyłączony po miesiącu.</p>
              <a class="btn btn--dark" href="/case-study/vmp/">Przeczytaj case study</a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- WIĘCEJ DOWODÓW -->
<section class="hp-case">
  <div class="container">
    <h2 class="hp-section-title lm-observer">Więcej wyników</h2>
    <p class="hp-section-subtitle lm-observer">Kolejne wdrożenia platformy i zespołu</p>

    <div class="hp-proof">
      <div class="hp-proof__card lm-observer">
        <span class="hp-proof__tag">Wdrożenie WiseB2B</span>
        <p class="hp-proof__desc">Dystrybutor części do maszyn rolniczych, 120 mln zł obrotu, 840 klientów na platformie. Przeszedł na WiseB2B z platformy SaaS. Dostawa wycenia się automatycznie, więc handlowiec nie musi sprawdzać każdego zamówienia.</p>
        <div class="hp-proof__stats">
          <div><span class="hp-proof__value">42%</span><span class="hp-proof__label">zamówień bez weryfikacji handlowca</span></div>
          <div><span class="hp-proof__value">+22%</span><span class="hp-proof__label">dostępności produktów dzięki sprzedaży z wielu magazynów</span></div>
        </div>

      </div>
      <div class="hp-proof__card lm-observer">
        <p class="hp-proof__desc"><strong>Wdrożenia zespołu WiseB2B i Sente.</strong> Te platformy B2B zespół zbudował razem z Sente dla dużych firm handlowych i produkcyjnych. Pokazują, z jaką skalą i złożonością warunków handlowych pracowaliśmy.</p>
        <div class="hp-proof__stats">
          <div><span class="hp-proof__value">1,6 mld zł</span><span class="hp-proof__label">obrotu dystrybutora spożywczego, sprzedaż w wielu walutach</span></div>
          <div><span class="hp-proof__value">80 mln zł</span><span class="hp-proof__label">obrotu producenta opakowań, B2B i B2C na jednej platformie, zgodność z Omnibus</span></div>
        </div>
        <p class="hp-proof__desc">W branży medycznej klienci składają zestawy produktów w konfiguratorze.</p>
      </div>
    </div>
  </div>
</section>

<!-- OPINIA -->
<section class="hp-testimonials">
  <div class="container">
    <h2 class="hp-section-title lm-observer">Opinia klienta</h2>
    <p class="hp-section-subtitle lm-observer">Triplex, dystrybutor pirotechniki</p>

    <div class="hp-testimonials__card lm-observer">
      <img src="/svg/double-quotes-r.svg" alt="" class="hp-testimonials__quote hp-testimonials__quote--right" width="80" height="80" />
      <blockquote>
        Jesteśmy w branży 30 lat, nasi klienci również &ndash; baliśmy się na początku, że klienci przyzwyczajeni do exceli i telefonu nie będą chcieli składać zamówień przez platformę B2B. Ale reakcje są inne &ndash; klienci są zachwyceni. Takie zmiany też dobrze wpływają na wizerunek branży i przyciągają młode pokolenie. Bardzo pozytywnie oceniam zmiany, jakie wniosła platforma B2B wdrożona przez Sente.
      </blockquote>
      <div class="hp-testimonials__author">
        <p class="hp-testimonials__author-name">Aneta Siwarga</p>
        <p class="hp-testimonials__author-site">Prokurent w Triplex</p>
      </div>
      <img src="/svg/double-quotes-l.svg" alt="" class="hp-testimonials__quote hp-testimonials__quote--left" width="80" height="80" />
    </div>
    {/* NEED: autoryzowany cytat osoby z VMP (imię, nazwisko, rola); dotychczasowy tekst „VMP Group” nie miał źródła i został usunięty */}
  </div>
</section>

<!-- DWIE ŚCIEŻKI -->
<section class="hp-paths">
  <div class="container">
    <h2 class="hp-section-title lm-observer">Która sytuacja jest bliższa Twojej?</h2>
    <p class="hp-section-subtitle lm-observer">VMP zmienił platformę. Triplex uruchamiał sprzedaż online obok handlowców.</p>
    <div class="hp-paths__grid">
      <div class="hp-paths__card lm-observer">
        <h3>Masz platformę B2B, która Cię ogranicza</h3>
        <p>Stary system działa do pełnego przejścia. W VMP trwało to miesiąc, bez utraty funkcji.</p>
        <a href="/bezpieczna-migracja/" class="btn btn--outline">Jak wygląda migracja</a>
      </div>
      <div class="hp-paths__card lm-observer">
        <h3>Sprzedajesz głównie przez handlowców</h3>
        <p>Kanał online rusza obok telefonu i maila. Klienci przechodzą na niego w swoim tempie, a handlowiec widzi w Panelu Handlowca, co zamówili sami.</p>
        <a href="/dla-dystrybutorow/" class="btn btn--outline">Dla dystrybutorów</a>
        <a href="/dla-producentow/" class="hp-why__link hp-paths__alt">Jesteś producentem?</a>
      </div>
    </div>
  </div>
</section>

<!-- FINAŁOWE CTA -->
<section class="hp-final">
  <div class="container">
    <div class="hp-final__card lm-observer">
      <h2>Zobacz, jak to wyglądałoby u Ciebie</h2>
      <p>60 minut z konsultantem, platforma na żywo, scenariusze z Twojej firmy.</p>
      <a href="/zamow-demo/" class="btn btn--light">Zamów demo</a>
    </div>
  </div>
</section>

<!-- BAZA WIEDZY -->
<section class="hp-blog">
  <div class="container">
    <h2 class="hp-section-title lm-observer">Mogą Cię zainteresować</h2>
    <p class="hp-section-subtitle lm-observer">Artykuły o eCommerce B2B i wdrożeniach platformy</p>

    <div class="hp-blog__grid">
      {articles.map((article) => (
        <a href={`/baza-wiedzy/${article.id}/`} class="hp-blog__card lm-observer">
          <div class="hp-blog__card-img">
            {article.data.image && <img src={article.data.image} alt={article.data.title} width="376" height="250" loading="lazy" />}
            <span class="hp-blog__card-cat">{article.data.category}</span>
          </div>
          <div class="hp-blog__card-body">
            <h3>{article.data.title}</h3>
          </div>
        </a>
      ))}
    </div>
    <div class="hp-blog__more">
      <a href="/baza-wiedzy/" class="btn btn--dark">Sprawdź więcej</a>
    </div>
  </div>
</section>

<CtaBlock />
</BaseLayout>
