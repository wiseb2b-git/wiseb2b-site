---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { getCollection } from 'astro:content';

// Tekst: .knowledge/teksty/dla-dystrybutorow.md (copy deck). Układ: Figma 68:124.
const allArticles = await getCollection('baza-wiedzy');
const articles = ['e-commerce-w-modelu-b2b', 'korzysci-z-wdrozenia-platformy-b2b', 'jak-wybrac-najlepsza-platforme-b2b', 'dedykowana-czy-gotowa-platforma-b2b-na-co-sie-zdecydowac']
  .map((id) => allArticles.find((a) => a.id === id))
  .filter((a) => a !== undefined);
const icon = (d: string) => `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const I = {
  tag: '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
  cart: '<circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M3 4h2l2.4 11h11.2L21 7H6.2"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  heart: '<path d="M12 21s-8-5.2-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 5.8-8 11-8 11z"/>',
  book: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5"/>',
  wallet: '<rect x="3" y="6" width="18" height="14" rx="2"/><path d="M3 10h18M16 15h2"/>',
  chart: '<path d="M4 20V10M10 20V4M16 20v-7M21 20H3"/>',
};

const faq = [
  { q: 'Czym charakteryzuje się platforma B2B dla dystrybutorów?', a: 'Platforma B2B dla dystrybutorów jest dostosowana do klientów z branży handlu i dystrybucji. Katalog produktowy skonstruowany jest tak, że nawet najbardziej złożone drzewa asortymentowe są prezentowane czytelnie. Rozbudowane mechanizmy filtrowania pozwalają odszukać dokładnie ten produkt, którego klient potrzebuje, nawet w branżach, gdzie warianty i wersje towarów liczone są w setkach (np. artykuły elektroniczne czy akcesoria automotive).' },
  { q: 'Co, jeśli moi klienci nie będą chcieli zamawiać online?', a: 'Nie muszą przechodzić od razu. Platforma działa obok telefonu i maila, a handlowiec widzi wszystkie zamówienia w jednym miejscu. W Triplex obawiano się tego samego. Dziś z platformy korzysta 34,43% klientów, a przez platformę przechodzi 46,36% wszystkich zamówień.' },
  { q: 'Mamy już platformę B2B. Czy przejście na WiseB2B jest bezpieczne?', a: 'Tak, bo stary system działa do chwili, w której przeniesiesz ostatniego klienta. Najpierw testujemy integrację z ERP, potem platformę dostaje grupa zaufanych klientów, nowi klienci rejestrują się już tylko w WiseB2B, a na końcu przenosisz resztę. Dystrybutor części do maszyn rolniczych (120 mln zł, 840 klientów) przeszedł tak z platformy SaaS działającej pod ERP Wa-PRO. Więcej na stronie <a href="/bezpieczna-migracja/">Bezpieczna migracja</a>.' },
  { q: 'Ile kosztuje wdrożenie platformy B2B dla dystrybutorów?', a: 'Na koszt wpływa skala działania firmy: liczba klientów, liczba produktów oraz specyficzne potrzeby funkcjonalne. To one decydują o wyborze planu: Start od 1 990 zł, Professional od 3 490 zł, Enterprise od 6 990 zł netto miesięcznie. Nie pobieramy opłat od obrotu, a koszt wdrożenia możesz rozłożyć w subskrypcji. Szczegóły na stronie <a href="/plany-wiseb2b/">Plany WiseB2B Cloud</a>.' },
  { q: 'Jak wygląda proces wdrożenia platformy B2B dla dystrybutorów?', a: 'Wdrożenie zaczyna się od sprintu analitycznego (od 1 do 4 tygodni), który pozwala zdefiniować cele projektu oraz zidentyfikować indywidualne potrzeby. Na jego koniec wiesz, co wdrażamy, ile to kosztuje i kiedy ruszamy. W kolejnych krokach przeprowadzane są prace wdrożeniowe, integracyjne, a następnie testy przygotowujące do uruchomienia. Więcej na stronie <a href="/proces-wdrozenia/">Proces wdrożenia</a>.' },
  { q: 'Z jakimi systemami ERP się integrujecie?', a: 'Mamy gotowe integracje z Teneum, Comarch XL i Optima, enova365 oraz Subiektem. Ceny, stany i warunki handlowe płyną z ERP na platformę, a zamówienia wracają do ERP. Inne systemy łączymy przez API i n8n. Więcej na stronie <a href="/integracje/">Integracje</a>.' },
];
---

<BaseLayout title="Platforma sprzedażowa B2B dla dystrybutorów" description="Platforma B2B dla firm dystrybucyjnych: warunki handlowe z ERP odwzorowane w 100%, samoobsługa klientów 24/7, Agent AI i Panel Handlowca." faq={faq.map(f => ({ question: f.q, answer: f.a.replace(/<[^>]+>/g, '') }))}>

  <!-- HERO -->
  <section class="text-logos">
    <div class="container">
      <div class="row">
        <div class="col-lg-8 offset-lg-2">
          <div class="text-logos__wrapper">
            <span class="text-logos__badge">
              <span class="text-logos__badge-icon">
                <svg width="14" height="14" viewBox="0 0 26 26" fill="currentColor"><path d="M12.9999 16.75C15.7467 16.75 18.1487 17.9313 19.4553 19.6935L18.0738 20.347C17.0105 19.0868 15.1355 18.25 12.9999 18.25C10.8644 18.25 8.98939 19.0868 7.9261 20.347L6.54517 19.6929C7.85182 17.931 10.2535 16.75 12.9999 16.75ZM12.9999 5.5C15.071 5.5 16.7499 7.17894 16.7499 9.25V11.5C16.7499 13.571 15.071 15.25 12.9999 15.25C10.9289 15.25 9.24993 13.571 9.24993 11.5V9.25C9.24993 7.17894 10.9289 5.5 12.9999 5.5Z"/></svg>
              </span>
              Dla dystrybutorów
            </span>
            <h1 class="text-logos__title">Rozwiązanie dedykowane <span>zwiększaniu sprzedaży B2B</span> przez firmy dystrybucyjne</h1>
            <p class="desc p_regular_1">Twoja sprzedaż jest skomplikowana, warunki handlowe złożone, a klienci oczekują indywidualnego podejścia i pełnej dostępności? Wiemy, jak przekuć te wyzwania w szanse i w pełni wykorzystać potencjał Twojego biznesu.</p>
            <div class="page-hero__actions">
              <a class="wise-button wise-button--wise-harvest" href="/zamow-demo/">Zamów demo</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="numbers-text">
    <div class="container">
      <div class="row">
        <div class="col-lg-10 offset-lg-1">
          <div class="items">

            <div class="item">
              <h2 class="h2_semi">Przenieś 95% sprzedaży do kanału cyfrowego</h2>
              <div class="row">
                <div class="col-md-6"><div class="box">
                  <span class="numbers-text__box-icon" set:html={icon(I.cart)} />
                  <h3 class="p_regular_1">Sprzedawaj więcej do obecnych klientów</h3>
                  <p class="p_regular_3">Dysponujesz określoną bazą stałych klientów, którzy generują określone przychody. Co gdyby średnia wartość ich zakupów wzrosła o 20%, bez potrzeby angażowania czasu Twoich handlowców? Dzięki WiseB2B taki scenariusz stanie się faktem, a pomogą w tym takie funkcje jak promocje celowane, rabaty indywidualne, sugerowanie produktów komplementarnych czy wartości zakupów potrzebnej do skorzystania z lepszej ceny.</p>
                </div></div>
                <div class="col-md-6"><div class="box box--even">
                  <span class="numbers-text__box-icon" set:html={icon(I.tag)} />
                  <h3 class="p_regular_1">Odwzoruj specyfikę swojej oferty</h3>
                  <p class="p_regular_3">Warunki handlowe, indywidualny model cennikowy, szeroka oferta produktowa, specyficzne rabaty i promocje: wszystko, co wyróżnia Twój biznes i za co Twoi klienci wybierają właśnie Twoją firmę, będzie w 100% odwzorowane na platformie B2B. Ceny, stany i warunki płyną prosto z Twojego ERP.</p>
                </div></div>
                <div class="col-md-6"><div class="box">
                  <span class="numbers-text__box-icon" set:html={icon(I.globe)} />
                  <h3 class="p_regular_1">Zdobywaj nowych klientów</h3>
                  <p class="p_regular_3">WiseB2B to nie tylko narzędzie dla Twoich obecnych klientów, ale również źródło pozyskiwania nowych. Dzięki optymalizacji pod kątem pozycjonowania w wyszukiwarkach i dostępowi przez <a href="/funkcje/">profil otwarty</a> Twoja oferta dotrze do nieograniczonej liczby odbiorców, których będziesz miał okazję przekształcić w klientów.</p>
                </div></div>
                <div class="col-md-6"><div class="box box--even">
                  <span class="numbers-text__box-icon" set:html={icon(I.user)} />
                  <h3 class="p_regular_1">Uwolnij potencjał handlowców</h3>
                  <p class="p_regular_3">Kiedy odciążysz swoich sprzedawców z czasochłonnego i mozolnego przyjmowania zamówień od dziesiątek klientów, będą oni mogli skupić się na zadaniach naprawdę ważnych: budowaniu relacji z kluczowymi kontrahentami, dbaniu o ich potrzeby i docieraniu do nowych rynków oraz klientów. Zamówienie z maila, PDF-a czy Excela <a href="/agent-ai/">Agent AI</a> zamieni w gotowy koszyk. U dystrybutora części do maszyn rolniczych, który przeszedł na WiseB2B z platformy SaaS, 42% zamówień przechodzi bez weryfikacji działu handlowego.</p>
                </div></div>
              </div>
            </div>

            <div class="item">
              <h2 class="h2_semi">Zbuduj lojalność i przywiązanie klientów</h2>
              <div class="row">
                <div class="col-md-6"><div class="box">
                  <span class="numbers-text__box-icon" set:html={icon(I.search)} />
                  <h3 class="p_regular_1">Intuicyjność będzie Twoją przewagą</h3>
                  <p class="p_regular_3">Twoi klienci znajdują błyskawicznie wszystkie potrzebne produkty, po dowolnie zadanych parametrach, a w wynikach wyszukiwania uwzględnione są Twoje priorytety sprzedażowe. Brzmi jak utopijna wizja? Dzięki WiseB2B zapewnisz swoim klientom właśnie takie doświadczenia, zadbasz o szybkie i komfortowe wyszukiwanie produktów, a jednocześnie wesprzesz swoje cele sprzedażowe.</p>
                </div></div>
                <div class="col-md-6"><div class="box box--even">
                  <span class="numbers-text__box-icon" set:html={icon(I.clock)} />
                  <h3 class="p_regular_1">Zapewnij dostępność i przejrzystość oferty</h3>
                  <p class="p_regular_3">Twoi klienci biznesowi chcą robić zakupy wtedy, kiedy mają na to czas, korzystając z intuicyjnych narzędzi, które znają z rynku konsumenckiego. WiseB2B jest zaprojektowane z myślą o potrzebach, przyzwyczajeniach i nawykach osób decyzyjnych w firmach dystrybucyjnych. Stany, statusy zamówień i faktury klient sprawdza sam, także wieczorem i w weekend.</p>
                </div></div>
                <div class="col-md-6"><div class="box">
                  <span class="numbers-text__box-icon" set:html={icon(I.heart)} />
                  <h3 class="p_regular_1">Zadbaj o indywidualne doświadczenia</h3>
                  <p class="p_regular_3">Masz wielu klientów, ale zależy Ci, aby każdy z nich czuł się indywidualnie traktowany. WiseB2B dostarcza bogaty wachlarz narzędzi, takich jak indywidualne cenniki, zakresy i dostępności produktów, promocje czy limity kredytowe. Dzięki nim możesz udostępnić swoim klientom jedną platformę, która odpowie na indywidualne potrzeby i specyfikę każdego z nich z osobna. Handlowiec w <a href="/panel-handlowca/">Panelu Handlowca</a> widzi, co klient kupuje online i offline, i przygotowuje mu ofertę na tych samych warunkach.</p>
                </div></div>
                <div class="col-md-6"><div class="box box--even">
                  <span class="numbers-text__box-icon" set:html={icon(I.book)} />
                  <h3 class="p_regular_1">Bądź źródłem wiedzy</h3>
                  <p class="p_regular_3">Twoja firma funkcjonuje w specyficznej branży i nie chcesz udostępniać wszystkich informacji publicznie? Jednocześnie Twoi klienci pytają Cię o najnowsze produkty lub zmiany w przepisach? Wykorzystaj platformę B2B jako dedykowane i ekskluzywne centrum wiedzy, dostępne tylko dla zalogowanych klientów.</p>
                </div></div>
              </div>
            </div>

            <div class="item">
              <h2 class="h2_semi">Realizuj strategię wzrostu bez ograniczeń</h2>
              <div class="row">
                <div class="col-md-6"><div class="box">
                  <span class="numbers-text__box-icon" set:html={icon(I.wallet)} />
                  <h3 class="p_regular_1">Skorzystaj z wiedzy konsultantów z ponad 25-letnim doświadczeniem</h3>
                  <p class="p_regular_3">Masz za sobą pierwsze, niekoniecznie udane próby przeniesienia sprzedaży B2B do kanału cyfrowego lub jest to Twoje pierwsze podejście. Może masz już eCommerce, ale przechodzi przez niego 10&ndash;15% sprzedaży, a reszta nadal płynie mailem, telefonem i w Excelu. Niezależnie od sytuacji stoi przed Tobą duże wyzwanie: najpierw przeniesienie całej oferty i wszystkich warunków handlowych do świata cyfrowego, a następnie dopracowywanie i rozwijanie wdrożonego rozwiązania zgodnie z tym, jak będzie zmieniał się Twój biznes i potrzeby Twoich klientów. Mamy dla Ciebie dobrą informację: nie będziesz w tym procesie sam. Wybierając WiseB2B, decydujesz się nie tylko na w pełni funkcjonalne narzędzie, dopasowane do rynku firm dystrybucyjnych. W pakiecie dostajesz również wiedzę i doświadczenie konsultantów, którzy wspierają firmy handlowe w procesach transformacji sprzedaży.</p>
                </div></div>
                <div class="col-md-6"><div class="box box--even">
                  <span class="numbers-text__box-icon" set:html={icon(I.chart)} />
                  <h3 class="p_regular_1">Rozwijaj platformę zgodnie z potrzebami Twojego biznesu</h3>
                  <p class="p_regular_3">WiseB2B nigdy nie ograniczy Twojego biznesu. To nie marketingowy frazes, ale nasza misja, z jaką budujemy to rozwiązanie. Wiemy, jakich funkcji potrzebują firmy dystrybucyjne, aby skutecznie przenosić handel do online, i zadbaliśmy o to, aby nasza platforma zapewniała dostęp do każdej z nich. Jednocześnie wiemy, że w pewnym momencie może to być dla Ciebie za mało, bo wejdziesz na nowy rynek, będziesz chciał przetestować nowy model biznesowy lub zupełnie przedefiniować swoją ofertę. Dlatego, tworząc WiseB2B, postawiliśmy na to, aby oprócz bogatej funkcjonalności było ono również otwarte na zmiany, konfigurację i rozbudowywanie. Dostęp do kodu źródłowego sprawia, że to Ty decydujesz, kto je rozwija. Mamy przekonanie, że takie podejście do budowania cyfrowych narzędzi sprzedaży dla B2B to jedyna słuszna droga i gwarancja bezpieczeństwa na przyszłość.</p>
                </div></div>
              </div>
            </div>

          </div>

          <div class="numbers-text__button">
            <a class="wise-button wise-button--dark" href="/funkcje/">Wszystkie funkcjonalności</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA: rozmowa z ekspertem -->
  <section class="call-expert">
    <div class="container">
      <div class="row">
        <div class="col-xl-8 offset-xl-2 col-lg-10 offset-lg-1">
          <div class="call-expert__wrapper">
            <h2 class="h2_semi">Potrzebujesz szczegółowych informacji?</h2>
            <p class="dd-call-expert__lead p_regular_1">Wejdź na wyższy poziom eCommerce. Powiedz nam, ile Twojej sprzedaży przechodzi dziś przez kanał online, a pokażemy, jak przenieść tam resztę.</p>
            <p class="name h5_regular">Jakub Czyżkowski</p>
            <p class="job p_regular_2">CEO</p>
            <div class="call-expert__button">
              <a class="wise-button wise-button--wise-harvest" href="/zamow-demo/">Zamów rozmowę z ekspertem</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CASE STUDY -->
  <section class="hp-case hp-case--dark">
    <div class="container">
      <h2 class="hp-section-title lm-observer">Case study</h2>
      <p class="hp-section-subtitle lm-observer">Klienci Triplex zamawiali przez telefon i w Excelu. Zobacz, ile zamówień przechodzi dziś przez platformę B2B.</p>
      <div class="hp-case__inner lm-observer">
        <div class="hp-case__visual">
          <img src="/case-study/triplex/browser-blender-4-811x608.png" alt="Sklep B2B Triplex na platformie WiseB2B" width="811" height="608" loading="lazy" />
        </div>
        <div class="hp-case__content">
          <div class="hp-case__logo">
            <img loading="lazy" width="68" height="68" src="/images/triplex-p-68x68.png" alt="Triplex" />
          </div>
          <h3>Czołowy dystrybutor pirotechniki postawił na WiseB2B</h3>
          <div class="hp-case__stats">
            <div class="hp-case__stat">
              <span class="hp-case__stat-value">46,36%</span>
              <span class="hp-case__stat-label">zamówień pochodzących z platformy B2B</span>
            </div>
            <div class="hp-case__stat">
              <span class="hp-case__stat-value">49,55%</span>
              <span class="hp-case__stat-label">obrotu wygenerowanego poprzez platformę B2B</span>
            </div>
            <div class="hp-case__stat">
              <span class="hp-case__stat-value">34,43%</span>
              <span class="hp-case__stat-label">klientów korzystających z platformy B2B</span>
            </div>
          </div>
          <a class="wise-button wise-button--white-wise" href="/case-study/triplex/">Zobacz case study</a>
        </div>
      </div>
    </div>
  </section>

  <!-- OPINIA -->
  <section class="hp-testimonials">
    <div class="container">
      <div class="hp-testimonials__card lm-observer">
        <img src="/svg/double-quotes-r.svg" alt="" class="hp-testimonials__quote hp-testimonials__quote--right" width="80" height="80" />
        <blockquote>
          Jesteśmy w branży 30 lat, nasi klienci również &ndash; baliśmy się na początku, że klienci przyzwyczajeni do exceli i telefonu nie będą chcieli składać zamówień przez platformę B2B. Ale reakcje są inne &ndash; klienci są zachwyceni. Takie zmiany też dobrze wpływają na wizerunek branży i przyciągają młode pokolenie. Bardzo pozytywnie oceniam zmiany, jakie wniosła platforma B2B wdrożona przez Sente.
        </blockquote>
        <div class="hp-testimonials__author">
          <p class="hp-testimonials__author-name">Aneta Siwarga</p>
          <p class="hp-testimonials__author-site">Prokurent w Triplex</p>
        </div>
        <img src="/svg/double-quotes-l.svg" alt="" class="hp-testimonials__quote hp-testimonials__quote--left" width="80" height="80" />
      </div>
    </div>
  </section>

  <!-- BAZA WIEDZY -->
  <section class="hp-blog">
    <div class="container">
      <h2 class="hp-section-title lm-observer">Mogą Cię zainteresować</h2>
      <p class="hp-section-subtitle lm-observer">Artykuły dla dystrybutorów, którzy planują sprzedaż B2B online</p>
      <div class="hp-blog__grid">
        {articles.map((article) => (
          <a href={`/baza-wiedzy/${article.id}/`} class="hp-blog__card lm-observer">
            <div class="hp-blog__card-img">
              {article.data.image && <img src={article.data.image} alt={article.data.title} width="376" height="250" loading="lazy" />}
              <span class="hp-blog__card-cat">{article.data.category}</span>
            </div>
            <div class="hp-blog__card-body">
              <h3>{article.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
      <div class="hp-blog__more">
        <a href="/baza-wiedzy/" class="btn btn--dark">Sprawdź więcej</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="questions">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="questions__wrapper">
            <h3 class="h3_semi">Najczęściej zadawane pytania</h3>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2">
          <div class="questions__items">
            {faq.map(f => (
              <div class="item">
                <h2 class="h5_semi">{f.q}</h2>
                <p class="p_regular_3" set:html={f.a} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

<CtaBlock />

<script>
