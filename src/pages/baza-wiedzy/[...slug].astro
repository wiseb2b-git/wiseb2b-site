---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import ArticleCards from '../../components/ArticleCards.astro';

export async function getStaticPaths() {
  const articles = await getCollection('baza-wiedzy');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, image, category, date, dateModified, author, authorJob, authorImage, authorBio } = article.data;

const allArticles = await getCollection('baza-wiedzy');
const otherSlugs = allArticles.filter((a) => a.id !== article.id).slice(0, 3).map((a) => a.id);

const formattedDate = new Date(date).toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' });

function extractFaq(body: string): Array<{question: string; answer: string}> {
  const faqSection = body.split(/^## Najcz[eę]stsze pytania/m)[1];
  if (!faqSection) return [];
  const matches = [...faqSection.matchAll(/^### (.+?)\n\n([\s\S]+?)(?=\n###|\n##|$)/gm)];
  return matches.map(m => ({ question: m[1].trim(), answer: m[2].trim() }));
}
const faqItems = extractFaq(article.body || '');
---

<BaseLayout title={title} description={description} article={{ headline: title, image, datePublished: date, dateModified, authorName: author, authorJob, description }} faq={faqItems.length > 0 ? faqItems : undefined}>

<section class="single-hero">
  <div class="container">
    <div class="single-hero__meta lm-observer">
      <span class="single-hero__meta-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h6v6H4V4zm10 0h6v6h-6V4zM4 14h6v6H4v-6zm10 0h6v6h-6v-6z"/></svg>
        {category}
      </span>
      {author && (
        <span class="single-hero__meta-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm0 2c-3.34 0-10 1.68-10 5v3h20v-3c0-3.32-6.66-5-10-5z"/></svg>
          {author}
        </span>
      )}
      <span class="single-hero__meta-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2v2H5a2 2 0 0 0-2 2v2h18V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7zM3 10v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V10H3z"/></svg>
        {formattedDate}
      </span>
    </div>
    <h1 class="single-hero__title lm-observer">{title}</h1>
  </div>
</section>

<div class="mceContentBody">
  <div class="container">
    <div class="row">
      <div class="col-xl-8 offset-xl-2 col-lg-10 offset-lg-1">

        <!-- Featured image -->
        <div class="single-image">
          <div class="image">
            <img width="800" height="533" src={image} alt={title} />
          </div>
        </div>

        <!-- Article content -->
        <div class="single-content" style="margin-top: 33px;">
          <Content />
        </div>

        <!-- Author section -->
        {author && (
          <div class="single-author-bottom">
            <div class="single-author-bottom__left">
              {authorImage && (
                <img width="64" height="64" src={authorImage} alt={author} style="border-radius: 50%; width: 64px; height: 64px; object-fit: cover;" />
              )}
              <p class="name p_semi_2">{author}</p>
              {authorJob && <p class="job p_regular_3" style="color: var(--color-dark-300);">{authorJob}</p>}
            </div>
            {authorBio && (
              <div class="single-author-bottom__desc p_regular_3" style="color: var(--color-dark-300);">
                {authorBio}
              </div>
            )}
          </div>
        )}

      </div>
    </div>
  </div>
</div>

<ArticleCards slugs={otherSlugs} showButton={true} />

<section class="call-expert">
  <div class="container">
    <div class="row">
      <div class="col-xl-8 offset-xl-2 col-lg-10 offset-lg-1">
        <div class="call-expert__wrapper lm-observer">
          <h2 class="h2_semi">Potrzebujesz szczegółowych informacji?</h2>
          <p class="job p_regular_1">Porozmawiaj z nami</p>
          <div class="call-expert__button">
            <a class="wise-button wise-button--wise-harvest" href="/zamow-demo/">Porozmawiaj</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
