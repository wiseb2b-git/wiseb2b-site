---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { getCollection, render } from 'astro:content';

const funkcjonalnosci = await getCollection('funkcjonalnosci');
funkcjonalnosci.sort((a, b) => a.id.localeCompare(b.id));
const renderedFunkcjonalnosci = await Promise.all(
  funkcjonalnosci.map(async (f, index) => {
    const { Content } = await render(f);
    return { ...f, Content, index };
  })
);

// 13 obszarów z macierzy modułów (kolekcja obszary); opisy obszarów poniżej
const obszary = (await getCollection('obszary')).sort((a, b) => a.data.order - b.data.order);
const obszarOpis: Record<number, string> = {
  10: 'Kategorie, atrybuty, zdjęcia, dokumenty, akcesoria i zamienniki. Dane GPSR wymagane przepisami.',
  20: 'Cenniki grupowe i indywidualne, promocje, limity kredytowe, ceny według magazynu, opakowania i progu ilościowego, cenniki w walutach.',
  30: 'Wyszukiwarka z synonimami, odporna na literówki, i ranking produktów ustawiony pod Twoją strategię sprzedaży.',
  40: 'Wielokoszyki, listy zakupowe, import zamówienia z CSV lub Excela, kurierzy, płatności, dropshipping, sprzedaż zagraniczna z kontrolą VIES, akceptacje zamówień.',
  50: 'Historia zamówień, faktur i dostaw, rozrachunki, zwroty i reklamacje, oferty dedykowane i konta zakupowców klienta.',
  60: 'Agent klienta, agent administratora i automatyczne generowanie treści przez AI dla wybranych pól.',
  70: 'Strona główna, slidery, aktualności, baza wiedzy powiązana z produktami i treści SEO.',
  80: 'Profil zamknięty, profil otwarty bez logowania do zdobywania nowych klientów, MultiStore: wiele sklepów na jednym zapleczu.',
  90: 'Zakupy bez rejestracji, ceny brutto i obsługa dyrektywy Omnibus, gdy sprzedajesz też klientom detalicznym.',
  100: 'Logowanie na konto klienta, Panel Handlowca, ofertowanie, zadania i monitoring klientów.',
  110: 'Gotowe integracje z ERP, Admin API i Client API.',
  120: 'Środowisko produkcyjne i testowe, n8n do automatyzacji i instalacja on-premise.',
  130: 'Wtyczki własne, kod źródłowy i Customization Studio do budowy pluginów z AI.',
};

const faqData = [
  {
    question: "Czym funkcje WiseB2B różnią się od zwykłego sklepu internetowego?",
    answer: "WiseB2B powstało dla handlu B2B. Grupy klientów, cenniki indywidualne, limity kredytowe, konta zakupowców i akceptacje zamówień to moduły platformy, a nie przeróbki sklepu detalicznego. Do tego dochodzą Panel Handlowca i agenci AI, które pracują na tych samych danych z ERP. Część modułów jest w pakiecie każdego planu, część dodajesz jako opcję."
  },
  {
    question: "Czy mogę zacząć od części funkcji?",
    answer: "Tak. Platforma składa się z modułów, więc zaczynasz od tych, których potrzebujesz dziś, a kolejne dokładasz wraz z rozwojem sprzedaży online. Które moduły są w którym planie, sprawdzisz w porównaniu planów."
  },
  {
    question: "Czy funkcje da się dopasować do mojej branży?",
    answer: "Tak. Zmiany powstają jako pluginy, poza kodem standardowym, więc aktualizacja do nowej wersji nie wymaga ich przepisywania. Pluginy może zbudować nasz zespół, partner wdrożeniowy albo Twój dział IT. W planie Enterprise masz też dostęp do kodu źródłowego."
  }
];
---

<BaseLayout title="Funkcje platformy Commerce B2B WiseB2B" description="37 modułów w 13 obszarach: katalog, cenniki z ERP, proces zakupowy, Panel Handlowca, agenci AI, integracje i kod źródłowy. Zobacz, co dostaje Twój klient." faq={faqData}>
<section class="page-hero">
  <div class="container">
    <span class="page-hero__badge">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm0 2c-3.34 0-10 1.68-10 5v3h20v-3c0-3.32-6.66-5-10-5z"/></svg>
      Funkcje platformy
    </span>
    <h1 class="lm-observer">Funkcje platformy <span>WiseB2B</span></h1>
    {/* NEED: potwierdzenie liczby modułów; materiały CEO mówią o 37 modułach, macierz cenowa ma ok. 69 pozycji */}
    <p class="page-hero__lead lm-observer">37 modułów w 13 obszarach, od katalogu z cenami z ERP po kod źródłowy. Klient zamawia sam, handlowiec widzi każde zamówienie, a powtarzalną pracę przejmują agenci AI.</p>
    <div class="page-hero__actions lm-observer">
      <a class="wise-button wise-button--wise-harvest" href="/zamow-demo/">Zamów demo</a>
    </div>
  </div>
</section>

<div class="functions-box-white-bg">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <div class="functions-box-white-bg__wrap">
          <h2 class="h2_semi functions-box-white-bg__header lm-observer">Co z tego ma każda strona sprzedaży:</h2>
          <div class="functions-box-white-bg__wrapper">
            <div class="item lm-observer">
              <span class="icon-purple-badge">
                <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1.08-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1.08 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              </span>
              <p class="p_semi_2 item_header">Klienta</p>
              <p class="p_regular_3 item__description">Widzi swoje ceny, stany i historię zamówień. Ponawia zamówienie z listy zakupowej albo wkleja je z maila i zamawia wtedy, kiedy mu pasuje, także wieczorem.</p>
            </div>
            <div class="item lm-observer">
              <span class="icon-purple-badge">
                <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 10v10"/></svg>
              </span>
              <p class="p_semi_2 item_header">Właściciela</p>
              <p class="p_regular_3 item__description">Powtarzalne zamówienia trafiają do ERP bez przepisywania. Obsługujesz więcej klientów tym samym zespołem i płacisz stały abonament bez prowizji od obrotu.</p>
            </div>
            <div class="item lm-observer">
              <span class="icon-purple-badge">
                <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8c0 4.5-6 12-6 12S6 12.5 6 8a6 6 0 1 1 12 0z"/><circle cx="12" cy="8" r="2.2"/></svg>
              </span>
              <p class="p_semi_2 item_header">Działu sprzedaży</p>
              <p class="p_regular_3 item__description">Handlowiec w Panelu Handlowca ma historię zakupów, rozrachunki i oferty klienta. Składa zamówienie w jego imieniu, przygotowuje ofertę i dzwoni do tych, którzy kupują mniej.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="functions-cards functions-cards--dark">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
