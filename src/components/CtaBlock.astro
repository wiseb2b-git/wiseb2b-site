---
interface Props {
  showPresentation?: boolean;
  presentationTriggersPopup?: boolean;
}
const { showPresentation = false, presentationTriggersPopup = false } = Astro.props;
---

{showPresentation && (
  <section class="cta-presentation">
    <div class="container">
      <div class="cta-presentation__card">
        <svg class="cta-presentation__icon" width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M17 10.5V7C17 6.45 16.55 6 16 6H4C3.45 6 3 6.45 3 7V17C3 17.55 3.45 18 4 18H16C16.55 18 17 17.55 17 17V13.5L21 17.5V6.5L17 10.5Z" fill="var(--color-primary-500)"/>
        </svg>
        <h3 class="cta-presentation__title">Chcę się umówić na prezentację.</h3>
        {presentationTriggersPopup ? (
          <span class="cta-presentation__btn js-presentation-form-call">Wybieram</span>
        ) : (
          <a href="/zamow-demo/" class="cta-presentation__btn">Wybieram</a>
        )}
      </div>
    </div>
  </section>
)}

<section class="cta-newsletter">
  <div class="container">
    <div class="cta-newsletter__inner">
      <h3 class="cta-newsletter__title">Bądź na bieżąco z nowościami<br>eCommerce i WiseB2B</h3>
      <form class="cta-newsletter__form" data-form="newsletter">
        <div class="cta-newsletter__row">
          <input type="email" name="email" placeholder="E-mail..." required class="cta-newsletter__input" />
          <button type="submit" class="cta-newsletter__submit">Zapisz się</button>
        </div>
        <label class="cta-newsletter__consent">
          <input type="checkbox" name="consent" required />
          <span>Akceptuję <a href="https://sente.pl/polityka-prywatnosci-2/" target="_blank" rel="noopener">politykę prywatności</a> i regulamin</span>
        </label>
        <input type="text" name="bot-field" style="display:none" tabindex="-1" autocomplete="off" />
      </form>
      <p class="cta-newsletter__success" style="display:none">Dziękujemy za zapisanie się!</p>
    </div>
  </div>
</section>

<script is:inline>
document.querySelectorAll('[data-form="newsletter"]').forEach(function(form) {
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var fd = new FormData(this);
    fd.append('form_name', 'Newsletter');
    fetch('/api/contact/', { method: 'POST', body: fd })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.ok) {
          form.style.display = 'none';
          form.parentElement.querySelector('.cta-newsletter__success').style.display = 'block';
        }
      });
  });
});
</script>
