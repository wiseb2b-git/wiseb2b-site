---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';

// Tekst: .knowledge/teksty/agent-ai.md (copy deck CEO), układ: Figma 117:384.
const icon = (d: string, size = 26) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const I = {
  gear: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1"/>',
  layout: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18M12 3v18"/>',
  heart: '<circle cx="12" cy="7" r="3"/><path d="M12 21s-5-3.2-5-6.5A2.8 2.8 0 0 1 12 13a2.8 2.8 0 0 1 5 1.5C17 17.8 12 21 12 21z"/>',
  cart: '<circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/><path d="M2 3h2l2.4 12.2a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21 7H6"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  briefcase: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18"/>',
  sliders: '<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>',
  sparkle: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/>',
  code: '<path d="m8 8-5 4 5 4M16 8l5 4-5 4M14 4l-4 16"/>',
};
---

<BaseLayout title="Agent AI w eCommerce B2B: Email-2-Cart i trzech agentów" description="Agent Klienta składa koszyk z maila, PDF-a lub Excela. Agent Handlowca przygotowuje oferty, a Agent Administratora wykonuje operacje masowe. Zobacz na demo.">

<!-- S1: Hero -->
<div class="agent-ai-hero">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
        <div class="agent-ai-hero__content lm-observer">
          <span class="page-hero__badge">
            <svg width="16" height="16" viewBox="0 0 26 26" fill="currentColor"><path d="M12.9999 16.75C15.7467 16.75 18.1487 17.9313 19.4553 19.6935L18.0738 20.347C17.0105 19.0868 15.1355 18.25 12.9999 18.25C10.8644 18.25 8.98939 19.0868 7.9261 20.347L6.54517 19.6929C7.85182 17.931 10.2535 16.75 12.9999 16.75ZM12.9999 5.5C15.071 5.5 16.7499 7.17894 16.7499 9.25V11.5C16.7499 13.571 15.071 15.25 12.9999 15.25C10.9289 15.25 9.24993 13.571 9.24993 11.5V9.25C9.24993 7.17894 10.9289 5.5 12.9999 5.5Z"/></svg>
            Agent AI
          </span>
          <h1 class="h1_semi">Nowy poziom efektywności eCommerce B2B dzięki <span>Agentom AI</span></h1>
          <p class="p_regular_1">Przestań traktować sztuczną inteligencję jako ciekawostkę. Wdrażamy narzędzia, które wykonują realną pracę: automatyzują procesy, odciążają handlowców i&nbsp;personalizują doświadczenia zakupowe Twoich klientów.</p>
          <a class="wise-button wise-button--wise-harvest" href="/zamow-demo/">Zamów demo i&nbsp;sprawdź AI w&nbsp;akcji</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Film YouTube (poza Figmą, zachowany) -->
<div class="agent-ai-video">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
        <div class="agent-ai-video__wrapper lm-observer">
          <div class="agent-ai-video__embed" id="yt-player-wrapper">
            <img
              src="https://img.youtube.com/vi/-l65_JZ0HVg/maxresdefault.jpg"
              alt="Agent AI WiseB2B, prezentacja wideo"
              class="agent-ai-video__poster"
              id="yt-poster"
              loading="lazy"
            />
            <div class="agent-ai-video__play-btn" id="yt-play-btn">
              <svg width="68" height="68" viewBox="0 0 68 68" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="34" cy="34" r="34" fill="rgba(0,0,0,0.6)"/>
                <polygon points="27,20 27,48 50,34" fill="#fff"/>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- S2: AI, które rozumie Twój biznes -->
<div class="agent-ai-features agent-ai-features--white">
  <div class="container">
    <div class="row">
      <div class="col-xl-10 offset-xl-1">
        <h2 class="h2_semi agent-ai-features__heading lm-observer">AI, które rozumie Twój biznes</h2>
        <p class="p_regular_1 agent-ai-features__subheading lm-observer">Agenci AI w&nbsp;WiseB2B pracują wewnątrz platformy, na Twoich danych i&nbsp;z&nbsp;uprawnieniami użytkownika, w&nbsp;którego imieniu działają.</p>
        <div class="agent-ai-features__grid">
          <div class="agent-ai-feature-card lm-observer">
            <div class="agent-ai-feature-card__icon" set:html={icon(I.gear)} />
            <h3 class="p_semi_2">Zintegrowany, nie doklejony</h3>
            <p class="p_regular_3">Agent AI to natywny moduł WiseB2B, który operuje na rzeczywistych danych: Twoich cennikach, stanach magazynowych i&nbsp;indywidualnych warunkach handlowych.</p>
          </div>
          <div class="agent-ai-feature-card lm-observer">
            <div class="agent-ai-feature-card__icon" set:html={icon(I.layout)} />
            <h3 class="p_semi_2">Nowy interfejs pracy dla użytkownika</h3>
            <p class="p_regular_3">Narzędzie nie tylko odpowiada na pytania, ale realizuje faktyczne procesy biznesowe, zdejmując ciężar operacyjny z&nbsp;Twojego zespołu.</p>
          </div>
          <div class="agent-ai-feature-card lm-observer">
            <div class="agent-ai-feature-card__icon" set:html={icon(I.heart)} />
            <h3 class="p_semi_2">Wsparcie BOK i&nbsp;handlowców</h3>
            <p class="p_regular_3">Redukcja liczby zapytań o&nbsp;dostępność i&nbsp;proste ofertowanie pozwalają Twoim ludziom skupić się na budowaniu relacji, a&nbsp;nie na obsłudze transakcji.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- S3: Przykładowe scenariusze efektywności -->
<div class="agent-ai-usecases agent-ai-usecases--kv">
  <div class="container">
    <div class="row">
      <div class="col-xl-10 offset-xl-1">
        <h2 class="h2_semi agent-ai-usecases__heading lm-observer">Przykładowe scenariusze efektywności</h2>

        <div class="agent-ai-usecase agent-ai-usecase--reverse lm-observer">
          <div class="agent-ai-usecase__text">
            <div class="agent-ai-feature-card__icon" set:html={icon(I.cart)} />
            <h3 class="h3_semi">Kompletacja zamówienia z&nbsp;doradztwem</h3>
            <p class="p_regular_2">Zaawansowane wyszukiwanie kontekstowe i&nbsp;doradztwo techniczne. Klient precyzuje wymagania (np. „tylko akumulatorowe”, „zestaw od jednego producenta”), a&nbsp;Agent błyskawicznie generuje zestawienia w&nbsp;czytelnej formie tabelarycznej. Wybrane pozycje dodaje do koszyka na prośbę klienta.</p>
          </div>
          <div class="agent-ai-usecase__visual">
            <img class="agent-ai-mockup-img" src="/images/agent-ai-mockup-02.png" alt="Agent AI: zestawienie produktów w tabeli według wymagań klienta" loading="lazy" />
          </div>
        </div>

        <div class="agent-ai-usecase lm-observer">
          <div class="agent-ai-usecase__text">
            <div class="agent-ai-feature-card__icon" set:html={icon(I.mail)} />
            <h3 class="h3_semi">Email-2-Cart</h3>
            <p class="p_regular_2">Przetwarzanie niestrukturyzowanych zapytań i&nbsp;zamówień przesyłanych drogą mailową. Agent analizuje treść maila lub załącznika (PDF, Excel), identyfikuje indeksy (nawet przy błędnych nazwach) i&nbsp;automatycznie tworzy gotowy koszyk zakupowy na warunkach tego klienta. Eliminacja ręcznego wprowadzania zamówień.</p>
          </div>
          <div class="agent-ai-usecase__visual">
            <img class="agent-ai-mockup-img" src="/images/agent-ai-email-to-cart.png" alt="Email-2-Cart: mail z zamówieniem i koszyk przygotowany przez Agenta AI" loading="lazy" />
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- S4: Agent dla klienta, handlowca i administratora (nowa sekcja, poza Figmą) -->
<div class="agent-ai-features">
  <div class="container">
    <div class="row">
      <div class="col-xl-10 offset-xl-1">
        <h2 class="h2_semi agent-ai-features__heading lm-observer">Agent dla klienta, handlowca i&nbsp;administratora</h2>
        <p class="p_regular_1 agent-ai-features__subheading lm-observer">Każdy agent ma uprawnienia swojej roli i&nbsp;wykonuje operacje w&nbsp;platformie. Klient zamawia szybciej, handlowiec ma przygotowaną ofertę, a&nbsp;administrator nie zmienia rekordów po kolei.</p>
        <div class="agent-ai-features__grid">
          <div class="agent-ai-feature-card lm-observer">
            <div class="agent-ai-feature-card__icon" set:html={icon(I.user)} />
            <h3 class="p_semi_2">Agent Klienta</h3>
            <p class="p_regular_3">Wyszukuje i&nbsp;porównuje produkty, składa koszyk z&nbsp;maila, PDF-a lub Excela i&nbsp;sprawdza status zamówienia. Klient pisze tak, jak napisałby do handlowca, np. „dodaj 50 sztuk pozycji z&nbsp;mojego ostatniego zamówienia plus 20 paczek z&nbsp;tej oferty”.</p>
          </div>
          <div class="agent-ai-feature-card lm-observer">
            <div class="agent-ai-feature-card__icon" set:html={icon(I.briefcase)} />
            <h3 class="p_semi_2">Agent Handlowca</h3>
            <p class="p_regular_3">Przygotowuje ofertę na podstawie zapytania, które klient przysłał mailem lub wiadomością. Rano podpowiada handlowcowi, czym się dziś zająć, a&nbsp;w&nbsp;trakcie sprawy proponuje kolejne kroki i&nbsp;treść odpowiedzi do klienta. Pracuje na tych samych cenach i&nbsp;warunkach co sklep i&nbsp;Panel Handlowca.</p>
          </div>
          <div class="agent-ai-feature-card lm-observer">
            <div class="agent-ai-feature-card__icon" set:html={icon(I.sliders)} />
            <h3 class="p_semi_2">Agent Administratora</h3>
            <p class="p_regular_3">Pomaga konfigurować system i&nbsp;wykonuje operacje masowe: zmianę cennika dla grupy produktów, nową promocję, porządki w&nbsp;kategoriach. Administrator opisuje zadanie jednym zdaniem, a&nbsp;Agent wykonuje je w&nbsp;panelu administracyjnym.</p>
          </div>
        </div>
        <div class="agent-ai-features__grid agent-ai-features__grid--2">
          <div class="agent-ai-feature-card lm-observer">
            <div class="agent-ai-feature-card__icon" set:html={icon(I.sparkle)} />
            <h3 class="p_semi_2">Automatyzacja generowania AI</h3>
            <p class="p_regular_3">Dla każdego pola dowolnego elementu systemu ustawiasz schemat, według którego AI generuje wartość: opis produktu, tytuł, meta opis SEO, tłumaczenie. Przy katalogu z&nbsp;tysiącami indeksów dział produktu sprawdza gotowe teksty, zamiast pisać je od zera.</p>
          </div>
          <div class="agent-ai-feature-card lm-observer">
            <div class="agent-ai-feature-card__icon" set:html={icon(I.code)} />
            <h3 class="p_semi_2">AI w&nbsp;tworzeniu pluginów</h3>
            <p class="p_regular_3">Architektura WiseB2B jest projektowana pod wsparcie AI w&nbsp;rozwoju rozszerzeń. Nowe pluginy powstają w&nbsp;WiseB2B DevStudio, w&nbsp;odseparowanym kodzie, więc kolejne aktualizacje platformy instalujesz bez przeszkód. Koszty rozwoju i&nbsp;adaptacji jeszcze nigdy nie były tak niskie.</p>
          </div>
        </div>
        <div class="agent-ai-features__more lm-observer">
          <a class="hp-why__link" href="/panel-handlowca/">Zobacz Panel Handlowca</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- S5: Dlaczego Agent AI od WiseB2B? -->
<div class="agent-ai-why agent-ai-why--dark">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
        <h2 class="h2_semi agent-ai-why__heading lm-observer">Dlaczego Agent AI od WiseB2B?</h2>
        <div class="agent-ai-why__table lm-observer">
          <div class="agent-ai-why__row">
            <div class="agent-ai-why__cell agent-ai-why__cell--feature"><p class="p_semi_2">Bezpieczeństwo danych</p></div>
            <div class="agent-ai-why__cell agent-ai-why__cell--benefit"><p class="p_regular_3">Agent korzysta z&nbsp;tych samych metod co interfejs aplikacji. Ma dostęp tylko do tych danych i&nbsp;operacji, które może wykonać dany użytkownik, i&nbsp;realizuje je, symulując jego działanie.</p></div>
          </div>
          <div class="agent-ai-why__row">
            <div class="agent-ai-why__cell agent-ai-why__cell--feature"><p class="p_semi_2">Agent wbudowany w&nbsp;UI</p></div>
            <div class="agent-ai-why__cell agent-ai-why__cell--benefit"><p class="p_regular_3">To nie jest dodatkowy skrypt osadzany na stronie, lecz mechanizm wbudowany w&nbsp;interfejs sklepu. Klient otwiera go przyciskiem „Zapytaj AI” obok wyszukiwarki i&nbsp;pracuje z&nbsp;nim w&nbsp;oknie, w&nbsp;panelu bocznym albo na pełnym ekranie. To daje zupełnie nowe doświadczenie użytkownikowi.</p></div>
          </div>
          <div class="agent-ai-why__row">
            <div class="agent-ai-why__cell agent-ai-why__cell--feature"><p class="p_semi_2">Nie tylko wyszukiwanie, ale również działanie</p></div>
            <div class="agent-ai-why__cell agent-ai-why__cell--benefit"><p class="p_regular_3">Agent to nie jest tylko wyszukiwarka czy porównywarka produktów. Wszystko to, co klient może zrobić w&nbsp;sklepie, Agent też potrafi: dodać produkty do koszyka, porównać produkty, wykorzystać listy zakupowe, sfinalizować zamówienie, sprawdzić stan realizacji zamówienia.</p></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- S6 + S7: Potwierdzona skuteczność, Zobacz Agenta AI w działaniu -->
<div class="agent-ai-showcase agent-ai-showcase--dark">
  <div class="container">
    <div class="agent-ai-showcase__grid lm-observer">
      <div class="agent-ai-showcase__visual">
        <img class="agent-ai-mockup-img" src="/images/agent-ai-01.png" alt="Agent AI WiseB2B w sklepie B2B: okno „Witaj w Agencie AI”" loading="lazy" />
      </div>
      <div class="agent-ai-showcase__text">
        <div class="agent-ai-showcase__block">
          <h2 class="h2_semi">Potwierdzona <span class="agent-ai-showcase__accent">skuteczność</span></h2>
          <div class="hp-proof__stats">
            <div><span class="hp-proof__value">80%</span><span class="hp-proof__label">obrotu</span></div>
          </div>
          <p class="p_regular_2">Nasze wdrożenia pokazują, że cyfryzacja kanałów sprzedaży to nie tylko wygoda, ale realne wzrosty. Średnio 80% obrotu u&nbsp;naszych klientów generowane jest przez platformę B2B, a&nbsp;Agent AI jest kolejnym krokiem w&nbsp;optymalizacji tych wyników poprzez uwalnianie czasu pracy handlowców.</p>
          <p class="p_regular_2 agent-ai-showcase__proof">VMP Group, dystrybutor bielizny i&nbsp;odzieży premium z&nbsp;katalogiem ponad 86&nbsp;000 indeksów: <strong>&minus;60%</strong> czasu obsługi zamówienia i&nbsp;<strong>&minus;45%</strong> zapytań do BOK po przejściu na WiseB2B.</p>
          <a href="/case-study/vmp/" class="hp-why__link">Zobacz case study VMP</a>
        </div>
        <div class="agent-ai-showcase__block">
          <h2 class="h2_semi">Zobacz <span class="agent-ai-showcase__accent">Agenta AI</span> w&nbsp;działaniu</h2>
          <p class="p_regular_2">Przekonaj się sam, jak Agent AI wspiera codzienną pracę w&nbsp;platformie B2B. Na naszym środowisku demo możesz przetestować jego możliwości bez zobowiązań. Wklej listę produktów z&nbsp;maila i&nbsp;zobacz, jak powstaje koszyk.</p>
          <a class="wise-button wise-button--white-wise" href="https://demo.wiseb2b.eu" target="_blank" rel="noopener noreferrer">Przejdź do demo</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- S8: Ekspert -->
<section class="call-expert">
  <div class="container">
    <div class="row">
      <div class="col-xl-8 offset-xl-2 col-lg-10 offset-lg-1">
        <div class="call-expert__wrapper">
          <h2 class="h2_semi">Potrzebujesz szczegółowych informacji?</h2>
          <p class="job p_regular_1">Porozmawiaj z&nbsp;nami</p>
          <p class="name h5_regular">Jakub Czyżkowski</p>
          <p class="job p_regular_2">CEO</p>
          <div class="call-expert__button">
            <a class="wise-button wise-button--wise-harvest" href="/zamow-demo/">Zamów rozmowę z&nbsp;ekspertem</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- S9: Newsletter -->
<CtaBlock />

<!-- Lightbox -->
<div class="agent-ai-lightbox" id="agent-ai-lightbox">
  <img class="agent-ai-lightbox__img" id="agent-ai-lightbox-img" src="" alt="" />
</div>

<script is:inline>
// Lightbox for mockup images
(function() {
  var lightbox = document.getElementById('agent-ai-lightbox');
  var lightboxImg = document.getElementById('agent-ai-lightbox-img');

  document.querySelectorAll('.agent-ai-mockup-img').forEach(function(img) {
    img.addEventListener('click', function() {
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightbox.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    });
  });

  lightbox.addEventListener('click', function() {
    lightbox.classList.remove('is-active');
    document.body.style.overflow = '';
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && lightbox.classList.contains('is-active')) {
      lightbox.classList.remove('is-active');
      document.body.style.overflow = '';
    }
  });
})();
</script>

<script is:inline>
// YouTube lazy-load on hover/click
(function() {
  var wrapper = document.getElementById('yt-player-wrapper');
  var poster = document.getElementById('yt-poster');
  var playBtn = document.getElementById('yt-play-btn');
  var loaded = false;

  function loadVideo() {
    if (loaded) return;
    loaded = true;
    var iframe = document.createElement('iframe');
    iframe.setAttribute('src', 'https://www.youtube.com/embed/-l65_JZ0HVg?autoplay=1&rel=0');
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
    iframe.setAttribute('allowfullscreen', '');
    iframe.style.position = 'absolute';
    iframe.style.top = '0';
    iframe.style.left = '0';
    iframe.style.width = '100%';
    iframe.style.height = '100%';
    if (poster) poster.style.display = 'none';
    if (playBtn) playBtn.style.display = 'none';
    wrapper.appendChild(iframe);
  }

  if (wrapper) {
    wrapper.addEventListener('mouseenter', loadVideo);
    wrapper.addEventListener('click', loadVideo);
  }
})();
</script>

</BaseLayout>
