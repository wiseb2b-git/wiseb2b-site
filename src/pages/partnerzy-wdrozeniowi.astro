---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { getCollection } from 'astro:content';

const partners = (await getCollection('partnerzy')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
// Tekst: .knowledge/teksty/partnerzy-wdrozeniowi.md (Figma 51:875). S3 to nowa sekcja spoza Figmy.
---

<BaseLayout title="Partnerzy wdrożeniowi WiseB2B: Sente i Satisfly" description="Wybierz, kto wdroży i rozwinie Twoją platformę B2B. Sente zna ERP i integracje, Satisfly UX i konwersję. Oprogramowanie od WiseB2B, wdrożenie od partnera.">

<!-- S1. HERO -->
<div class="supports-logos kv-on-dark">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 offset-lg-2">
        <span class="page-hero__badge lm-observer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
          Partnerzy
        </span>
        <h1 class="lm-observer kv-h1">Partnerzy <span>wdrożeniowi</span></h1>
      </div>
    </div>
    <div class="row">
      <div class="col-lg-6 offset-lg-3">
        <p class="description lm-observer kv-text">Nasi partnerzy wdrożeniowi to doświadczone firmy IT i&nbsp;agencje eCommerce, które pomagają klientom w&nbsp;pełnym wykorzystaniu platformy WiseB2B. Każdy partner posiada potwierdzone kompetencje w&nbsp;zakresie wdrożeń B2B. Ty wybierasz, z&nbsp;kim pracujesz.</p>
        <a href="/zamow-demo/" class="wise-button wise-button--wise-harvest lm-observer">Zamów demo</a>
      </div>
    </div>
  </div>
</div>

<!-- S2. KARTY PARTNERÓW -->
<div class="articles-filter-categories" style="padding-bottom:40px;">
  <div class="container">
    <div class="row">
      <div class="col-lg-12 col-xl-10 offset-xl-1">
        <div class="box-posts partner-grid">
          {partners.map((partner) => (
            <div class="item">
              <div class="image partner-logo-box">
                <img loading="lazy" src={partner.data.logo} alt={partner.data.name} class="partner-logo-img" />
              </div>
              <div class="content">
                <p class="item_category kv-small kv-accent">{partner.data.specialization.join(' · ')}</p>
                <h2 class="title kv-title">{partner.data.name}</h2>
                <p class="excerpt kv-text">{partner.data.shortDescription}</p>
                <a href={partner.data.website} target="_blank" rel="noopener" class="wise-button wise-button--dark partner-card__cta">Dowiedz się więcej</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<!-- S3. NOWA SEKCJA (poza Figmą): wdrożenie z partnerem -->
<section class="partner-benefits partner-paths">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 offset-lg-2" style="text-align:center;">
        <h2 class="kv-h2">Ty wybierasz, kto wdraża Twoją platformę</h2>
        <p class="subtitle kv-lead">WiseB2B dostarcza technologię. Ty decydujesz, czy wdrażasz z&nbsp;naszym partnerem, z&nbsp;pomocą naszego zespołu, czy własnymi siłami. Nie jesteś skazany na jednego dostawcę.</p>
      </div>
    </div>
    <div class="row">
      <div class="col-12">
        <div class="boxes boxes--3col">
          <div class="box lm-observer">
            <div class="box__icon partner-path-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/></svg></div>
            <div class="box__content">
              <h3 class="box__content-header kv-title">Dwie umowy, jasny podział</h3>
              <p class="box__content-description kv-text">Umowę na oprogramowanie podpisujesz z&nbsp;WiseB2B. Umowę na wdrożenie i&nbsp;utrzymanie podpisujesz z&nbsp;partnerem, który odpowiada za Twój projekt. Partner pracuje według metodyki WiseB2B: od nas dostaje scenariusz sprintu analitycznego i&nbsp;sposób wyceny prac. Wolisz jednego wykonawcę? Wybrane projekty prowadzi bezpośrednio zespół WiseB2B ze wsparciem Sente.</p>
            </div>
          </div>
          <div class="box lm-observer">
            <div class="box__icon partner-path-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="4"/><path d="M2 21a7 7 0 0 1 14 0"/><path d="m16 11 2 2 4-4"/></svg></div>
            <div class="box__content">
              <h3 class="box__content-header kv-title">Dobierz partnera do projektu</h3>
              <p class="box__content-description kv-text">Jeśli najtrudniejsza część projektu to warunki handlowe z&nbsp;ERP, magazyn i&nbsp;integracje, porozmawiaj z&nbsp;Sente. Jeśli zależy Ci na ścieżce zakupowej, UX i&nbsp;przejściu z&nbsp;Magento, Shopware czy PrestaShop, porozmawiaj z&nbsp;Satisfly. Na <a href="/zamow-demo/">demo</a> pomożemy Ci ocenić, który partner pasuje do Twojej firmy.</p>
            </div>
          </div>
          <div class="box lm-observer">
            <div class="box__icon partner-path-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m8 7-5 5 5 5M16 7l5 5-5 5"/></svg></div>
            <div class="box__content">
              <h3 class="box__content-header kv-title">Platforma zostaje Twoja</h3>
              <p class="box__content-description kv-text">Z&nbsp;dostępem do kodu źródłowego (w&nbsp;planie Enterprise, w&nbsp;Professional jako opcja) platformę może rozwijać każdy partner albo Twój zespół IT. Rozszerzenia powstają jako wtyczki, więc zmiana wykonawcy nie oznacza zmiany platformy. Opłata za WiseB2B jest stała, bez prowizji od obrotu.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- S4. DLACZEGO WISEB2B -->
<section class="partner-benefits">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 offset-lg-2" style="text-align:center;">
        <h2 class="kv-h2">Dlaczego WiseB2B?</h2>
        <p class="subtitle kv-lead">Dlaczego warto zostać partnerem</p>
      </div>
    </div>
    <div class="row">
      <div class="col-12">
        <div class="boxes boxes--3col">
          <div class="box lm-observer">
            <div class="box__icon partner-benefit-icon">
              <img width="31" height="31" src="/images/np_sale_3972942.png" alt="" />
            </div>
            <div class="box__content">
              <h3 class="box__content-header kv-title">Dawaj więcej wartości swoim klientom</h3>
              <p class="box__content-description kv-text">Oferuj klientom platformę, która realnie zwiększa przychody i&nbsp;usprawnia procesy sprzedażowe w&nbsp;kanale B2B. Klient płaci stały abonament bez prowizji od obrotu, co ułatwia rozmowę o&nbsp;kosztach.</p>
            </div>
          </div>
          <div class="box lm-observer">
            <div class="box__icon partner-benefit-icon">
              <img width="31" height="31" src="/images/np_settings_746615.png" alt="" />
            </div>
            <div class="box__content">
              <h3 class="box__content-header kv-title">Oferuj lepsze rozwiązania</h3>
              <p class="box__content-description kv-text"><a href="/panel-handlowca/">Panel Handlowca</a> i&nbsp;<a href="/agent-ai/">Agent AI</a> to funkcje, które wyróżniają WiseB2B na tle konkurencji i&nbsp;dają Twoim klientom przewagę. Agent Klienta zamienia zamówienie z&nbsp;maila, PDF-a lub Excela w&nbsp;koszyk (Email-2-Cart), a&nbsp;handlowiec pracuje w&nbsp;Panelu Handlowca na tych samych cenach i&nbsp;warunkach co sklep.</p>
            </div>
          </div>
          <div class="box lm-observer">
            <div class="box__icon partner-benefit-icon">
              <img width="31" height="31" src="/images/np_function_1286758_000000-1.png" alt="" />
            </div>
            <div class="box__content">
              <h3 class="box__content-header kv-title">Otwarty kod źródłowy</h3>
              <p class="box__content-description kv-text">Pełna niezależność i&nbsp;swoboda działania. Brak vendor lock-in oznacza, że Ty i&nbsp;Twoi klienci macie pełną kontrolę nad platformą. Rozszerzenia piszesz jako wtyczki, więc aktualizacje platformy ich nie psują.</p>
            </div>
          </div>
          <div class="box lm-observer">
            <div class="box__icon partner-benefit-icon">
              <img width="31" height="31" src="/images/np_ecommerce_4557208_000000-1.png" alt="" />
            </div>
            <div class="box__content">
              <h3 class="box__content-header kv-title">Dostęp do platformy i&nbsp;szkoleń</h3>
              <p class="box__content-description kv-text">Otrzymasz pełny dostęp do platformy WiseB2B, środowiska demonstracyjnego, dokumentacji technicznej i&nbsp;materiałów szkoleniowych.</p>
            </div>
          </div>
          <div class="box lm-observer">
            <div class="box__icon partner-benefit-icon">
              <img width="31" height="31" src="/images/np_suitcase_4525556_000000-1.png" alt="" />
            </div>
            <div class="box__content">
              <h3 class="box__content-header kv-title">Wsparcie zespołu WiseB2B</h3>
              <p class="box__content-description kv-text">Nasz wyspecjalizowany zespół zapewni Ci pomoc techniczną i&nbsp;merytoryczną na każdym etapie wdrożenia klienta, od prezentacji po uruchomienie.</p>
            </div>
          </div>
          <div class="box lm-observer">
            <div class="box__icon partner-benefit-icon">
              <img width="31" height="31" src="/images/np_operation_2998632_000000-1.png" alt="" />
            </div>
            <div class="box__content">
              <h3 class="box__content-header kv-title">Wspólne działania marketingowe</h3>
              <p class="box__content-description kv-text">Promujemy naszych partnerów na stronie, w&nbsp;materiałach marketingowych i&nbsp;podczas wydarzeń branżowych.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- S5. CTA DLA PARTNERÓW -->
<section class="call-expert">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <div class="call-expert__wrapper lm-observer kv-on-dark">
          <h2 class="kv-h2">Chcesz zostać partnerem WiseB2B?</h2>
          <p class="partner-cta__text kv-text">Dołącz do naszej sieci partnerów wdrożeniowych i&nbsp;rozwijaj swój biznes razem z&nbsp;WiseB2B. Wdrażasz eCommerce dla firm handlowych lub produkcyjnych? Napisz, jakie projekty prowadzisz, a&nbsp;opowiemy, jak wygląda współpraca.</p>
          {/* NEED: model współpracy partnerskiej (marża lub prowizja, wymagania, proces wejścia) i osobny formularz dla partnerów */}
          <div class="call-expert__button">
            <a class="wise-button wise-button--wise-harvest" href="mailto:kontakt@wiseb2b.eu">Napisz do nas</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- S6. NEWSLETTER -->
<CtaBlock />
</BaseLayout>
