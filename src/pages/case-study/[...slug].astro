---
export const prerender = true;
import path from 'node:path';
import sharp from 'sharp';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  async function getImageDims(src: string) {
    const filePath = path.join(process.cwd(), 'public', src);
    const { width, height } = await sharp(filePath).metadata();
    return { src, width, height };
  }

  const studies = await getCollection('case-study');
  return Promise.all(studies.map(async (study) => {
    const { clientLogo, mainImage, galleryImages } = study.data;
    const [clientLogoDims, mainImageDims, galleryImageDims] = await Promise.all([
      getImageDims(clientLogo),
      getImageDims(mainImage),
      Promise.all((galleryImages || []).map(getImageDims)),
    ]);
    return {
      params: { slug: study.id },
      props: { study, clientLogoDims, mainImageDims, galleryImageDims },
    };
  }));
}

const { study, clientLogoDims, mainImageDims, galleryImageDims } = Astro.props;
const { title, description, clientLogo, mainImage, galleryImages, info, about, functions, stats, quote, date } = study.data;
---

<BaseLayout
  title={title}
  description={description}
  article={{ headline: title, image: mainImage, datePublished: date, description, authorName: "WiseB2B" }}
  review={quote ? { text: quote.text, author: quote.author, role: quote.role } : undefined}
>

<article class="case-study-page">
  <section class="case-study-hero">
    <div class="container">
      <div class="case-study-hero__inner">
        <span class="page-hero__badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 2h9l5 5v13a2 2 0 01-2 2H6a2 2 0 01-2-2V4a2 2 0 012-2zm8 1.5V8h4.5L14 3.5zM8 13h8v2H8v-2zm0 4h8v2H8v-2zm0-8h4v2H8V9z"/></svg>
          Case study
        </span>
        <div class="case-study-hero__logo">
          <img src={clientLogo} alt={`Logo ${title}`} width={clientLogoDims.width} height={clientLogoDims.height} />
        </div>
        <h1>{title}</h1>
        <p class="case-study-hero__lead">{description}</p>
      </div>
    </div>
  </section>

  <section class="case-study-info">
    <div class="container">
      <div class="case-study-info__grid lm-observer">
        {info.map((item) => (
          <div class="case-study-info__item">
            <p class="case-study-info__label">{item.label}</p>
            <ul>
              {item.items.map((li) => (
                <li>{li}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {stats && stats.length > 0 && (
    <section class="case-study-stats">
      <div class="container">
        <div class="case-study-stats__grid lm-observer">
          {stats.map((stat) => (
            <div class="case-study-stats__item">
              <span class="case-study-stats__value">{stat.value}</span>
              <span class="case-study-stats__label">{stat.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="case-study-images">
    <div class="container">
      <div class="case-study-images__main lm-observer">
        <img src={mainImage} alt={`Zrzut ekranu platformy WiseB2B: ${title}`} width={mainImageDims.width} height={mainImageDims.height} />
      </div>
      {galleryImages && galleryImages.length > 0 && (
        <div class="case-study-images__gallery">
          {galleryImages.map((img, i) => (
            <img
              src={img}
              alt={`Zrzut ekranu ${i + 1}: ${title}`}
              width={galleryImageDims[i].width}
              height={galleryImageDims[i].height}
              loading="lazy"
              class="lm-observer"
            />
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="case-study-about">
    <div class="container">
      <div class="case-study-about__inner lm-observer">
        <h2>{about.heading}</h2>
        <p>{about.text}</p>
      </div>
    </div>
  </section>

  <section class="case-study-functions">
    <div class="container">
      <h2 class="lm-observer">Co uruchomiliśmy</h2>
      <div class="case-study-functions__grid">
        {functions.map((fn) => (
          <div class="case-study-functions__item lm-observer">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="var(--color-success)"/><path d="M8.6 14.8L4.3 10.5 6.6 8.2 8.6 10.5 14.2 5.9 15.8 7.6 8.6 14.8Z" fill="white"/></svg>
            <p class="case-study-functions__name">{fn.name}</p>
            <p class="case-study-functions__desc">{fn.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {quote && (
    <section class="case-study-quote">
      <div class="container">
        <div class="case-study-quote__card lm-observer">
          <img src="/svg/double-quotes-r.svg" alt="" class="case-study-quote__mark case-study-quote__mark--right" width="60" height="60" />
          <blockquote>{quote.text}</blockquote>
          <p class="case-study-quote__author">{quote.author}</p>
          <p class="case-study-quote__role">{quote.role}</p>
          <img src="/svg/double-quotes-l.svg" alt="" class="case-study-quote__mark case-study-quote__mark--left" width="60" height="60" />
        </div>
      </div>
    </section>
  )}
</article>

<section class="hp-final">
  <div class="container">
    <div class="hp-final__card lm-observer">
      <h2>Masz podobną sytuację w swojej firmie?</h2>
      <p>Pokażemy WiseB2B na żywo, na scenariuszach z Twojej firmy. Rozmowa trwa 30 minut.</p>
      <a href="/zamow-demo/" class="btn btn--light">Zamów demo</a>
      <p class="hp-final__contact">Więcej wyników klientów znajdziesz na stronie <a href="/wdrozenia/">Wdrożenia</a>.</p>
    </div>
  </div>
</section>

<CtaBlock />
</BaseLayout>
