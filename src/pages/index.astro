  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof Swiper === 'undefined') return;
      new Swiper('.hp-features__slider', {
        loop: true,
        autoplay: { delay: 6000, disableOnInteraction: false },
        navigation: {
          nextEl: '.hp-features__nav--next',
          prevEl: '.hp-features__nav--prev',
        },
        pagination: {
          el: '.hp-features__pagination',
          clickable: true,
        },
      });
    });
  </script>

  <!-- BLOG -->
