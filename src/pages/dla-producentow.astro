---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { getCollection } from 'astro:content';

// Tekst: .knowledge/teksty/dla-producentow.md (copy deck). Układ: Figma 61:2815.
const allArticles = await getCollection('baza-wiedzy');
const articles = ['e-commerce-w-modelu-b2b', 'korzysci-z-wdrozenia-platformy-b2b', 'jak-wybrac-najlepsza-platforme-b2b', 'dedykowana-czy-gotowa-platforma-b2b-na-co-sie-zdecydowac']
  .map((id) => allArticles.find((a) => a.id === id))
  .filter((a) => a !== undefined);
const icon = (d: string) => `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const I = {
  tag: '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
  cart: '<circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M3 4h2l2.4 11h11.2L21 7H6.2"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  heart: '<path d="M12 21s-8-5.2-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 5.8-8 11-8 11z"/>',
  book: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5"/>',
  wallet: '<rect x="3" y="6" width="18" height="14" rx="2"/><path d="M3 10h18M16 15h2"/>',
  chart: '<path d="M4 20V10M10 20V4M16 20v-7M21 20H3"/>',
  share: '<circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.6-4.4M8.2 13.2l7.6 4.4"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>',
  sliders: '<path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/>',
  coins: '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/>',
  file: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
};

const faq = [
  { q: 'Czym charakteryzuje się platforma B2B dla producentów?', a: 'Cechami wyróżniającymi platformę B2B dla producentów są funkcje zaprojektowane specjalnie z myślą o tej branży. Są to m.in. możliwości konfigurowania wariantów produktowych, składania zamówień na produkcję na zlecenie i monitorowania realizacji kontraktów. Sprzedaż do dealerów, hurtowni i sklepów odbywa się na warunkach z ERP: osobne cenniki i limity dla każdej grupy partnerów, statusy zleceń i terminy realizacji, rozrachunki i dokumenty dostępne dla kontrahenta 24/7.' },
  { q: 'Czy platforma odbierze pracę moim przedstawicielom handlowym?', a: 'Przedstawiciel dalej opiekuje się swoimi dealerami. W Panelu Handlowca widzi ich zamówienia online i offline, przygotowuje oferty na tych samych cenach i warunkach z ERP i dostaje alert, gdy zakupy klienta spadają. Rutynowe zamówienia dealerzy składają sami, więc przedstawiciel ma więcej czasu na większych partnerów i nowych odbiorców.' },
  { q: 'Czy dealer może zamówić w dropshippingu prosto do swojego klienta?', a: 'Tak. Partner podaje adres odbiorcy końcowego i przewoźnika, a platforma nalicza opłatę za obsługę dropshippingu. Stany i ceny klient widzi w każdej lokalizacji: magazynie fabrycznym, centralnym i partnerskim.' },
  { q: 'Ile kosztuje wdrożenie platformy B2B dla producentów?', a: 'Na koszt wdrożenia platformy B2B dla producentów składają się opłaty za prace wdrożeniowe oraz miesięczne koszty abonamentu. Opłata abonamentowa uzależniona jest od wybranego planu: Start od 1 990 zł, Professional od 3 490 zł, Enterprise od 6 990 zł netto miesięcznie, bez opłat od obrotu. Koszt wdrożenia możesz rozłożyć w subskrypcji. Szczegóły na stronie <a href="/plany-wiseb2b/">Plany WiseB2B Cloud</a>.' },
  { q: 'Jak wygląda proces wdrożenia platformy B2B dla producentów?', a: 'Proces wdrożenia platformy B2B dla producentów zaczyna się od sprintu analitycznego (od 1 do 4 tygodni), podczas którego opracowywana jest koncepcja i cel wdrożenia, np. zasady konfiguracji produktów czy limity kontraktowe. Następne kroki to prace deweloperskie, testy oraz etapowa migracja klientów, aż do pełnego uruchomienia. Więcej na stronie <a href="/proces-wdrozenia/">Proces wdrożenia</a>.' },
];
---

<BaseLayout title="Platforma sprzedażowa B2B dla producentów" description="Platforma B2B dla producentów: zlecenia na produkcję online, konfigurator produktów, limity kontraktowe i centrum informacji dla kontrahentów 24/7." faq={faq.map(f => ({ question: f.q, answer: f.a.replace(/<[^>]+>/g, '') }))}>

  <!-- HERO -->
  <section class="text-logos">
    <div class="container">
      <div class="row">
        <div class="col-lg-8 offset-lg-2">
          <div class="text-logos__wrapper">
            <span class="text-logos__badge">
              <span class="text-logos__badge-icon">
                <svg width="14" height="14" viewBox="0 0 26 26" fill="currentColor"><path d="M12.9999 16.75C15.7467 16.75 18.1487 17.9313 19.4553 19.6935L18.0738 20.347C17.0105 19.0868 15.1355 18.25 12.9999 18.25C10.8644 18.25 8.98939 19.0868 7.9261 20.347L6.54517 19.6929C7.85182 17.931 10.2535 16.75 12.9999 16.75ZM12.9999 5.5C15.071 5.5 16.7499 7.17894 16.7499 9.25V11.5C16.7499 13.571 15.071 15.25 12.9999 15.25C10.9289 15.25 9.24993 13.571 9.24993 11.5V9.25C9.24993 7.17894 10.9289 5.5 12.9999 5.5Z"/></svg>
              </span>
              Dla producentów
            </span>
            <h1 class="text-logos__title">Funkcje dedykowane <span>zwiększaniu sprzedaży B2B</span> przez firmy produkcyjne</h1>
            <p class="desc p_regular_1">Wieloletnia współpraca z firmami produkcyjnymi dała nam doskonałe zrozumienie Twoich potrzeb, specyficznych funkcji oraz tego, czego oczekują i potrzebują Twoi klienci.</p>
            <div class="page-hero__actions">
              <a class="wise-button wise-button--wise-harvest" href="/zamow-demo/">Zamów demo</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="numbers-text">
    <div class="container">
      <div class="row">
        <div class="col-lg-10 offset-lg-1">
          <div class="items">

            <div class="item">
              <h2 class="h2_semi">Zwiększ wartość zamówień i odpowiedz na oczekiwania klientów</h2>
              <div class="row">
                <div class="col-md-6"><div class="box">
                  <span class="numbers-text__box-icon" set:html={icon(I.share)} />
                  <h3 class="p_regular_1">Udostępnij klientom platformę, która ułatwi ich pracę</h3>
                  <p class="p_regular_3">Twoi klienci składają zamówienia telefonicznie lub mailowo, co zabiera im wiele czasu i nie jest zbyt wygodnym rozwiązaniem. Decydując się na wdrożenie WiseB2B, udostępniasz im zawsze dostępny, w pełni funkcjonalny i intuicyjny sposób składania zamówień. Dzięki temu zrobią zakupy o najbardziej dogodnej dla siebie porze, zapoznają się ze wszystkimi szczegółami Twojej oferty i uzyskają wgląd w statusy aktualnie realizowanych zleceń. Duże zamówienie wgrają z pliku, a zamówienie przysłane mailem <a href="/agent-ai/">Agent AI</a> zamieni w gotowy koszyk.</p>
                </div></div>
                <div class="col-md-6"><div class="box box--even">
                  <span class="numbers-text__box-icon" set:html={icon(I.info)} />
                  <h3 class="p_regular_1">Precyzyjnie informuj o istotnych szczegółach na temat zamówień</h3>
                  <p class="p_regular_3">Jeśli zajmujesz się produkcją towarów, to moment złożenia zamówienia przez Twojego klienta jest dopiero początkiem Waszych interakcji. Kontrahenci oczekują informacji o statusie zleceń, planowanym terminie dostawy i bieżących rozliczeniach. WiseB2B pełni rolę centrum informacji dla Twoich klientów: przez całą dobę mogą oni zweryfikować wszelkie dane o aktualnie oraz historycznie realizowanych zamówieniach, fakturach, rozrachunkach i dokumentach.</p>
                </div></div>
              </div>
            </div>

            <div class="item">
              <h2 class="h2_semi">Wykorzystaj pełen potencjał swojej oferty</h2>
              <div class="row">
                <div class="col-md-6"><div class="box">
                  <span class="numbers-text__box-icon" set:html={icon(I.gear)} />
                  <h3 class="p_regular_1">Zautomatyzuj przyjmowanie zleceń na produkcję pod zamówienie</h3>
                  <p class="p_regular_3">Realizujesz produkcję na zamówienie i każde zlecenie wymaga wymiany wielu informacji? Ten proces możesz w pełni zautomatyzować dzięki WiseB2B. Platforma dostarczy Twoim klientom wszelkich informacji o możliwych do wyprodukowania towarach oraz szacowanym terminie realizacji. Dzięki temu kontrahenci będą mogli zlecać produkcję na zamówienie w pełni samodzielnie, za pośrednictwem kanału cyfrowego.</p>
                </div></div>
                <div class="col-md-6"><div class="box box--even">
                  <span class="numbers-text__box-icon" set:html={icon(I.sliders)} />
                  <h3 class="p_regular_1">Ułatw zamawianie produktów konfigurowalnych</h3>
                  <p class="p_regular_3">Masz szeroką ofertę, w ramach której możliwe jest indywidualne konfigurowanie produktów. Jednak wybór odpowiednich wariantów na podstawie katalogów czy zestawień w Excelu nie jest zbyt intuicyjny dla Twoich klientów i zwykle wymaga asysty Twoich pracowników. Wykorzystaj WiseB2B do stworzenia dedykowanego konfiguratora produktów dostępnego online i uprość zakupy klientom.</p>
                </div></div>
                <div class="col-md-6"><div class="box">
                  <span class="numbers-text__box-icon" set:html={icon(I.coins)} />
                  <h3 class="p_regular_1">Optymalizuj koszty sprzedaży</h3>
                  <p class="p_regular_3">Przyjmowanie zamówień, odpowiadanie na pytania o terminy produkcji, informowanie o statusach zleceń: wszystkie czynności związane z procesem sprzedaży i obsługi klienta zabierają Twoim pracownikom wiele godzin każdego dnia. A co gdyby mogły one zostać zautomatyzowane, członkowie Twojego zespołu mogliby skupić się na bardziej wymagających zadaniach? To możliwe dzięki wdrożeniu WiseB2B. Dealer zamówi także w dropshippingu prosto do swojego klienta, ze stanami z każdego Twojego magazynu.</p>
                </div></div>
                <div class="col-md-6"><div class="box box--even">
                  <span class="numbers-text__box-icon" set:html={icon(I.file)} />
                  <h3 class="p_regular_1">Zadbaj o rentowność kontraktów</h3>
                  <p class="p_regular_3">Współpracujesz z klientami w ramach długoterminowych kontraktów i dlatego wdrożenie eCommerce B2B wydaje się w przypadku Twojej firmy niemożliwe? Wręcz przeciwnie: możesz udostępnić swoim klientom kontraktowym elektroniczny kanał składania zamówień i jednocześnie wykorzystać go do monitorowania wykorzystania limitów w ramach kontraktów. Wszystko to dzięki odpowiedniej integracji z systemem ERP. Większy partner może zamawiać prosto ze swojego systemu zakupowego przez Client API.</p>
                </div></div>
              </div>
            </div>

            <div class="item">
              <h2 class="h2_semi">Otwórz swój biznes na nowe możliwości</h2>
              <div class="row">
                <div class="col-md-6"><div class="box">
                  <span class="numbers-text__box-icon" set:html={icon(I.wallet)} />
                  <h3 class="p_regular_1">Stwórz strategię transformacji, bazując na ponad 25-letnim doświadczeniu</h3>
                  <p class="p_regular_3">Opracowanie strategii transformacji sprzedaży i tego, w jaki sposób budujesz relację z klientami, to trudny proces. Wyzwaniem jest wykorzystanie najbardziej perspektywicznych tendencji rynkowych i uwzględnienie przy tym specyfiki konkretnego biznesu. Planując wdrażanie zmian z konsultantami WiseB2B, możesz skorzystać z ponad 25-letniego doświadczenia zdobytego w ponad 120 projektach. To unikalna korzyść, która zdecydowanie ułatwi wprowadzanie innowacji w Twojej firmie.</p>
                </div></div>
                <div class="col-md-6"><div class="box box--even">
                  <span class="numbers-text__box-icon" set:html={icon(I.chart)} />
                  <h3 class="p_regular_1">Rozwijaj platformę B2B w sposób, który zwiększy przewagę biznesową Twojej firmy</h3>
                  <p class="p_regular_3">Choć aktualnie wdrożenie platformy B2B to innowacja w Twojej firmie, to na pewno nie będzie to koniec procesu transformacji. Jak Twoi klienci będą korzystać z nowego rozwiązania, które funkcje przypadną im do gustu, a jakich elementów będzie im brakować? Wszystko to da Ci wskazówki i pomysły na rozwój platformy. Wybierając WiseB2B, otrzymujesz elastyczne rozwiązanie z dostępem do kodu źródłowego, które w przyszłości będzie mogło być dostosowane do nowych potrzeb i wyzwań Twojego biznesu, bez żadnych ograniczeń.</p>
                </div></div>
              </div>
            </div>

          </div>

          <div class="numbers-text__button">
            <a class="wise-button wise-button--dark" href="/funkcje/">Wszystkie funkcjonalności</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA: rozmowa z ekspertem -->
  <section class="call-expert">
    <div class="container">
      <div class="row">
        <div class="col-xl-8 offset-xl-2 col-lg-10 offset-lg-1">
          <div class="call-expert__wrapper">
            <h2 class="h2_semi">Potrzebujesz szczegółowych informacji?</h2>
            <p class="dp-call-expert__lead p_regular_1">Porozmawiaj z nami o tym, jak Twoi dealerzy i hurtownie zamawiają dziś i co chcesz przenieść na platformę.</p>
            <p class="name h5_regular">Jakub Czyżkowski</p>
            <p class="job p_regular_2">CEO</p>
            <div class="call-expert__button">
              <a class="wise-button wise-button--wise-harvest" href="/zamow-demo/">Zamów rozmowę z ekspertem</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CASE STUDY -->
  <section class="hp-case hp-case--dark">
    <div class="container">
      <h2 class="hp-section-title lm-observer">Case study</h2>
      <p class="hp-section-subtitle lm-observer">Te same mechanizmy, z których korzysta Twój dealer: zamówienia online na warunkach z ERP. Zobacz, jak przyjęli je klienci Triplex.</p>
      <div class="hp-case__inner lm-observer">
        <div class="hp-case__visual">
          <img src="/case-study/triplex/browser-blender-4-811x608.png" alt="Sklep B2B Triplex na platformie WiseB2B" width="811" height="608" loading="lazy" />
        </div>
        <div class="hp-case__content">
          <div class="hp-case__logo">
            <img loading="lazy" width="68" height="68" src="/images/triplex-p-68x68.png" alt="Triplex" />
          </div>
          <h3>Czołowy dystrybutor pirotechniki postawił na WiseB2B</h3>
          <div class="hp-case__stats">
            <div class="hp-case__stat">
              <span class="hp-case__stat-value">46,36%</span>
              <span class="hp-case__stat-label">zamówień pochodzących z platformy B2B</span>
            </div>
            <div class="hp-case__stat">
              <span class="hp-case__stat-value">49,55%</span>
              <span class="hp-case__stat-label">obrotu wygenerowanego poprzez platformę B2B</span>
            </div>
            <div class="hp-case__stat">
              <span class="hp-case__stat-value">34,43%</span>
              <span class="hp-case__stat-label">klientów korzystających z platformy B2B</span>
            </div>
          </div>
          <a class="wise-button wise-button--white-wise" href="/case-study/triplex/">Zobacz case study</a>
        </div>
      </div>
    </div>
  </section>

  <!-- OPINIA -->
  <section class="hp-testimonials">
    <div class="container">
      <div class="hp-testimonials__card lm-observer">
        <img src="/svg/double-quotes-r.svg" alt="" class="hp-testimonials__quote hp-testimonials__quote--right" width="80" height="80" />
        <blockquote>
          Jesteśmy w branży 30 lat, nasi klienci również &ndash; baliśmy się na początku, że klienci przyzwyczajeni do exceli i telefonu nie będą chcieli składać zamówień przez platformę B2B. Ale reakcje są inne &ndash; klienci są zachwyceni. Takie zmiany też dobrze wpływają na wizerunek branży i przyciągają młode pokolenie. Bardzo pozytywnie oceniam zmiany, jakie wniosła platforma B2B wdrożona przez Sente.
        </blockquote>
        <div class="hp-testimonials__author">
          <p class="hp-testimonials__author-name">Aneta Siwarga</p>
          <p class="hp-testimonials__author-site">Prokurent w Triplex</p>
        </div>
        <img src="/svg/double-quotes-l.svg" alt="" class="hp-testimonials__quote hp-testimonials__quote--left" width="80" height="80" />
      </div>
    </div>
  </section>

  <!-- BAZA WIEDZY -->
  <section class="hp-blog">
    <div class="container">
      <h2 class="hp-section-title lm-observer">Mogą Cię zainteresować</h2>
      <p class="hp-section-subtitle lm-observer">Artykuły dla producentów, którzy planują sprzedaż B2B online</p>
      <div class="hp-blog__grid">
        {articles.map((article) => (
          <a href={`/baza-wiedzy/${article.id}/`} class="hp-blog__card lm-observer">
            <div class="hp-blog__card-img">
              {article.data.image && <img src={article.data.image} alt={article.data.title} width="376" height="250" loading="lazy" />}
              <span class="hp-blog__card-cat">{article.data.category}</span>
            </div>
            <div class="hp-blog__card-body">
              <h3>{article.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
      <div class="hp-blog__more">
        <a href="/baza-wiedzy/" class="btn btn--dark">Sprawdź więcej</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="questions">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="questions__wrapper">
            <h3 class="h3_semi">Najczęściej zadawane pytania</h3>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2">
          <div class="questions__items">
            {faq.map(f => (
              <div class="item">
                <h2 class="h5_semi">{f.q}</h2>
                <p class="p_regular_3" set:html={f.a} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

<CtaBlock />

<script>
document.querySelectorAll('.questions__items .item h2').forEach(h2 => {
  h2.addEventListener('click', () => {
    h2.closest('.item').classList.toggle('show');
  });
});
</script>
</BaseLayout>
