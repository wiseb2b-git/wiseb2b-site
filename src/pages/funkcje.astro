  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 p-xl-0">
        <h2 class="h2_semi functions-cards__heading lm-observer">Handlowcy sprzedają, rutynę przejmuje platforma</h2>
        <div class="functions-cards__grid">
          <div class="functions-cards__item lm-observer">
