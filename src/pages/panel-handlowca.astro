---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';

// Tekst: .knowledge/teksty/panel-handlowca.md (copy deck CEO), układ: Figma 119:1488.
const icon = (d: string, size = 26) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const I = {
  monitor: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  refresh: '<path d="M20 11a8 8 0 0 0-14.3-4.9L4 8M4 4v4h4M4 13a8 8 0 0 0 14.3 4.9L20 16M20 20v-4h-4"/>',
  bookmark: '<path d="M6 3h12v18l-6-4-6 4z"/><path d="m12 7 1.2 2.4 2.6.4-1.9 1.8.5 2.6-2.4-1.3-2.4 1.3.5-2.6-1.9-1.8 2.6-.4z"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M9 15l2 2 4-4"/>',
  file: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h8"/>',
  chart: '<path d="M4 20V4M4 20h16"/><path d="m7 15 4-4 3 3 5-6"/>',
  bag: '<path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2M9 12a3 3 0 0 0 6 0"/>',
  chat: '<rect x="3" y="5" width="18" height="14" rx="4"/><path d="M9 12h.01M15 12h.01"/>',
  shield: '<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><circle cx="12" cy="10" r="2"/><path d="M8.5 16a4 4 0 0 1 7 0"/>',
  grid: '<rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/>',
  archive: '<rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9M10 13h4"/>',
  card: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h4v4H7zM14 9h3M14 13h3M7 16h10"/>',
};
const areas = [
  { i: I.calendar, t: 'Kalendarz i&nbsp;zadania', d: 'Planuj dzień pracy, prowadź notatki ze spotkań, kontroluj terminy. Wszystko w&nbsp;jednym widoku, bez potrzeby zewnętrznego kalendarza.' },
  { i: I.file, t: 'Ofertowanie i&nbsp;negocjacje', d: 'Twórz dedykowane oferty, negocjuj warunki z&nbsp;klientem, śledź statusy ofert. Cały proces ofertowy w&nbsp;ramach platformy.' },
  { i: I.chart, t: 'Sprawy handlowe', d: 'Rodzaje spraw, statusy, lejki sprzedażowe. Prowadź pipeline sprzedaży bez osobnego CRM.' },
  { i: I.bag, t: 'Obsługa zamówień', d: 'Zarządzaj zamówieniami klientów, w&nbsp;tym edycją zamówień już złożonych, zgodnie z&nbsp;zasadami Twojego ERP. Gdy klient dzwoni zamiast zamówić sam, handlowiec loguje się na jego konto i&nbsp;składa zamówienie w&nbsp;sklepie na jego warunkach.' },
  { i: I.chat, t: 'Komunikacja z&nbsp;klientem', d: 'Wiadomości na platformie, maile i&nbsp;inne kanały. Cała historia kontaktu w&nbsp;jednym miejscu.' },
  { i: I.shield, t: 'Opieka nad klientem', d: 'Statystyki zakupowe, aktywność na witrynie, analiza zachowań. Wiesz, czym klient się interesuje i&nbsp;jakich zakupów nie dokonał. Ustawiasz polityki monitoringu, np. spadek zakupów albo brak aktywności, a&nbsp;handlowiec dostaje sygnał, zanim klient odejdzie do konkurencji.' },
];
const benefits = [
  { t: 'Jedno środowisko pracy', d: 'Jedno środowisko pracy dla handlowca i&nbsp;klienta: spójne dane, spójne doświadczenia, spójne mechanizmy handlowe.' },
  { t: 'Bez osobnego CRM', d: 'Bez osobnego CRM firma ma jeden system mniej do integrowania. Mniej licencji, mniej szkoleń, mniej problemów z&nbsp;synchronizacją danych.' },
  { t: 'Automatyzacje', d: 'Automatyzacja rutynowych działań i&nbsp;ergonomia codziennego użycia uwolnią 20&ndash;30% czasu handlowca na budowanie relacji. U&nbsp;dystrybutora części do maszyn rolniczych 42% zamówień przechodzi bez weryfikacji handlowca. Handlowcy sprzedają, zamiast przepisywać maile.' },
  { t: 'Profil klienta', d: 'Profil klienta z&nbsp;kontekstem eCommerce pokazuje aktywności na witrynie, czym klient jest zainteresowany i&nbsp;jakich zakupów nie dokonał.' },
];
---

<BaseLayout title="Panel Handlowca: Sales CRM wbudowany w eCommerce B2B" description="Panel Handlowca WiseB2B to 8 obszarów pracy handlowca w platformie eCommerce B2B: oferty, sprawy, zamówienia i karta klienta 360°, bez osobnego CRM.">

<!-- S1: Hero -->
<div class="ph-hero kv-on-dark">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1 p-xl-0">
        <div class="ph-hero__content lm-observer">
          <span class="page-hero__badge">
            <svg width="16" height="16" viewBox="0 0 26 26" fill="currentColor"><path d="M12.9999 16.75C15.7467 16.75 18.1487 17.9313 19.4553 19.6935L18.0738 20.347C17.0105 19.0868 15.1355 18.25 12.9999 18.25C10.8644 18.25 8.98939 19.0868 7.9261 20.347L6.54517 19.6929C7.85182 17.931 10.2535 16.75 12.9999 16.75ZM12.9999 5.5C15.071 5.5 16.7499 7.17894 16.7499 9.25V11.5C16.7499 13.571 15.071 15.25 12.9999 15.25C10.9289 15.25 9.24993 13.571 9.24993 11.5V9.25C9.24993 7.17894 10.9289 5.5 12.9999 5.5Z"/></svg>
            Panel Handlowca
          </span>
          <h1 class="kv-h1">Twój zespół sprzedaży zasługuje na <span>lepsze narzędzie</span></h1>
          <p class="kv-lead">Panel Handlowca WiseB2B to jedno środowisko pracy dla handlowca z&nbsp;klientem. Jedna platforma to spójne dane, spójne doświadczenia, spójne mechanizmy handlowe. Koniec z&nbsp;przełączaniem się handlowca między CRM, mailem i&nbsp;ERP-em.</p>
          <a class="wise-button wise-button--wise-harvest" href="/zamow-demo/">Umów prezentację Panelu Handlowca</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- S2: Czym jest Panel Handlowca? -->
<div class="ph-intro">
  <div class="container">
    <div class="row">
      <div class="col-xl-10 offset-xl-1">
        <div class="ph-intro__content lm-observer">
          <h2 class="kv-h2">Czym jest Panel Handlowca?</h2>
          <p class="kv-text">Skuteczna sprzedaż B2B wymaga odpowiedniego połączenia pracy handlowców z&nbsp;cyfrową obsługą klienta. Panel Handlowca to moduł WiseB2B, który daje handlowcom pełne narzędzie do zarządzania relacjami, ofertami i&nbsp;zamówieniami, wbudowane bezpośrednio w&nbsp;platformę eCommerce.</p>
        </div>
        <div class="ph-goals lm-observer">
          <div class="ph-goal">
            <div class="ph-goal__icon" set:html={icon(I.monitor)} />
            <h3 class="kv-title">Jedno środowisko</h3>
            <p class="kv-text">Wspólna komunikacja, budowanie dedykowanych ofert i&nbsp;uzgadnianie warunków współpracy w&nbsp;jednym miejscu.</p>
          </div>
          <div class="ph-goal">
            <div class="ph-goal__icon" set:html={icon(I.refresh)} />
            <h3 class="kv-title">Pewność spójności</h3>
            <p class="kv-text">Jedne zasady ofertowania, wyceny i&nbsp;dostępności. Handlowiec widzi te same ceny, warunki i&nbsp;stany z&nbsp;ERP co klient w&nbsp;sklepie. Pełna współpraca handlowca i&nbsp;klienta w&nbsp;jednym procesie zakupowym.</p>
          </div>
          <div class="ph-goal">
            <div class="ph-goal__icon" set:html={icon(I.bookmark)} />
            <h3 class="kv-title">Użyteczna wiedza</h3>
            <p class="kv-text">Widok 360° to lepsza wiedza o&nbsp;potrzebach klienta i&nbsp;jego aktywności oraz okazja do nowej sprzedaży.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- S3: Obszary funkcjonalne -->
<div class="ph-areas ph-areas--kv kv-on-dark">
  <div class="container">
    <h2 class="ph-areas__heading lm-observer kv-h2">Obszary funkcjonalne</h2>
    <p class="ph-areas__eyebrow lm-observer kv-eyebrow">Funkcjonalności WiseB2B</p>
    <p class="ph-areas__lead lm-observer kv-text">Panel Handlowca ma osiem obszarów pracy. Dashboard, ofertowanie z&nbsp;kontekstem klienta i&nbsp;profil klienta 360° pokazujemy szerzej w&nbsp;następnej sekcji.</p>
    <div class="ph-areas__grid">
      {areas.map(a => (
        <div class="ph-area-card lm-observer">
          <div class="ph-area-card__icon" set:html={icon(a.i)} />
          <h3 class="kv-title" set:html={a.t} />
          <p class="kv-text" set:html={a.d} />
        </div>
      ))}
    </div>
  </div>
</div>

<!-- S4: Panel Handlowca w praktyce -->
<div class="ph-usecases">
  <div class="container">
    <div class="row">
      <div class="col-xl-10 offset-xl-1">
        <h2 class="ph-usecases__heading lm-observer kv-h2">Panel Handlowca w&nbsp;praktyce</h2>
        <div class="ph-usecase ph-usecase--reverse lm-observer">
          <div class="ph-usecase__text">
            <div class="ph-goal__icon" set:html={icon(I.grid)} />
            <h3 class="kv-h3">Dashboard handlowca</h3>
            <p class="kv-text">Centralny punkt pracy handlowca. Lista zadań na dziś, ostatnie zamówienia, wykres realizacji celu sprzedażowego. Handlowiec loguje się rano i&nbsp;od razu widzi, czym się zająć. Bez szukania informacji w&nbsp;trzech systemach. Na dashboardzie ma też terminarz, pocztę e-mail z&nbsp;historią korespondencji i&nbsp;AI Insights, czyli podpowiedzi oparte na danych klienta.</p>
          </div>
          <div class="ph-usecase__visual">
            <img class="ph-mockup-img" src="/images/panel-handlowca-dashboard.png" alt="Panel Handlowca: dashboard z listą zadań i wykresem realizacji celu" loading="lazy" />
          </div>
        </div>
        <div class="ph-usecase lm-observer">
          <div class="ph-usecase__text">
            <div class="ph-goal__icon" set:html={icon(I.archive)} />
            <h3 class="kv-h3">Ofertowanie z&nbsp;kontekstem klienta</h3>
            <p class="kv-text">Tworzenie oferty z&nbsp;poziomu karty klienta, z&nbsp;pełnym kontekstem: dane kontaktowe, warunki handlowe, historia zakupów, lista produktów. Handlowiec tworzy ofertę w&nbsp;kilka minut, a&nbsp;klient widzi ją w&nbsp;swoim panelu i&nbsp;może od razu zaakceptować.</p>
          </div>
          <div class="ph-usecase__visual">
            <img class="ph-mockup-img" src="/images/panel-handlowca-oferta.png" alt="Panel Handlowca: oferta z danymi klienta i listą produktów" loading="lazy" />
          </div>
        </div>
        <div class="ph-usecase ph-usecase--reverse lm-observer">
          <div class="ph-usecase__text">
            <div class="ph-goal__icon" set:html={icon(I.card)} />
            <h3 class="kv-h3">Profil klienta 360°</h3>
            <p class="kv-text">Karta klienta prezentuje nie tylko standardowe dane CRM, ale też aktywność na witrynie, historię zakupów online i&nbsp;offline, częstotliwość zamówień i&nbsp;trendy sprzedażowe. Handlowiec widzi pełny obraz klienta i&nbsp;wie, czym klient jest zainteresowany i&nbsp;jakich zakupów nie dokonał.</p>
          </div>
          <div class="ph-usecase__visual">
            <img class="ph-mockup-img" src="/images/panel-handlowca-karta-klienta.png" alt="Panel Handlowca: karta klienta ze statystykami sprzedaży" loading="lazy" />
          </div>
        </div>
        <div class="ph-usecases__more lm-observer">
          <a class="hp-why__link" href="/agent-ai/">Zobacz, jak pomaga Agent Handlowca</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- S5: Korzyści dla firmy -->
<div class="ph-benefits ph-benefits--kv">
  <div class="container">
    <div class="ph-benefits__layout">
      <div class="ph-benefits__image lm-observer">
        <img src="/images/mockup-of-a-man-using-a-macbook-on-a-wooden-desk.png" alt="Handlowiec pracuje w platformie WiseB2B na laptopie" loading="lazy" />
      </div>
      <div class="ph-benefits__card lm-observer">
        <h2 class="ph-benefits__heading kv-h2">Korzyści dla firmy</h2>
        <ol class="ph-benefits__list">
          {benefits.map((b, n) => (
            <li class="ph-benefit">
              <h3 class="kv-title"><span class="ph-benefit__number">{String(n + 1).padStart(2, '0')}</span><span set:html={b.t} /></h3>
              <p class="kv-text" set:html={b.d} />
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- S6: Ekspert -->
<section class="call-expert">
  <div class="container">
    <div class="row">
      <div class="col-xl-8 offset-xl-2 col-lg-10 offset-lg-1">
        <div class="call-expert__wrapper kv-on-dark">
          <h2 class="kv-h2">Porozmawiajmy o&nbsp;Panelu Handlowca</h2>
          <p class="job kv-text">Porozmawiaj z&nbsp;nami</p>
          <p class="name kv-title">Jakub Czyżkowski</p>
          <p class="job kv-text">CEO</p>
          <div class="call-expert__button">
            <a class="wise-button wise-button--wise-harvest" href="/zamow-demo/">Umów prezentację</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Lightbox -->
<div class="ph-lightbox" id="ph-lightbox">
  <img class="ph-lightbox__img" id="ph-lightbox-img" src="" alt="" />
</div>
<script is:inline>
// Lightbox for mockup images
(function() {
  var lightbox = document.getElementById('ph-lightbox');
  var lightboxImg = document.getElementById('ph-lightbox-img');
  document.querySelectorAll('.ph-mockup-img').forEach(function(img) {
    img.addEventListener('click', function() {
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightbox.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    });
  });
  lightbox.addEventListener('click', function() {
    lightbox.classList.remove('is-active');
    document.body.style.overflow = '';
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && lightbox.classList.contains('is-active')) {
      lightbox.classList.remove('is-active');
      document.body.style.overflow = '';
    }
  });
})();
</script>
<CtaBlock />
</BaseLayout>
