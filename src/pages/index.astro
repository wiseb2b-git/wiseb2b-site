  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const marquee = document.querySelector('.logos-marquee');
      const track = document.querySelector('.logos-marquee-track');
      if (!marquee || !track) return;

      let isDragging = false;
      let startX = 0;
      let frozenX = 0;

      function getTranslateX() {
        const matrix = new DOMMatrix(getComputedStyle(track).transform);
        return matrix.m41;
      }

      function freezeTrack() {
        frozenX = getTranslateX();
        track.classList.add('dragging');
        track.style.transform = `translateX(${frozenX}px)`;
      }

      function syncAndResume() {
        const halfWidth = track.scrollWidth / 2;
        let normalized = frozenX % halfWidth;
        if (normalized > 0) normalized -= halfWidth;
        const progress = Math.abs(normalized) / halfWidth;
        track.style.transform = '';
        track.style.animation = 'none';
        void track.offsetWidth;
        track.style.animation = '';
        track.style.animationDelay = `${-progress * 30}s`;
        track.classList.remove('dragging');
      }

      marquee.addEventListener('mousedown', (e) => {
        isDragging = true;
        startX = e.clientX;
        freezeTrack();
        marquee.classList.add('is-dragging');
        e.preventDefault();
      });
      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const dx = e.clientX - startX;
        startX = e.clientX;
        frozenX += dx;
        track.style.transform = `translateX(${frozenX}px)`;
      });
      window.addEventListener('mouseup', () => {
        if (!isDragging) return;
        isDragging = false;
        marquee.classList.remove('is-dragging');
        syncAndResume();
      });
      marquee.addEventListener('touchstart', (e) => {
        isDragging = true;
        startX = e.touches[0].clientX;
        freezeTrack();
        marquee.classList.add('is-dragging');
      }, { passive: true });
      marquee.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        const dx = e.touches[0].clientX - startX;
        startX = e.touches[0].clientX;
        frozenX += dx;
        track.style.transform = `translateX(${frozenX}px)`;
      }, { passive: true });
      marquee.addEventListener('touchend', () => {
        if (!isDragging) return;
        isDragging = false;
        marquee.classList.remove('is-dragging');
        syncAndResume();
      });
    });
  </script>

  <!-- STAWKA -->
